/*****************************
项目名称：山东亿辰
功能描叙：
创 建 人：xi.zhu
创建时间：2024-09-22
更新信息: 
测试调试：

*/
CREATE PROC [dbo].[uspInjectionUnloadMaterial]
@MaterialBucketCode VARCHAR(100),
@UserId INT 
AS 
BEGIN 
BEGIN TRAN

		DECLARE @ResTabel TABLE(Id INT,ResName NVARCHAR(50) )
		INSERT @ResTabel
		(
		    Id,
			ResName
		)
		SELECT  b.ResourceId,B.ResName FROM  Prod_InjectionLoadingMaterialRelationRes a INNER JOIN dbo.Basal_Resource B WITH(NOLOCK) ON a.ResId=b.ResourceId
		WHERE a.MaterialBucketCode=@MaterialBucketCode
		

		-- 使用 STRING_AGG 将 Id 拼接成 | 分隔的字符串
		DECLARE @IdString NVARCHAR(MAX);
		DECLARE @NameString NVARCHAR(MAX);
		SELECT @IdString = STRING_AGG(CAST(Id AS NVARCHAR(10)), '|') ,@NameString=STRING_AGG(CAST(ResName AS NVARCHAR(50)), '|')
		FROM @ResTabel;

	--记录操作日志
	INSERT INTO dbo.Prod_InjectionLoadingMaterialHistory
	(
	    MaterialBucketCode,
	    GRN,
	    OperateType,
	    CreateDateTime,
	    UserId,
	    Remark,
		Qty,
		ResIds,
		ResNames
	)
	SELECT   @MaterialBucketCode,        -- MaterialBucketCode - varchar(100)
	    GRN,        -- GRN - varchar(100)
	    N'注塑卸料',       -- OperateType - nvarchar(30)
	    GETDATE(), -- CreateDateTime - datetime
	    @UserId,         -- UserId - int
	    '',       -- Remark - nvarchar(1000)
		b.BalanceQty,  --剩余数量
		@IdString,
		@NameString
	     FROM  Prod_InjectionLoadingMaterial a WITH(NOLOCK)
		 INNER JOIN Prod_MaterialUnit b WITH(NOLOCK) ON a.GRN=b.SerialNumber
		 WHERE MaterialBucketCode=@MaterialBucketCode
	IF @@ERROR<>0
	BEGIN
	    RAISERROR('新增上料操作记录失败！',12,1);
		ROLLBACK TRAN;
		RETURN;
	END

	 DELETE Prod_InjectionLoadingMaterialRelationRes WHERE MaterialBucketCode=@MaterialBucketCode

	 DELETE dbo.Prod_InjectionLoadingMaterial
	 WHERE MaterialBucketCode= @MaterialBucketCode        -- MaterialBucketCode - varchar(100)
	  
	IF @@ERROR <>0
		BEGIN
			RAISERROR('插入GRN信息失败！',12,1);
			ROLLBACK TRAN;
			RETURN;
		END

	COMMIT TRAN;
END 

