@{
    ViewBag.Title = "同步列表";
}

<style>
    #erp-sync td { word-break: break-all; }
</style>
<table class="table table-striped table-responsive" id="erp-sync" style="table-layout:fixed;">
    <thead>
        <tr>
            <th style="width:5%;">序号</th>
            <th style="width:7%;">接口编码</th>
            <th style="width:10%;">接口名称</th>
            <th style="width:7%;">全表同步</th>
            @*<th style="width:10%;" title="同步递增量，单位：天，（比如：同步工单BOM等大表时，数据量很大，需要按时间递增同步，当InitCompleteFlag字段值为1时，就不需要再按时间递增取数据了）">增量同步频率(天)</th>*@
            <th style="width:10%;">上次同步结果</th>
            <th style="width:10%;">上次同步时间</th>
            <th style="width:20%;">上次同步消息</th>
            <th style="width:10%;">接口地址</th>
            <th style="width:10%;">ERP中间表</th>
        </tr>
    </thead>
    <tbody>
        <tr v-for="(item,idx) in syncList" :class="{danger:item.LastSyncResult==0}">
            <td align="center">{{idx+1}}</td>
            <td>{{item.SyncCode}}</td>
            <td>{{item.SyncName}}</td>
            <td>{{item.IsFullSync == 1 ? "是":"否"}}</td>
            @*<td>{{item.IncrementalValue}}</td>*@
            @*<td>{{item.LastSyncResult == 1 ? "成功" : "失败") }}</td>*@
            <td>{{item.LastSyncResultName}}</td>
            <td>{{ item.LastSyncTime}}</td>
            <td>{{item.LastSyncMsg}}</td>
            <td>{{item.Api}}</td>
            <td>{{item.MiddleTableName}}</td>
        </tr>
    </tbody>
</table>

<script type="text/javascript">

    var vm = new Vue({
        el: "#erp-sync",
        data: {
            syncList: [],
        },
        mounted() {
            this.GetList();
        },
        methods:
        {
            GetList: function () {
                axios.get('@HttpContext.Current.Request.ApplicationPath.TrimEnd('/')/ERP/GetList').then(
                    function (response) {
                        vm.syncList = [];
                        for (var i = 0; i < response.data.length; i++) {
                            var entity = response.data[i];
                            entity.LastSyncResultName = entity.LastSyncResult == 1 ? "成功" : (entity.LastSyncResult == 0 ? "失败" : "");
                            if (entity.LastSyncTime) {
                                entity.LastSyncTime = moment(entity.LastSyncTime).format('YYYY-MM-DD HH:mm:ss');
                            }
                            vm.syncList.push(entity);
                        }
                    },
                    function (response) {
                        alert(response.status);
                    }
                ).catch(
                    function (error) {
                        alert(error);
                    }
                )
            },
        },

    });
    
</script>
