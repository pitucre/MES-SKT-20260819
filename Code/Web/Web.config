<?xml version="1.0"?>
<configuration>
	<!--
    *************************************************郑重声明*********************************************************

                        该web.config文件中的参数非技术人员请不要随意修改。
                        如果需要修改请求助相关技术人员协助，对此文件内容的修改会影响系统运行，请慎重！！
                    
    ******************************************************************************************************************
    
    1、LeanMES 8.5可以实现多数据库操作与管理，通过配置不同的数据库链接可实现生产数据库和报表数据库分离(配合数据库后台配置可实现读写分离)；
    数据库连接字符加密说明：数据库连接字符可在页面上进行配置，如无特殊情况不要手动修改web.config中的数据库连接字符；
    
    2、LeanMES 系统级数据库链接，此连接非常重要，初始化时可以在web.config中配置，在页面上已禁用此链接的配置，否则可能会无法登录系统
        如果ConnStringEncrypt参数为true，则系统链接需要手动加密(加密工具位置：系统根目录\DBTools\Lean MES 数据库链接加密工具.exe)
        数据库链接字符格式："server=数据库服务器名;uid=数据库用户名;pwd=数据库用户密码;database=数据库名";
    3、"ExcelConnString"为Excel链接字符，系统中的数据导入导出需要使用此链接，此链接不需要作任何修改;
    d9FyAnUyNtX+z/OLf9s62a1SqrpyWEp0FRxFXoMytftu5v2Mv60oQQ4a7jrFkmF9tIe1zyzk9KKjdNAlTJddlwjyhB5AYBZZGWoZ+cYMCUlxrdXGBJpbiQ==
    SKTMES003\MSSQLSERVER12,51565;uid=SKTDEVTEST;pwd=123456;database=SKTMES_8_5;
    <add key="SYSConnString" value="server=SKTMES003\MSSQLSERVER12,51565;uid=SKTDEVTEST;pwd=123456;database=LeanMES_8_5_0;" />
    <add key="MESConnString" value="server=SKTMES003\MSSQLSERVER12,51565;uid=SKTDEVTEST;pwd=123456;database=LeanMES_8_5_0;" />
    <add key="ReportConnString" value="server=SKTMES003\MSSQLSERVER12,51565;uid=SKTDEVTEST;pwd=123456;database=SKTMES_8_5;" />
    <add key="ReportConnStringNew" value="server=SKTMES003\MSSQLSERVER12,51565;uid=SKTDEVTEST;pwd=123456;database=LeanMES_8_5_0;" />
    -->
	<appSettings>
		<add key="AllowRequestURL" value="http://localhost:23884,http://www.cloudmes.com"/>
		<add key="SQLErrorTipFlag" value="1"/>
		<add key="ConnStringEncrypt" value="false"/>
		<add key="SYSConnString" value="server=172.16.5.179;uid=sa;pwd=SAsa123;database=LeanMes_Test;Pooling=True;max pool size=500;Connect Timeout=600" />
		<add key="MESConnString" value="server=172.16.5.179;uid=sa;pwd=SAsa123;database=LeanMes_Test;Pooling=True;max pool size=500;Connect Timeout=600" />
		<add key="ReportConnString" value="server=172.16.5.179;uid=sa;pwd=SAsa123;database=LeanMes_Test;Pooling=True;max pool size=500;Connect Timeout=600" />
		<add key="ReportConnStringNew" value="server=172.16.5.179;uid=sa;pwd=SAsa123;database=LeanMes_Test;Pooling=True;max pool size=500;Connect Timeout=600" />
