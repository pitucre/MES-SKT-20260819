<?xml version="1.0" encoding="utf-8" ?>
<file>
	<page size="A4"></page>
	<margin top="1" bottom="1"></margin>
	<report source="dtApplyForm" >
		<table spacing-before="0" border-width="0" font-size="9">
			<row>
				<column width="30%" align="left" font-style="bold"></column>
				<column width="50%" align="center" font-size="18" font-style="bold">
					#[Company]#
					出货单
				</column>
				<column width="30%" align="right" barcode-type="barcode128" barcode-width="130" barcode-height="40"  barcode-content="#[DNCode]#" ></column>
			</row>

		</table>


		<table spacing-before="5" border-width="0" font-size="9">
			<row >
				<column width="50%" height="10" align="left">客户名称：#[CusName]#</column>
				<column width="50%" height="10" align="right">NO：#[DNCode]#</column>
			</row>
			
			<row>
				<column width="50%" height="10" align="left">日期：#[CreateDateTime]#</column>
				<column width="50%" height="10" align="right" ></column>
			</row>
		</table>
		<data source="dtApplyForm1" spacing-before="5" spacing-after="0" font-size="9">
			<column header="序号" width="5%" align="center" rownum="1" ></column>
			<column header="物料编码" width="13%" align="center" atuo_rowspan="1" >#[ItemCode]#</column>
			<column header="客户料号" width="13%" align="center" >#[CPN]#</column>
			<column header="库位" width="18%" align="center">#[CbarCode]#</column>
			<column header="库存数量" width="8%" align="center">#[CbarCodeQty]#</column>
			
			<column header="单位" width="5%" align="center">#[Units]#</column>

			<column header="存储地点" width="11%" align="center" >#[CWhName]#</column>
			<column header="计划数量" width="8%" align="center" >#[CurrentQty]#</column>
			
		</data>
		

		<table spacing-before="0"  font-size="9">
			<row>
				<column width="6.4%" align="center" >备注</column>
				<column width="96%" align="left" >
					1:本单经收货单位盖章或签收后(含提货人)当即生效；
					2:客户若对产品所列货品数量、品质有异议 需在收货之日起三天内向本公司发出书面通知
					逾期我司将视客户收要作实。
				</column>

			</row>

		</table>
		<table spacing-before="10"  font-size="9" border-width="0">
			<row >
				<column width="30%" align="left" font-size="10">制单人：</column>
				<column width="30%" align="left" font-size="10">发料人：</column>
				<column width="30%" align="left" font-size="10">审核人：</column>
				<column width="30%" align="left" font-size="10">签收人：</column>
			</row>

		</table>

	</report>

</file>
