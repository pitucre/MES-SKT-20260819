<?xml version="1.0" encoding="utf-8" ?>
<file>
  <!--<page size="A4" orientation="Landscape"></page>-->
  <page size="A4"></page>
  <margin all="1" ></margin>
  <report source="dtIQCReport">
 
    <table spacing-before="0" font-size="9">
      <row >

        <column  border-width="0" colspan="6" align="center"  font-size="22"   font-style="bold">来料检验报告</column>

      </row>
      <row>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
      </row>
      <row>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
      </row>
      <row>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
      </row>
      <row>
        <column width="10%" align="center" font-style="bold">物料名称</column>
        <column width="20%" align="left" >#[ItemName]#</column>
        <column width="10%" align="center"  font-style="bold">物料编码</column>
        <column width="20%" align="center" >#[ItemCode]#</column>
        <column width="10%" align="center" font-style="bold">送检单号</column>
        <column width="20%" align="center" >#[InspectionNo]#</column>
      </row>
      <row>
        <column width="10%" align="center" font-style="bold">物料规格</column>
        <column width="20%" align="left" >#[ItemSpec]#</column>
        <column width="10%" align="center"  font-style="bold">来料数量</column>
        <column width="20%" align="center" >#[InspectionQty]#</column>
        <column width="10%" align="center" font-style="bold">检验日期</column>
        <column width="20%" align="center" >#[CheckDate]#</column>
      </row>
      <row>
        <column width="10%" align="center" font-style="bold">采购单号</column>
        <column width="20%" align="left" >#[POCode]#</column>
        <column width="10%" align="center"  font-style="bold">订单号</column>
        <column width="20%" align="center" >#[SOCode]#</column>
        <column width="10%" align="center" font-style="bold">供应商</column>
        <column width="20%" align="center" >#[VendorName]#</column>
      </row>
    </table>
    <repeat source="dtIQCReport1" RepeatId="InspectionTemplateId">
      <table spacing-before="5" font-size="9" source="dtItem">
        <row>
          <column border-width="0" height="0" width="10%"></column>
          <column border-width="0" height="0" width="20%"></column>
          <column border-width="0" height="0" width="10%"></column>
          <column border-width="0" height="0" width="20%"></column>
          <column border-width="0" height="0" width="10%"></column>
          <column border-width="0" height="0" width="20%"></column>
        </row>
        <row>
          <column colspan="6" align="center" font-size="10" font-style="bold">#[InspectionTemplateName]#</column>
        </row>
        <row>
          <column align="center" font-style="bold">抽样水平</column>
          <column align="center">#[LotNameText]#</column>
          <column align="center" font-style="bold">抽样数量</column>
          <column align="center">#[SamplingValue]#</column>
          <column align="center" font-style="bold">Ac/Re</column>
          <column align="center" >#[ACREvalue]#</column>
        </row>
      </table>
      <data source="dtItem1" spacing-before="0" font-size="9">
        <header-style></header-style>
        <column header="序号" width="6%" align="center" rownum="1"></column>
        <column header="检验项目" width="32.5%" >#[InspectionItemName]#</column>
        <column header="判定标准" width="12%">#[InspectionMethodValue]#</column>
        <column header="单位" width="10%">#[UnitName]#</column>
        <column header="检验方法" align="center" width="20%">#[CheckFashion]#</column>       
        <column header="检验结果" align="center" width="15%">#[CheckResultText]#</column>
        <column header="备注" align="center" width="20%">#[Remark]#</column>
      </data>
    </repeat>
    <table spacing-before="5" font-size="9" source="dtLrc">
      <row>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="20%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="10%"></column>
        <column border-width="0" height="0" width="10%"></column>
      </row>
      <row>
        <column colspan="10" border-width="0" height="0" width="100%"></column>
      </row>
      <row>
        <column  width="14%" font-size="7" align="center" font-style="bold">检验模板</column>
        <column  width="14%" font-size="7" align="center" font-style="bold">检验项</column>
        <column  width="14%" font-size="7" align="center" font-style="bold">判定标准</column>
        <column  width="26%" font-size="7" align="center" font-style="bold">物料条码</column>
        <column  width="26%" font-size="7" align="center" font-style="bold">物料批次</column>
        <column  width="5%" font-size="7" align="center" font-style="bold">检验值</column>
        <column  width="14%" font-size="7" align="center" font-style="bold">备注</column>
        <column  width="5%" font-size="7" align="center" font-style="bold">检验结果</column>
        <column  width="8%" font-size="7" align="center" font-style="bold">检验人</column>
        <column  width="20%" font-size="7" align="center" font-style="bold">检验时间</column>
      </row>
      <!--<row>
			<column align="center" font-style="bold">抽样水平</column>
			<column align="center">#[LotNameText]#</column>
			<column align="center" font-style="bold">抽样数量</column>
			<column align="center" >#[SamplingValue]#</column>
			<column align="center" font-style="bold">Ac/Re</column>
			<column align="center" >#[ACREvalue]#</column>
		</row>-->
    </table>
    <data source="dtLrc1" spacing-before="0">
      <column  width="14%" font-size="7" align="center">#[InspectionTemplateName]#</column>
      <column  width="14%" font-size="7" align="center">#[InspectionItemName]#</column>
      <column  width="14%" font-size="7" align="center">#[InspectionMethodValue]#</column>
      <column  width="26%" font-size="7" align="center">#[GRN]#</column>
      <column  width="26%" font-size="7" align="center">#[LotCode]#</column>
      <column  width="5%"  font-size="7" align="center">#[Value]#</column>
      <column  width="14%" font-size="7" align="center">#[Remark]#</column>
      <column  width="5%"  font-size="7" align="center">#[Result]#</column>
      <column  width="8%"  font-size="7" align="center">#[CreateBy]#</column>
      <column  width="20%" font-size="7" align="center">#[InspectionTime]#</column>
      <!--<column  width="9%" font-size="7" align="center">#[Value7]#</column>
		<column  width="9%" font-size="7" align="center">#[Value8]#</column>
		<column  width="9%" font-size="7" align="center">#[Value9]#</column>
		<column  width="9%" font-size="7" align="center">#[Value10]#</column>-->
    </data>

    <table spacing-before="5" font-size="9">
      <row>
        <column width="14%" align="center" font-style="bold">最终检验结果</column>
        <column width="16%" align="center">#[InspectionResultText]#</column>
        <column width="14%" align="center" font-style="bold">检验员</column>
        <column width="16%" align="center" >#[InspectionUser]#</column>
        <column width="14%" align="center" font-style="bold">审核人</column>
        <column width="16%" align="center" >#[VerifyName]#</column>
      </row>
      <row>
        <column width="18%"  font-style="bold"  align="center">审核备注</column>
        <column width="82%" align="left" colspan="5" >#[Auditing]#</column>
      </row>
      <row>
        <column width="18%"  font-style="bold"  align="center">备注</column>
        <column width="82%" align="left" colspan="5" >#[Remark]#</column>
      </row>
      <row>
        <column width="18%" font-style="bold"  align="center">仪器编号</column>
        <column width="82%" align="left" colspan="5" >A卡尺，B卷尺，C钢尺，D膜厚仪，E投影仪，F通止规，G环规，H针规，I塞尺，J网络分析仪，K互调仪，L色差仪，M大理石平台，N其他。</column>
      </row>
    </table>
  </report>
</file>
