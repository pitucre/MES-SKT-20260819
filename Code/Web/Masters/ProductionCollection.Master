<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="ProductionCollection.master.cs"
    Inherits="SKT.LeanMES.Web.Masters.ProductionCollection" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link rel="shortcut icon" href="../favicon.ico" type="image/x-icon" />
    <link href="../Content/productioncollection.css?v=20210728" rel="Stylesheet" type="text/css" />
    <link href="../Content/plugin/treeview/jquery.tree.css" rel="Stylesheet" type="text/css" />
    <link href="../Content/plugin/dialog/skin/default/dialog-1.0.3.css" rel="stylesheet"
        type="text/css" />
    <link href="../Content/jquery-ui.min.css" rel="stylesheet" type="text/css" />
    <link href="../Content/plugin/calendar/skin/datepicker.css" rel="stylesheet" type="text/css" />
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/jquery.min.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/jquery-ui.min.js"
        type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.utility.validation.js"
        type="text/javascript"></script>


    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/crypto-js.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.aes.js" type="text/javascript"></script>

    <title>
        <%= Resources.Common.AppName%></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <script language="javascript" type="text/javascript">

        /*dialog info*/
        var _close = "<%=Resources.Common.Close %>";
        var _resizewin = "<%=Resources.lang.ResizeWin %>";
        var _dialogwin = "<%=Resources.lang.PopWin %>";
        var _help = "<%=Resources.Common.Help %>";
        var _enlarged = "<%=Resources.Common.Enlarged %>";
        var _dataLoading = "<%=Resources.Messages.DataLoading %>";

        /*base info*/
        var webroot = "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>";
        var _webRoot = "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>";
        var _root = webroot;
        var _port = "<%=System.Configuration.ConfigurationManager.AppSettings["WebSocketPort"]%>";
        var userId = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserId %>";
        var userName = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>";
        var employeeCName = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().EmployeeCName %>";
        var currentTime = '<%=DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") %>';
        var lang = '<%=this.Request.Cookies["lang"].Value %>';
        var _lang = lang;
    </script>
</head>
<body>
    <div class="shadowdiv" id="shadowdiv">
    </div>
    <div id="toolbar" class="topbar">
        <!--logo-->
        <div style="position: absolute; left: 30px; top: 0px;">
            <img src="data:image/png;base64,"
                title="LEAN MES" alt="LEAN MES" />
            <label id="lblVersion" runat="server" style="color: #666;">
            </label>
        </div>
        <div class="topbar-productioninfo">
            <!--工序信息-->
            <span class="topbar-productioninfo-wrap"><span class="topbar-productioninfo-label">
                <%=Resources.lang.ProductionLine %>:</span> <a href="javascript:void(0)" id="topbarproductionline"
                    class="topbar-productioninfo-value" title="<%=FilterRequestQueryString("prodline", "", -1)%>">
                    <%=FilterRequestQueryString("prodline","",15)%></a>&nbsp;&nbsp; <span class="topbar-productioninfo-label">
                        <%=Resources.lang.Station %>:</span> <a href="javascript:void(0)" id="topbarstation"
                            class="topbar-productioninfo-value" title="<%=FilterRequestQueryString("station","",-1)%>">
                            <%=FilterRequestQueryString("station", "", 15)%></a></span><span class="topbar-productioninfo-wrap-end"></span>
            <img src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/console/img/male.png" title="<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName%>"
                style="vertical-align: middle;" alt="<%=Resources.lang.CurrentUser %>" />
            <span style="position: relative; vertical-align: middle;" id="topbar-set"><span class="set-menu">
                <span style="vertical-align: middle">操作菜单</span><img src="../Content/images/desc.gif"
                    style="vertical-align: middle; margin-left: 3px;" alt="" /></span> <span id="topbar-set-menu"
                        class="topbar-set-menu">
                        <ul id="r-menu-item" class="r-menu">
                        </ul>
                    </span></span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <input type="hidden" id="hdnCurrStationId" value="<%=FilterRequestQueryString("stationid","",-1)%>" />
            <input type="hidden" id="hdCurProLine" value="<%=FilterRequestQueryString("prodline", "", -1)%>" />
            <input type="hidden" id="hdnCurrRouteId" value="-1" />
            <input type="hidden" id="hdnCurrProOrderId" value="-1" />
            <input type="hidden" id="hdnCurrResourceId" value="<%=FilterRequestQueryString("resourceid","",-1)%>" />
            <!--客户logo-->
            <div id="customerLogoContainer" style="float: right; margin-top: 2px; margin-right: 2px; width: 200px; height: 45px; display: none;">
            </div>
        </div>
    </div>
    <form id="form1" runat="server" onsubmit="return false;">
        <!--content-->
        <table cellpadding="3" cellspacing="0" border="0" width="100%" id="content">
            <tr>
                <!--left dynamic data & shortcut-->
                <td valign="top" width="250px" align="left">
                    <div id="leftmenu">
                        <input type="hidden" id="hidDbNameList" />
                        <!--time info-->
                        <div class="dds-panel">
                            <div id="timer">
                            </div>
                        </div>
                        <!--product information-->
                        <div class="dds-panel" id="productInfoPanel">
                            <div class="leftmenu-new-header">
                                产品信息
                            </div>
                            <div class="dds-panel-content">
                                <div id="productInfo">
                                </div>
                            </div>
                        </div>
                        <!--production calculate-->
                        <div class="dds-panel" id="productionCalPanel">
                            <div class="leftmenu-new-header">
                                生产计数
                            </div>
                            <div class="dds-panel-content">
                                <div id="productionCal">
                                </div>
                            </div>
                        </div>
                        <!--shortcut-->
                        <div class="dds-panel">
                            <div class="leftmenu-new-header">
                                常用功能
                            </div>
                            <div class="dds-panel-content" style="">
                                <asp:Localize ID="llShortcut" runat="server" />
                                <ul id="shortcut-item">
                                </ul>
                            </div>
                        </div>
                    </div>
                </td>
                <!--slider button-->
                <td valign="middle" align="center" width="7px" class="slidertd" style="background: #ddd">
                    <div id="slider" style="cursor: pointer; text-align: center;">
                        <img id="sliderimg" src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/theme/Metro/images/mini-left.gif"
                            alt="<%=Resources.lang.HideLeftMenu %>" title="<%=Resources.lang.HideLeftMenu %>" />
                    </div>
                </td>
                <!--main content-->
                <td valign="top">
                    <sdpui>
                        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        </asp:ContentPlaceHolder>
                    </sdpui>
                </td>
            </tr>
        </table>
        <asp:HiddenField ID="hdnIsAjaxPull" runat="server" Value="0" />
        <asp:HiddenField ID="hdnCustomerLogoPath" Value="" runat="server" />
        <asp:HiddenField ID="hfMESLang" runat="server" ClientIDMode="Static" />
        <asp:HiddenField ID="hdnCsrfToken" runat="server" />
        <input type="hidden" id="<%=SKT.LeanMES.Web.AppCode.Utility.AntiXSRFHelper.AntiXsrfTokenKey %>" name="<%=SKT.LeanMES.Web.AppCode.Utility.AntiXSRFHelper.AntiXsrfTokenKey %>" value="<%=hdnCsrfToken.Value %>" />
    </form>
    <div id="footbar" class="footbar">
        <!--copyright-->
        <div class="copyright">
            Copyright &copy;
            <%=DateTime.Now.Year.ToString() %>
            <%=Resources.Common.CopyRight %>
        </div>
        <div class="operator" style="background-color: #faf9f9">
            <div id="licenseDisplayText" class="floatleft"></div>
            <div class="btn-line"></div>
            <div id="onlineUserDisplayText" class="floatleft"></div>
        </div>
    </div>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/jquery-ui.min.js"
        type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/dialog/js/jPlugin-dialog-2.0.js"
        type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/treeview/js/jquery.tree.js"
        type="text/javascript"></script>
    <script type="text/javascript" src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/layui/layui.all.js"></script>
    <link href="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/layui/css/layui.css" rel="stylesheet" />
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/ws.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.utility.printer.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.client.productioncollection.js?ver=1.21"
        type="text/javascript"></script>
    <script language="javascript" type="text/javascript">
        var routeId = $("#hdnCurrRouteId").val();
        var prodOrderId = $("#hdnCurrProOrderId").val();
        var resourceId = $("#hdnCurrResourceId").val();
        var stationId = $("#hdnCurrStationId").val();
        var prodline = $("#hdCurProLine").val();
        var name = '<%=Request.QueryString["name"]%>';
        var hdnIsAjaxPull = $("#<%=this.hdnIsAjaxPull.ClientID%>").val();
        var playSoundPassFlag = "<%=System.Configuration.ConfigurationManager.AppSettings["PlaySoundPass"] ?? "0"%>";
        /**
        *加载需显示信息
        */
        function loadDisplayInfo() {
            var result = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.GetDisplayProInfo(name);

            if (result.error != null) {
                alert(result.error.Message);
                return false;
            }
            var content = result.value;
            $("#hidDbNameList").val(content[0]);
            $("#productInfo").html(content[1]);
            $("#productionCal").html(content[2]);
            if (content[1] == "") {
                $("#productInfoPanel").hide();
            }
            if (content[2] == "") {
                $("#productionCalPanel").hide();
            }
        }

        /**
        *根据工单刷新产品信息
        */
        function refreshProInfoByProOrderId(proOrderId) {
            var filterSettings = "oi.ProdOrderID='" + proOrderId + "'";
            refreshProInfo(filterSettings);
        }

        /**
        *根据序列号刷新产品信息
        */
        function refreshProInfoBySN(sn) {
            var filterSettings = "sn.Value='" + sn + "'";
            refreshProInfo(filterSettings);
            //需要根据sn来刷新上下工序
            stationRefreshBySN(sn);
        }

        /**
        *刷新产品信息
        */
        function refreshProInfo(filterSettings) {
            var dbNameList = $("#hidDbNameList").val();
            var currStationId = $("#hdnCurrStationId").val();

            var result = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.GetProInfo(dbNameList, filterSettings, currStationId);
            if (result.error != null) {
                alert(result.error.Message);
                return false;
            }
            var content = result.value.Rows;
            if (content.length > 0) {
                dbNameList = dbNameList.split(",");
                for (X in dbNameList) {
                    if (!dbNameList.hasOwnProperty(X)) {
                        continue;
                    }
                    $("#span-pi-" + dbNameList[X]).text(content[0][dbNameList[X]]);

                }
            }

        }

        /**
        *加载button信息
        */
        function loadClientButton(pageName) {
            var buttonlist = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.LoadButtons(pageName);
            if (buttonlist.error != null) {
                alert(buttonlist.error.Message);
                return false;
            }
            buttonlist = buttonlist.value;
            //检查用户权限，手动关箱权限加载
            buttonlist = getModulesByUserId(buttonlist);

            var buttons = new Array();
            for (var i = 0; i < buttonlist.length; i++) {
                buttons[i] = { Text: buttonlist[i].Text, Tooltip: buttonlist[i].ToolTip, Icon: buttonlist[i].Icon, Handler: buttonlist[i].Handler, InToolbar: buttonlist[i].InToolbar };
            }
            var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName%>';
            //通过用户名 获取 中文名称
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxSupplier.GetNameByUser(userName);
            if (ajax.error != null) {
                alert(ajax.error.Message);
                return false;
            }

            var data = $.parseJSON(ajax.value).data;
            if (data.length > 0 && data.CName != "") {
                userName = data[0].CName;
            }
            loadButtons(buttons, userName);
            <%--loadButtons(buttons, '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName%>');--%>

            //检查是否有UI的权限
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.PagePopedomValidation(pageName);
            if (ajax.error != null) {
                alert(ajax.error.Message);
                return false;
            }
            //是否未记录用户站位信息（isPop =="1",表示未记录）
            var isPop = '<%=Request.QueryString["isPop"]%>';
            if (!ajax.value || isPop == "1") {
                SwitchStation();
            }
        }




        //BirongLiang 2016-12-30
        $(".dropdown-station").hover(function () {
            $(this).find(".dropdown-station-bd").toggle();
        });


        $(document).ready(function () {
            loadDisplayInfo();
            BindDatepicker();
            //根据配置动态加载打印插件
            isLoadingPrinter("", 4);

            if (hdnIsAjaxPull == "1") {
                setInterval(function () { ajaxPull(); }, 600000);/*开启后每10分钟轮询一次*/
            }
            /*多语初始化*/
            initPageLang();
        });

        //检查用户权限，手动关箱权限加载
        function getModulesByUserId(buttonlist) {
            var idArr = ["Client_CloseContainerByUser"];
            var userId = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserId %>";
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxAccount.GetPopedomNameByUserId(parseInt(userId), "LeanMES_Collection");
            if (ajax.error != null) {
                return false;
            }
            var result = ajax.value.toLowerCase();
            for (var i = 0; i < idArr.length; i++) {
                if (result.indexOf(idArr[i].toLowerCase()) != -1) {
                    if (idArr[i] == "Client_CloseContainerByUser") {
                        //用户没有手动关箱权限，就移除手动关箱功能菜单
                        return buttonlist;
                        //CloseContainerByUser()
                    }
                }
            }
            return buttonlist.filter(btn => btn.Handler !== 'CloseContainerByUser()');
        }

        /*绑定日期控件，如果需要开启[时分秒]，只需在对应页面将 _isHms = true;*/
        _isHms = false;
        function BindDatepicker() {
            $(".DateTimeBox").datepicker({
                //showOn: "button",
                //buttonImageOnly: false,
                showHms: _isHms,
                dateFormat: 'yy-mm-dd',
                buttonText: "<%=Resources.Common.ChooseDate %>",
                onSelect: function () {
                    if (_isHms) {
                        var objme = $(this);
                        if (typeof (objme.attr("_isHms")) == "undefined") {
                            if (objme.val().length > 10) {
                                objme.css("width", "140px");
                            }
                        } else { objme.val(objme.val().substring(0, 10)); }
                    }
                },
                gotoCurrent: true,
                changeMonth: true,
                changeYear: true
            });
        }

        function ProductionAbnormal() {
            dialog({ title: "录入异常", src: "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Anormal/AnormalEdit.aspx?name=Anormal_Add&ID=-1", width: 650, height: 500, resizeable: true });
        }

        function refresh() {
            closeDialog();
        }

        function ajaxPull() {
            if (hdnIsAjaxPull == "1") {
                $.ajax({
                    type: 'get',
                    url: "<%=SKT.LeanMES.Web.WebHelper.WebRoot%>/ajax.html?rnd=" + Math.random(),
                    async: true,
                    success: function (data) {
                    },
                    complete: function (XMLHttpRequest, str) {
                    },
                    datatype: 'text',
                    error: function (xhr, status, error) {
                    }
                });
            }
        }

        $(function () {
            if ($("#<%=this.hdnCustomerLogoPath.ClientID%>").val() != "") {
                $("#customerLogoContainer").show();
                $("#customerLogoContainer").html("<img src='" + $("#<%=this.hdnCustomerLogoPath.ClientID%>").val() + "' width='200px' height='45px'/>");
            }
            /*获取license信息*/
            getLicenseInfo();
            setInterval(function () {
                getLicenseInfo();
            }, 60 * 1000);
        });

        //根据配置动态加载打印插件
        function isLoadingPrinter(printSN, printType) {
            setTimeout(function () {
                loadJs("<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/ws.js", function () { });
                loadJs("<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.utility.printer.js", function () { });
            }, 500);

            function loadJs(url, callback) {
                var script = document.createElement("script")
                script.type = "text/javascript";
                if (script.readyState) {
                    script.onreadystatechange = function () {
                        if (script.readyState == "loaded" || script.readyState == "complete") {
                            script.onreadystatechange = null;
                            callback();
                        }
                    };
                } else {
                    script.onload = function () {
                        callback();
                    };
                }
                script.src = url;
                document.body.insertBefore(script, document.body.firstChild);//在得到的第一个元素之前插入            
            }
        }

        function getLicenseInfo() {
            $.ajax({
                type: 'get',
                url: "<%= SKT.LeanMES.Web.WebHelper.WebRoot %>/Handler/Account.ashx?type=getLicenseInfo&userid=" + userId + "&rnd=" + Math.random(),
                datatype: 'text',
                success: function (data) {
                    var licenseInfo = JSON.parse(data);
                    if (licenseInfo) {

                        if (licenseInfo.LicenseType == 0) {
                            $("#licenseDisplayText").text(mesLang("License授权:") + licenseInfo.LineQty + mesLang("条产线用户数不限"));
                        }
                        else if (licenseInfo.LicenseType == 1) {
                            $("#licenseDisplayText").text(mesLang("License授权:并发用户数") + licenseInfo.UserQty);
                        }
                        else if (licenseInfo.LicenseType == 2) {
                            $("#licenseDisplayText").text(mesLang("License授权:服务器授权"));
                        }
                        $("#onlineUserDisplayText").text(mesLang("系统在线用户") + ":" + licenseInfo.OnlineUserQty + mesLang("人"));
                    }
                }
            });
        }
    </script>
    <script type="text/javascript" src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.utility.ajaxpll.js"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Handler/Language.ashx?cmd=GetLanguageRes&lang=<%=hfMESLang.Value %>" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/lang.button.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/lang.label.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/lang.menu.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/skt.utility.lang.js" type="text/javascript"></script>
</body>
</html>
