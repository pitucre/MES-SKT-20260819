<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="ProdPreMaterial.master.cs" Inherits="SKT.LeanMES.Web.Masters.ProdPreMaterial" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <meta http-equiv="X-UA-Compatible" content="IE=EmulateIE8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link rel="shortcut icon" href="../favicon.ico" type="image/x-icon" />
    <link href="../Content/productioncollection.css?v=20210728" rel="Stylesheet" type="text/css" />
    <link href="../Content/plugin/treeview/jquery.tree.css" rel="Stylesheet" type="text/css" />
    <link href="../Content/plugin/dialog/skin/default/dialog-1.0.3.css" rel="stylesheet"
        type="text/css" />
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/jquery.min.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.utility.validation.js" type="text/javascript"></script>
        <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/crypto-js.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.aes.js" type="text/javascript"></script>
    <title>
        <%= Resources.Common.AppName%></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <script language="javascript" type="text/javascript">
        /*dialog info*/
        var _close = "<%=Resources.Common.Close %>";
        var _enlarged = "<%=Resources.Common.Enlarged %>";
        var _resizewin = "<%=Resources.lang.ResizeWin %>";
        var _dialogwin = "<%=Resources.lang.PopWin %>";
        var _help = "<%=Resources.Common.Help %>";
        var _dataLoading = "<%=Resources.Messages.DataLoading %>";

        /*base info*/
        var webroot = "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>";
        var _root = webroot;
        var _port ="<%=System.Configuration.ConfigurationManager.AppSettings["WebSocketPort"]%>";
        var userId = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserId %>";
        var userName = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>";
        var currentTime = '<%=DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") %>';
        var lang = '<%=this.Request.Cookies["lang"].Value %>';
        var _lang = lang;
    </script>
</head>
<body>
    <div class="shadowdiv" id="shadowdiv">
    </div>
    <div id="toolbar" class="topbar">
        <div class="topbar-title" style=" font-family:Verdana,'微软雅黑',宋体,黑体">
            <img src="data:image/png;base64,"
                style="vertical-align: middle;" alt="<%= Resources.lang.CompanyName%>" width="145px" height="26px"/>
            
        </div>
        <div class="topbar-productioninfo">
            <span class="topbar-productioninfo-label"><%=Resources.lang.ProductionLine %>:</span>
            <a href="javascript:void(0)" id="topbarproductionline" class="topbar-productioninfo-value" title="<%=FilterRequestQueryString("prodline", "", -1)%>"><%=FilterRequestQueryString("prodline","",15)%></a>&nbsp;&nbsp;
            <span class="topbar-productioninfo-label"><%=Resources.lang.Station %>:</span>
            <a href="javascript:void(0)" id="topbarstation" class="topbar-productioninfo-value" title="<%=FilterRequestQueryString("station","",-1)%>"><%=FilterRequestQueryString("station", "", 15)%></a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <img src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/images/icon/User.png" title="<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName%>"
                style="vertical-align: middle;" width="22" height="22" alt="<%=Resources.lang.CurrentUser %>" />
            <span style="position: relative;" id="topbar-set"> <span class="set-menu" style="font-weight: bold; padding-right:20px;">
                <span style="vertical-align:middle">操作菜单</span><img src="../Content/images/desc.gif" style="vertical-align: middle; margin-left: 3px;" alt="" /></span>
                <span id="topbar-set-menu" style="position: absolute; display: none; right: 5px;
                    top: 15px; width: 95px;">
                    <ul id="r-menu-item" style="list-style: none; margin: 5px 0px 0px 0px; padding: 5px 1px 2px 5px;
                        border: 1px solid #d3d3d3; background: url(../Content/theme/metro/images/contextmenu_bg.gif) repeat;">
                    </ul>
                </span>
            </span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <div>
                <input type="hidden" id="hdnCurrStationId" value="<%=FilterRequestQueryString("stationid","",-1)%>"" />
                <input type="hidden" id="hdnCurrRouteId" value="-1"/>
                <input type="hidden" id="hdnCurrProOrderId" value="-1"/>
                <input type="hidden" id="hdnCurrResourceId" value="<%=FilterRequestQueryString("resourceid","",-1)%>"" />
            </div>
        </div>
    </div>
    <form id="form1" runat="server" onsubmit="return false;">
    <div >
        <!--content-->
        <table cellpadding="0" cellspacing="0" border="0" width="100%" id="content">
            <tr>
                <!--left dynamic data & shortcut-->
                <td valign="top" width="250px" align="left">
                    <div id="leftmenu">
                        <input type="hidden" id="hidDbNameList" />
                        <!--time info-->
                        <div class="dds-panel" style=" background:#ccc; padding:3px; text-align:center; margin:5px; width:auto;">
                            <div id="timer"></div>
                        </div>
                        <!--product information-->
                        <div class="dds-panel">
                            <div class="leftmenu-new-header" style=" background:url(../content/theme/metro/images/nav_link.gif) repeat-x">
                                产品信息
                            </div>
                            <div class="dds-panel-content" style=" background:#fff;">
                                <div id="productInfo">
                                 <table cellspacing="0" cellpadding="0" width="100%"><tbody>
                                 <tr><td align="left" class="dds-panel-prodinfo-name"><b>产品代码</b></td></tr>
                                 <tr><td align="left" class="dds-panel-prodinfo-value"><span id="span-pi-ItemCode"></span></td></tr>
                                 <tr><td align="left" class="dds-panel-prodinfo-name"><b>产品描述</b></td></tr>
                                 <tr><td align="left" class="dds-panel-prodinfo-value">
                                 <textarea id="span-pi-ItemName" rows="3" cols="30" class="dds-panel-proinfo-txtarea" readonly="" disabled=""></textarea>
                                 </td></tr>
                                 </tbody></table>
                                </div>
                            </div>
                        </div>
                        <!--shortcut-->
                        <div class="dds-panel">
                            <div class="leftmenu-new-header" style=" background:url(../content/theme/metro/images/nav_link.gif) repeat-x">
                                常用功能
                            </div>
                            <div class="dds-panel-content" style=" overflow-y:auto;background:#fff;">
                                <asp:Localize ID="llShortcut" runat="server" />
                                <ul id="shortcut-item">
                                    
                                </ul>
                            </div>
                        </div>
                    </div>
                </td>
                <!--slider button-->
                <td valign="middle" align="center" width="7px" class="slidertd" style=" background:#ddd">
                    <div id="slider" style=" cursor:pointer; text-align:center;">
                        <img id="sliderimg" src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/theme/Metro/images/mini-left.gif"
                            alt="<%=Resources.lang.HideLeftMenu %>" title="<%=Resources.lang.HideLeftMenu %>" />
                    </div>
                </td>
                <!--main content-->
                <td valign="top">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
        </table>
        
    </div>
    <asp:HiddenField ID="hdnCsrfToken" runat="server" />
    <input type="hidden" id="<%=SKT.LeanMES.Web.AppCode.Utility.AntiXSRFHelper.AntiXsrfTokenKey %>" name ="<%=SKT.LeanMES.Web.AppCode.Utility.AntiXSRFHelper.AntiXsrfTokenKey %>" value="<%=hdnCsrfToken.Value %>" />
    </form>
    <div id="footbar" class="footbar">
        <!--copyright-->
        <div class="copyright">
            Copyright &copy;
            <%=DateTime.Now.Year.ToString() %>&nbsp;&nbsp;
            <%=Resources.Common.CopyRight %>
        </div>
        <div class="operator" style="background-color: #faf9f9">
            <div id="licenseDisplayText" class="floatleft"></div>
            <div class="btn-line"></div>
            <div id="onlineUserDisplayText" class="floatleft"></div>
        </div>
    </div>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/jquery-ui.min.js"
        type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/dialog/js/jPlugin-dialog-2.0.js"
        type="text/javascript"></script>
        
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/treeview/js/jquery.tree.js" type="text/javascript"></script>
       <script type="text/javascript" src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/layui/layui.all.js"></script>
    <link href="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/layui/css/layui.css" rel="stylesheet" />
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/ws.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.client.productioncollection.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Handler/Language.ashx?cmd=GetLanguageRes&lang=<%=hfMESLang.Value %>" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/lang.button.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/lang.label.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/lang.menu.js" type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/lang/skt.utility.lang.js" type="text/javascript"></script>
    <script language="javascript" type="text/javascript">
        function refreshItemInfoByItemId(ItemId) {
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPreCheckMaterial.GetItemInfoBySearch("Item", ItemId);
            if (ajax.error != null) {
                $("#span-pi-ItemCode").html("");
                $("#span-pi-ItemName").val("");
                return false;
            } else {
                //显示产品信息：
                var entity = ajax.value;
                $("#span-pi-ItemCode").html(entity.ItemCode);
                $("#span-pi-ItemName").val(entity.ItemName + entity.ItemDesc);
            }
        }
        /**
        *加载button信息
        */
        function loadClientButton(pageName) {
            var buttonlist = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.LoadButtons(pageName);
            if (buttonlist.error != null) {
                alert(buttonlist.error.Message);
                return false;
            }
            buttonlist = buttonlist.value;
            var buttons = new Array();
            for (var i = 0; i < buttonlist.length; i++) {
                buttons[i] = { Text: buttonlist[i].Text, Tooltip: buttonlist[i].ToolTip, Icon: buttonlist[i].Icon, Handler: buttonlist[i].Handler, InToolbar: buttonlist[i].InToolbar };

            }

            loadButtons(buttons, '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName%>');


        }
        //页面加载
        $(function () {
            /*获取license信息*/
            getLicenseInfo();
            setInterval(function () {
                getLicenseInfo();
            }, 60 * 1000);
        });

        function getLicenseInfo() {
            $.ajax({
                type: 'get',
                url: "<%= SKT.LeanMES.Web.WebHelper.WebRoot %>/Handler/Account.ashx?type=getLicenseInfo&userid=" + userId + "&rnd=" + Math.random(),
                datatype: 'text',
                success: function (data) {
                    var licenseInfo = JSON.parse(data);
                    if (licenseInfo) {

                        if (licenseInfo.LicenseType == 0) {
                            $("#licenseDisplayText").text(mesLang("License授权:") + licenseInfo.LineQty + mesLang("条产线用户数不限"));
                        }
                        else if (licenseInfo.LicenseType == 1) {
                            $("#licenseDisplayText").text(mesLang("License授权:并发用户数") + licenseInfo.UserQty);
                        }
                        else if (licenseInfo.LicenseType == 2) {
                            $("#licenseDisplayText").text(mesLang("License授权:服务器授权"));
                        }
                        $("#onlineUserDisplayText").text(mesLang("系统在线用户") + ":" + licenseInfo.OnlineUserQty + mesLang("人"));
                    }
                }
            });
        }

        loadDisplayInfo();
    </script>
</body>
</html>
