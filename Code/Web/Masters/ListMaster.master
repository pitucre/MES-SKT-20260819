<%@ Master Language="C#" MasterPageFile="~/Masters/Masters.master" AutoEventWireup="true"
    ViewStateMode="Disabled" Inherits="SKT.LeanMES.Web.Masters.ListMaster" CodeBehind="ListMaster.master.cs" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
    <link href="../Content/plugin/autocomplete/jquery.autocomplete.css" rel="stylesheet"
        type="text/css" />
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.utility.tablelist.js?v=20250224"
        type="text/javascript"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/autocomplete/jquery.autocomplete.js"
        type="text/javascript"></script>
    <%--<script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/tabSize.js"   type="text/javascript"></script>--%>
    <script language="javascript" type="text/javascript">
        var RequireOnlyOneRecord = "<%=Resources.Messages.RequireOnlyOneRecord %>";
        var RequireOperateRecord = "<%=Resources.Messages.RequireOperateRecord %>";
        var ConfirmDelete = "<%=Resources.Messages.ConfirmDelete %>";
        var isMultiple = false;
        var isShowMultipleSelection = true;
        var isShowSetColumn = true;
        var isShowNoSearchConditions = false;
        var isShowListCheckboxColumn = true;  //是否显示列头、列表中的复选框对应列
        var currentRowIndex = -1;
    </script>
    <style type="text/css">
        .table {
            table-layout: fixed;
        }
        .thead th{
          position: sticky;
          top: -1px;
          z-index:999;
        }
        .updown {
            background: #f7f7f7 url(../Content/Images/mini-updown.gif) center center no-repeat;
            height: 6px;
            width: 99.8%;
            border: 1px solid #d3d3d3;
            border-bottom: none;
        }

            .updown:hover {
                height: 6px;
                width: 99.8%;
                background: #f1f1f1 url(../Content/Images/mini-updown.gif) center center no-repeat;
                cursor: pointer;
            }

        .leftmenu-group-item-toggle {
            width: 9px;
            height: 10px;
            background: url(../Content/theme/Metro/images/ico_bg.png) -154px -286px no-repeat;
            right: 12px;
            cursor: pointer;
            top: 7px;
            position: absolute;
            display: block;
        }

        .leftmenu-group-item-toggle-selected {
            width: 9px;
            height: 10px;
            background: url(../Content/theme/Metro/images/ico_bg.png) -154px -275px no-repeat;
            right: 12px;
            cursor: pointer;
            top: 7px;
            position: absolute;
            display: block;
        }

        #updownSearchContainer1 {
            color: #ccc;
        }

            #updownSearchContainer1:hover {
                cursor: pointer;
                color: #2a85d8;
            }

        .overlay {
            background: url(../Content/theme/Metro/images/bigloading.gif) no-repeat;
            width: 66px;
            height: 66px;
            top: 50%;
            left: 46%;
            display: none;
            position: absolute;
            z-index: 10010;
        }
    </style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    <!--搜索模块 开始-->
    <div id="searchField">
        <div id="searchField_content">
            <asp:ContentPlaceHolder ID="SearchContent" runat="server">
            </asp:ContentPlaceHolder>
            <div class="clear5">
            </div>
            <div style="text-align: center;" id="searchBtns">
                <asp:CheckBox ID="chkMatchWholeWord" runat="server" /><label for="<%= this.chkMatchWholeWord.ClientID %>"><%= Resources.Common.MatchWholeWord %></label>
                <input type="button" id="searchSubmit" value="<%=Resources.lang.Search %>" onclick="doSearch()"
                    class="SearchButton" title="<%=Resources.lang.Search %>" />
                <input type="button" id="Button1" value="<%=Resources.lang.Clear %>" onclick="clearSearch()" class="SearchButton"
                    title="<%=Resources.lang.ClearQueryCriteria %>" />
            </div>
            <div class="clear5">
            </div>
        </div>
    </div>
    <!--列表模块 开始-->
    <div class="ListTableTitle" id="defaultPageTitle" runat="server" style="display: none;">
        <div style="position: absolute; left: 10px; top: 7px;">
            <img src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/Images/icon/list.png" alt=""
                style="vertical-align: middle;" />&nbsp;<asp:Label runat="server" ID="pageTitle"></asp:Label>
        </div>
    </div>
    <div class="clear0">
    </div>
    <div class="overlay">
    </div>
    <div style="text-align: center; height: 18px; line-height: 18px; padding: 5px; padding-left: 5px; background: #f1f1f1; border: 1px solid #d3d3d3; border-bottom: none; position: relative;display:flex">
        <div style="width: 40%;text-align: left;">
            <span style="" id="IsShowMultipleSelection">
            <input type="checkbox" id="ckbMultipleSelected" /><%=Resources.lang.MultipleSelection %></span>
        <span style="padding-left: 25px;" id="IsShowSetColumn"><a id="setGridColumn" style="text-decoration: underline;" href="javascript:void(0);">设置列属性</a></span>
        </div>
        <div style="width: 60%;text-align: left;">
            <span id="updownSearchContainer1">单击此处可显示或隐藏搜索区</span> <span class="leftmenu-group-item-toggle leftmenu-group-item-toggle-selected"
            id="updownSearchContainer" title="隐藏或显示搜索区" onclick="javascript:void(0); $(function(){$('#searchField').toggle();});"></span>
        </div>
        
    </div>
    <div style="" id="gridviewcontainer" role="region" aria-labelledby="caption" tabindex="0">
        <asp:ContentPlaceHolder ID="GridviewContent" runat="server">
        </asp:ContentPlaceHolder>
        <div id="NoSearchConditions" class="pageInfo">
            <asp:Label runat="server" ID="lblNoData" Text='<%$Resources:Messages, InputConditions%>'></asp:Label>
        </div>
    </div>

    <asp:HiddenField ID="hdnPageCount" runat="server" Value="0" />
    <asp:HiddenField ID="hdnIsMultiple" runat="server" Value="0" />
    <script type="text/javascript" language="javascript">
         var gridCellsSet = <%=GridCellsSet%>;
        var gridOldFields = <%=GridCellFields%>;
        var gridCellRowSpans = <%=GridCellRowSpans%>;
        var gridCellsChangeNo = false;
        var gridRecordIDField = "<%=this.recordIDField%>";
         function GridEditCells_Confirm(){
            var tabname = $("#dialogWin div[name='tabname']").text();
            var cells = [];
            $("#dialogWin .ListTableOddRow").each(function (i) {
                var tds = $(this).find("td");
                cells.push({
                    field:tds.eq(0).text(),
                    title:tds.eq(1).find("input").length == 0 ? null : tds.eq(1).find("input").val(),
                    width:tds.eq(2).find("input").val(),
                    sort:tds.eq(4).find("input").length == 0 ? null : tds.eq(4).find("input").val(),
                    hide:tds.eq(5).find("input").get(0).checked,
                    rowspan:tds.eq(6).find("input").get(0).checked,
                    sum:tds.eq(7).find("input").get(0).checked,
                    format:tds.eq(8).find("select").length == 0 ? null : tds.eq(8).find("select").val(),
                    no:i + (gridRecordIDField.toLowerCase() == "null" ? 0 : 1)
                });
            });
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.SaveGridCellsSet("<%=Request.Url.AbsolutePath%>",tabname,JSON.stringify(cells));
            if (ajax.error != null) {
                alert(ajax.error.Message);
                return;
             }
             
            window.location.reload();
        }
        function GridEditCells_Reset() {
            var tabname = $("#dialogWin div[name='tabname']").text();
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.ResetGridCellsSet("<%=Request.Url.AbsolutePath%>",tabname);
            if (ajax.error != null) {
                alert(ajax.error.Message);
                return;
            }
            window.location.reload();
        }
        //打开列表设置对话框
        function OpenGirdColumnSettingDialog(event)
        {
            //处理选择框
            var formatdata = ["yyyy-MM-dd HH:mm:ss","yyyy-MM-dd","HH:mm:ss"];
            function getselectnode(format) {
                if(!format)
                    return "";
                var str = "<select style='width:200px'>";
                for (var i = 0; i < formatdata.length; i++) {
                    str += "<option" + (format == "{0:" + formatdata[i] + "}" ? " selected='selected'" : "") + " value='{0:" + formatdata[i] + "}'>" + formatdata[i] + "</option>";
                }
                return str+"</select>";
            }
 

            var str = "<tr class='ListTableHeader'><td>" + mesLang("字段") + "</td><td>" + mesLang("名称") + "</td><td>" + mesLang("最小宽度") + "</td><td>" + mesLang("是否排序") + "</td><td>" + mesLang("排序字段") + "</td><td>" + mesLang("隐藏") + "</td><td>" + mesLang("合并") + "</td><td>" + mesLang("汇总") + "</td><td>" + mesLang("格式化") + "</td>" + (gridCellsChangeNo ? "<td>" + mesLang("操作") + "</td>" : "") + "</tr>";
            var tname = event.data;
            var qty = {};
            for (var i = 0; i < gridCellsSet[tname].length; i++) {
                if(qty[gridCellsSet[tname][i].field])
                {
                    alert(gridCellsSet[tname][i].field + mesLang("字段存在多次,请先修改程序后在做配置"));
                    return;
                }
                qty[gridCellsSet[tname][i].field] = 1;
                str += "<tr class='ListTableOddRow'><td>" + gridCellsSet[tname][i].field + "</td>"
                    + "<td>" + (gridCellsSet[tname][i].title != null ? "<input style='width:100px' type='text' value='" + gridCellsSet[tname][i].title + "'/>" : "") + "</td>"
                    + "<td><input style='width:40px' type='text' value='" + gridCellsSet[tname][i].width + "'/></td>"
                    + "<td><input type='checkbox'" + (gridCellsSet[tname][i].sort ?" checked='checked'" : "") + " onchange='changeGirdColumnSort(this)' /></td>"
                    + "<td>" + (gridCellsSet[tname][i].sort != null ? "<input style='width:100px' type='text' value='" + gridCellsSet[tname][i].sort + "' onchange='changeGirdColumnSortFiled(this)'/>" : "") + "</td>"
                    + "<td><input type='checkbox'" + (gridCellsSet[tname][i].hide ? " checked='checked'" : "") + "  onchange='changeGirdColumnHide(this)'/></td>"
                    + "<td><input type='checkbox'" + (gridCellsSet[tname][i].rowspan ? " checked='checked'" : "") + "  onchange='changeGirdColumnRowSpan(this)'/></td>"
                    + "<td><input type='checkbox'" + (gridCellsSet[tname][i].sum ? " checked='checked'" : "") + "  onchange='changeGirdColumnSum(this)'/></td>"
                    + "<td>" + (gridCellsSet[tname][i].format != null ? getselectnode(gridCellsSet[tname][i].format) : "") + "</td>";
                if(gridCellsChangeNo)
                    str += "<td><span class='tab_tr_td_span' type='0'>↑</span>&nbsp;&nbsp;<span class='tab_tr_td_span' type='1'>↓</span></td>";
                str += "</tr>";
            }
            
            dialog({
                title: mesLang("设置列属性"),
                width: 800,
                height: 400,
                content: "<div style='height:400px;overflow:auto;'><table class='ListTable' style='width: 100%;'>" + str + "</table></div>" +
                    "<div name='tabname' style='display:none;'>" + tname + "</div>",
                buttons: [
                    { text: mesLang("确定"), onclick: "GridEditCells_Confirm" },
                    { text: mesLang("重置"), onclick: "GridEditCells_Reset" },
                    { text: mesLang("关闭"), onclick: "closeDialog" }
                ]
            });
            if(gridCellsChangeNo){
                $("#dialogWin").find(".tab_tr_td_span").unbind("click").bind("click", function () {
                    var type = $(this).attr("type");
                    var tr = $(this).parent().parent();
                    if (type == "0") {
                        if(!tr.prev().hasClass("ListTableHeader"))
                            tr.prev().before(tr);
                    } else if (type == "1") {
                        tr.next().after(tr);
                    }
                });
            }
        }

        //选择是否排序
        function changeGirdColumnSort(e){
            var tr = $(e).parent().parent();
            var tdSortFiled = tr.find("td:eq(4)");
            var tdFiled = tr.find("td:eq(0)");
            if($(e).prop('checked')){
                tdSortFiled.find("input:eq(0)").val(tdFiled.text());
            }
            else{
                tdSortFiled.find("input:eq(0)").val("");
            }
        }

        //排序字段修改时
        function changeGirdColumnSortFiled(e){
            var tr = $(e).parent().parent();
            var tdIsSort= tr.find("td:eq(3)");
            if($(e).val() == ""){
                tdIsSort.find("input:eq(0)").prop("checked",false);
            }
            else{
                tdIsSort.find("input:eq(0)").prop("checked",true);
            }
        }

        //选择是否合并
        function changeGirdColumnHide(e){
            var tr = $(e).parent().parent();
            var tdHideFiled = tr.find("td:eq(5)");//隐藏
            var tdRowSpanFiled = tr.find("td:eq(6)");//合并列
            var tdSumFiled = tr.find("td:eq(7)"); //汇总列
            if($(e).prop('checked')){ 
                tdRowSpanFiled.find("input:eq(0)").prop("checked",false);
                tdSumFiled.find("input:eq(0)").prop("checked",false);
            } 
        }

        //选择是否合并
        function changeGirdColumnRowSpan(e){
            var tr = $(e).parent().parent();
            var tdHideFiled = tr.find("td:eq(5)");//隐藏
            var tdRowSpanFiled = tr.find("td:eq(6)");//合并列
            var tdSumFiled = tr.find("td:eq(7)"); //汇总列
            if($(e).prop('checked')){ 
                tdHideFiled.find("input:eq(0)").prop("checked",false);
                tdSumFiled.find("input:eq(0)").prop("checked",false);
            } 
        }

        //选择是否汇总
        function changeGirdColumnSum(e){
            var tr = $(e).parent().parent();
            var tdHideFiled = tr.find("td:eq(5)");//隐藏
            var tdRowSpanFiled = tr.find("td:eq(6)");//合并列
            var tdSumFiled = tr.find("td:eq(7)"); //汇总列
            if($(e).prop('checked')){ 
                tdHideFiled.find("input:eq(0)").prop("checked",false);
                tdRowSpanFiled.find("input:eq(0)").prop("checked",false);
            } 
        }

        function addTableHeader() {
            $("#gridviewcontainer>div").eq(0).css({ maxHeight: '100%', overflow: 'auto' }).attr('id', 'gridviewcontainer')
            /*start  表格表头拖拽*/
            var ListTableObj = $(".ListTable");
            let str = ''

            for (let i = 0; i < ListTableObj.length; i++) {
                if ($(ListTableObj[i]).find('thead').length) {
                    $(ListTableObj[i]).find('thead').addClass('ListTableHeader thead')
                    return
                }
                if ($(ListTableObj[i]).find("tr").length <= 1) {
                    $(".ListTable").addClass('gridviewcontainer')
                    return
                }

                var objTH = $(ListTableObj[i]).find("tr").eq(0);
                str = objTH.html()
                $(ListTableObj[i]).prepend(
                    '<thead class="ListTableHeader thead">' +
                    '<tr>' +
                    str
                    + '</tr>' +
                    '</thead > '
                )
                str = ''
                $(".ListTable tbody").eq(i).find("tr").eq(0).remove()
            }
        }

        $(function () { 
            for (var name in gridCellsSet) {
                var tabnode = $("#ContentPlaceHolder1_GridviewContent_" + name);
                if(tabnode.length == 0)
                    tabnode = $("#" + name);
                if(tabnode.length == 0)
                    continue;
                
                if (gridOldFields[name].length > 0) { 
                    tabnode.find("tr").each(function (index) {
                        //非翻页行
                        if (!$(this).hasClass("ListTablePager") && $(this).attr("class")) {
                            //表头列，数据列
                            var tds = $(this).find(index == 0 ? "th" : "td");

                            for (var i = 0; i <  gridOldFields[name].length; i++) {
                                //设置列对应的字段名
                                tds.eq(i + (gridRecordIDField.toLowerCase() == "null" ? 0 : 1)).attr("field", gridOldFields[name][i]);
                            }
                            var td;
                            for (var i = 0; i <  gridCellsSet[name].length; i++) {
                                //根据配置获取对应列
                                td = $(this).find((index == 0 ? "th" : "td") + "[field='" + gridCellsSet[name][i].field + "']");
                                if(i > 0){
                                    //根据配置的排序进调整列顺序
                                    td.insertAfter($(this).find((index == 0 ? "th" : "td") + "[field='" + gridCellsSet[name][i-1].field + "']"));
                                }
                                //根据配置设置列是否显示
                                if (gridCellsSet[name][i].hide) {
                                    td.hide();
                                }
                            }
                        }
                        //modify by xiongyz 20210422
                        //隐藏标题行和数据行后,重新设置Pager行的colspan（解决无法完全隐藏列的问题）
                        if($(this).hasClass("ListTablePager"))
                        {
                            var thVisibleCount = tabnode.find("th:visible").length;
                            var $td = $(this).find("td:first");
                            $td.attr("colspan",thVisibleCount);
                        }
                    });
                    //add by xudong.zhu 20230314
                    //合并行处理
                    for(var i = 0; i < gridCellRowSpans[name].length; i++){
                        var mRow = 1;
                        var field = gridCellRowSpans[name][i].field;
                        //首行记录值
                        var sMark = tabnode.find("tr:eq(1)").find("[field='" + field + "']").text();
                        //遍历行
                        tabnode.find("tr").each(function (index) {
                            if (!$(this).hasClass("ListTablePager") && $(this).attr("class")) {
                                //第2行数据（不含表头行）
                                if(index > 1){
                                    //比较当前行指定列的值是否和记录的值相等
                                    if ($(this).find("[field='" + field + "']").text() == sMark){
                                        tabnode.find("tr:eq(" + index + ")").find("[field='" + field + "']").remove();
                                        tabnode.find("tr:eq(" + mRow + ")").find("[field='" + field + "']").attr("rowspan",index - mRow + 1); 
                                    }else{
                                        //更换记录行
                                        mRow = index;
                                        //更换记录值
                                        sMark = tabnode.find("tr:eq(" + mRow + ")").find("[field='" + field + "']").text();
                                    }
                                }
                            }
                        });
                    }
                }
                else {
                    //modify by yz.xiong 2021-06-28     为列表加载filed属性，方便列表单元格获取值(getOneRecordCellTextByFiled)
                    tabnode.find("tr").each(function (index) {
                        if (!$(this).hasClass("ListTablePager") && $(this).attr("class")) {
                            var tds = $(this).find(index == 0 ? "th" : "td");
                            for (var i = 0; i <  gridCellsSet[name].length; i++) {
                                tds.eq(i + (gridRecordIDField.toLowerCase() == "null" ? 0 : 1)).attr("field", gridCellsSet[name][i].field);
                            }
                        }
                    });
                }

                //合适高度显示设置列属性
                if($(window).height() > 478){
                    $("#setGridColumn").bind("click", name, OpenGirdColumnSettingDialog);
                    tabnode.find("th").attr("tabname",name).bind("dblclick",name,OpenGirdColumnSettingDialog);
                }
                else{
                    $("#setGridColumn").hide();
                }
               
            }
            /****************************/
            //zhibin.Chen 2016-2-29 解决页面刷新后，多选设置被重置的问题。
            if ($("#<%=this.hdnIsMultiple.ClientID %>").val() == "1") {
                isMultiple = true;
            }
            /****************************/

            if ($("#searchField input[type='text']").length > 0) {
                $("#searchField input[type='text']").eq(0).focus();
            }
            if (!isMultiple) {
                /*$(".ListTable tr:first").children("th:first").html("");*/
                $(".ListTable tr:first").children("th:first").children("input").hide();
            }
            /* $("#searchWin").draggable();*/

            doAction();

            document.onkeydown = function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                /****************************/
                //zhibin.Chen 2016-2-29 列表支持回车查询。
                if (curKey == 13) {
                    //不是所有页面都支持回车刷新查询，如果不想回车触发查询，页面定义var NotdoSearch=1即可  update Snake.lu 2020年12月7日16:48:53
                    if (typeof NotdoSearch!="undefined") {
                        return;
                    }
                    doSearch();
                }
            };

            $(document).ready(function () {
             
                ///*start  表格表头固定*/
                var table = $(".ListTable:eq(0)");
                if (table == null || table == undefined) {
                    return false;
                }
                var tableId = table.attr("id");

                if ("undefined" == typeof (tableId)) {
                    return false;
                }
                var objTH = table.find("th");
                for (var j = 0; j < objTH.length; j++) {
                    $(objTH[j]).attr('width', $(objTH[j]).css('width').replace("px", ""));
                    $(objTH[j]).css('width', '');
                } 
                $("#" + tableId).fixedHeader();                        
               
                ///*end  表格表头拖拽*/
            });

            /*Add By Alen 2017-08-28 修复列表滚动条的问题*/
            setListSize();
            
            $(window).resize(function () {
                setListSize();
                
                setTimeout(function () {
                    $(".ListTable:eq(0) tr:first th").each(function (i, obj) {
                        if (!window.ActiveXObject && !("ActiveXObject" in window)) {
                            $("#footerTR th:eq(" + i + ")").width($(obj).width() + 1);
                        }
                        else {
                            $("#footerTR th:eq(" + i + ")").width($(obj).width());
                        }                        
                    });
                    $("#footerTR").width($(".ListTable:eq(0) tr:first").width());
                }, 100);
            });

        

            $("#ckbMultipleSelected").change(function () {
                if ($(this)[0].checked) {
                    isMultiple = true;
                    $("#<%=this.hdnIsMultiple.ClientID %>").val("1");
                    $(".ListTable tr:first").children("th:first").children("input").show();
                }
                else {
                    isMultiple = false;
                    $("#<%=this.hdnIsMultiple.ClientID %>").val("0");
                    $(".ListTable input[type=checkbox]").each(function () {
                        $(this)[0].checked = false;
                    });
                    $(".ListTable tr:first").children("th:first").children("input").hide();
                }
            });

            if (isMultiple) {
                $("#ckbMultipleSelected")[0].checked = true;
            }
            //Wesley:2024-11-4 增加列表上显示隐藏多选按钮
            if (isShowMultipleSelection) {
             
                $("#IsShowMultipleSelection").show();
            } else {
                $("#IsShowMultipleSelection").hide();
            }
            //Wesley:2024-12-7 增加列表上显示隐藏设置列属性
            if (isShowSetColumn) {
                
                $("#IsShowSetColumn").show();
            } else {
                $("#IsShowSetColumn").hide();
            }
            //Wesley:2024-12-7 增加列表上显示隐藏请输入条件查询!
            if (isShowNoSearchConditions) {
                $("#NoSearchConditions").show();
            } else {
                $("#NoSearchConditions").hide();
            }
            //2024-12-15 增加是否显示列头、列表中的复选框对应列
            if (!isShowListCheckboxColumn) {
                $(".ListTable tr.ListTableHeader th:first").hide();
                $(".ListTable tr td input[name=\"chkSelect\"]").parent().hide();
            }
            
            $("#updownSearchContainer").click(function () {
                $(this).toggleClass("leftmenu-group-item-toggle-selected");
                initListHeight();
            });
            $("#updownSearchContainer1").click(function () {
                $("#updownSearchContainer").toggleClass("leftmenu-group-item-toggle-selected");
                $('#searchField').toggle();
                initListHeight();
            });

            //列表小数点处理：
            $(".ListTable tbody td.number").each(function () {
                var txt = $.trim($(this).text());
                if (txt != "") {
                    $(this).text(parseFloat(txt));
                }
            });
            addTableHeader()
        });

        function Search() {
            showShadow(true);
            $("#searchWin").width(($(window).width() <= 200) ? 180 : (($(window).width() - 200) < 500) ? 500 : (($(window).width() - 200) > 700) ? 700 : ($(window).width() - 200));
            $("#searchWin").height(($(window).height() <= 100) ? 90 : (($(window).height() - 100) < 350) ? 350 : ($(window).height() - 100));
            $("#searchField").css({ "left": (($(window).width() - $("#searchWin").width()) / 2) + "px", "top": (($(window).height() - $("#searchWin").height()) / 2) + "px" });
            $("#dlg-title").width($("#searchWin").width() - 80);
            $("#dlg-body").width($("#searchWin").width() - 30);
            $("#dlg-body").height($("#searchWin").height() - 100);
            $("#searchField").show();
        }

        function doSearch() {
            $(".overlay").show();
            document.forms[0].submit();
        }

        function doAction() {
            if ("<%=!IsPostBack %>" == "True") {
                if ('<%=Request.QueryString["doAction"] %>' == "openAdd") {
                    if (typeof (Add) == "function") {
                        Add();
                    }
                }
            }
        }

        function hideSearch() {
            $("#searchField").hide();
            showShadow(false);
        }

        function clearSearch() {
            $("#searchField_content input[type=text]").val("");
            $("#searchField_content input[type=hidden]").val("");
            $("#searchField_content select option:first").prop("selected", "selected");
            $("#searchField_content select").find("option:first").attr("selected", true);
            //额外调用的方法
            try {
                if (typeof clearOthers === "function") {
                    clearOthers(); //是函数则调用函数
                }
            } catch (e) { }
            doRefresh();
        }

        //清空日历控件数据
        function clearDataTime() {
            $("#searchField_content input[class='DateTimeBox hasDatepicker']").val("");
        }

        function doRefresh() {
            document.forms[0].submit();
        }

        function goPage() {
            $("#commandname").val("go");
            doRefresh();
        }
        /*Add By Alen 2017-08-28 修复列表滚动条的问题*/
        function setListSize() {
            var h = $(window).height() - $("#searchField").css("height").replace("px", "") - 65 - (isShowNoSearchConditions ? 38 : 0);
            $("#gridviewcontainer").css("height", h + "px");
            //addTableHeader()
        }

        /*Add By Alen 2017-09-29 修复列表页面隐藏搜索模块时列表页面高度没有自适应*/
        function initListHeight() {
            if ($("#updownSearchContainer").attr("class").indexOf("leftmenu-group-item-toggle-selected") != -1) {
                var h = $(window).height() - $("#searchField").css("height").replace("px", "") - 65;
                $("#gridviewcontainer").css("height", h + "px");
                $("#footerTR").css("top", parseInt($("#searchField").css("height").replace("px", "")) + 60);
            }
            else {
                var h = $(window).height() - 65;
                $("#gridviewcontainer").css("height", h + "px");
                $("#footerTR").css("top", 60);
            }
        }

        //根据样式名获取文本
        function getTextByClass(cls) {
            return $.trim($("#gridviewcontainer table.ListTable:first tbody input[name=\"chkSelect\"]:checked").parent().siblings("." + cls).text());
        }
    </script>
    <input type="hidden" value="" name="commandname" id="commandname" />
</asp:Content>
