        /*加载按钮*/
        function loadButtons(buttons) {
            var strButtons = "";
            var oname = $.trim(window.localStorage.getItem("OrganizationName"));
            for (var i = 0; i < buttons.length; i++) {
                if (oname != "集团总部" && buttons[i].Text && buttons[i].Text== "数据下发") {
                    continue;
                }
                if (!buttons[i].Text && (/^usp_\d+_handler$/.test(buttons[i].Handler) || /^\d+$/.test(buttons[i].Handler))) {
                    $.ajax({
                        url: "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Handler/Account.ashx?type=getbuttontext&name=<%=Request.QueryString["name"] %>&handler=" + buttons[i].Handler + "&random=" + new Date().getTime(),
                        contentType: "application/json",
                        async: false,
                        success: function (msg) {
                            buttons[i].Text = msg;
                        }
                    });
                }
                strButtons += "<div class=\"toolbar-btn\" onclick=\"" + InitHander(buttons[i].Handler) + "\" title=\"" + buttons[i].Tooltip + "\"><div class=\"icon-16-" + buttons[i].Icon + "\"></div><div class=\"btn-text\">" + buttons[i].Text + "</div></div>";
                if (i != buttons.length - 1) {
                    strButtons += "<div class=\"btn-line\"></div>";
                }
            }
            if (buttons.length > 0) {
                $("#toolbar").html(strButtons + "<div class=\"clear0\"></div>");
                $("#toolbar").addClass("toolBar");
            }
        }
        function ExeOpenDialog(tempId) {
            var grid = $("#gridviewcontainer .ListTable");
            var Ids = "";
            if (grid.length == 1) {
                if (grid.find("input[name='chkSelect']:checked").length > 1) {
                    grid.find("tr").each(function () {
                        var node = $(this).find("input[name='chkSelect']:checked");
                        if (node.length == 1) {
                            if (Ids != "")
                                Ids += ",";
                            Ids += node.attr("value").replace(/</g, "&lt;").replace(/&/g, "&amp;");
                        }
                    });
                } else {
                    if (typeof (selectedRowIndex) == "undefined" || selectedRowIndex < 1) {
                        alert("请选择行");
                        return false;
                    }
                    var node = grid.find("tr").eq(selectedRowIndex).find("input[type='checkbox']");
                    if (node.length == 1)
                        Ids = node.attr("value").replace(/</g, "&lt;").replace(/&/g, "&amp;")
                }
            }
            if (Ids != "")
                Ids = "&Ids=" + Ids;

            dialog({ title: "", src: "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/SDP/SDPUIPreview2.aspx" + window.location.search + "&TempId=" + tempId + Ids, width: 800, height: 400 });
        }
       function ListXml(grid,enname,listname) {
            var xml = "";
            if (grid.find("input[name='chkSelect']:checked").length > 1) {
                xml = "<" + listname + ">";
                grid.find("tr").each(function () {
                    if ($(this).find("input[name='chkSelect']:checked").length == 1) {
                        xml += "<" + enname + ">";
                        $(this).find("td").each(function (i) {
                            if ($(this).find("input[type='checkbox']").length == 1) {
                                xml += "<column" + i + ">" + $(this).find("input[type='checkbox']").attr("value").replace(/</g, "&lt;").replace(/&/g, "&amp;") + "</column" + i + ">";
                            } else {
                                xml += "<column" + i + ">" + $(this).text().replace(/</g, "&lt;").replace(/&/g, "&amp;") + "</column" + i + ">";
                            }
                        });
                        xml += "</" + enname + ">";
                    }
                });
                xml += "</" + listname + ">";
            } else {
                if (typeof (selectedRowIndex) == "undefined" || selectedRowIndex < 1)
                    return xml;
                
                xml = "<" + enname + ">";
                grid.find("tr").eq(selectedRowIndex).find("td").each(function (i) {
                    if ($(this).find("input[type='checkbox']").length == 1) {
                        xml += "<column" + i + ">" + $(this).find("input[type='checkbox']").attr("value").replace(/</g, "&lt;").replace(/&/g, "&amp;") + "</column" + i + ">";
                    } else {
                        xml += "<column" + i + ">" + $(this).text().replace(/</g, "&lt;").replace(/&/g, "&amp;") + "</column" + i + ">";
                    }
                });
                xml += "</" + enname + ">";
           }
          
            return xml;
        }

        function addTableHeader() {
            $("#gridviewcontainer>div").eq(0).css({ maxHeight: '100%', overflow: 'auto' }).attr('id', 'gridviewcontainer');
            /*start  表格表头拖拽*/
            var ListTableObj = $(".ListTable");
            let str = '';

            for (let i = 0; i < ListTableObj.length; i++) {
                if ($(ListTableObj[i]).find('thead').length) {
                    $(ListTableObj[i]).find('thead').addClass('ListTableHeader thead');
                    return
                };
                if ($(ListTableObj[i]).find("tr").length <= 1) {
                    $(".ListTable").addClass('gridviewcontainer');
                    return
                };

                var objTH = $(ListTableObj[i]).find("tr").eq(0);
                str = objTH.html();
                $(ListTableObj[i]).prepend(
                    '<thead class="ListTableHeader thead">' +
                    '<tr>' +
                    str
                    + '</tr>' +
                    '</thead > '
                );
                str = '';
                $(".ListTable tbody").eq(i).find("tr").eq(0).remove();
            }
        }


         function ExeProc(name) {
            var xml = "";
            var form = $("#form1");
            var grid = $("#gridviewcontainer .ListTable");
            if (grid.length == 1) {
                xml = ListXml(grid,"en","datas");
                if (xml=="") {
                    alert("请选择行");
                    return false;
                }
            } else if (form.length == 1) {
                xml = "<en>";
                var id = "", val = "";
                var url = window.location.search.replace("?", "");
                var array = url.split("&");
                var index = 0;
                for (var i = 0; i < array.length; i++) {
                    if (!array[i])
                        continue;
                    index = array[i].indexOf("=");
                    if (index > -1)
                        xml += "<" + array[i].substring(0, index) + ">" + array[i].substring(index + 1, array[i].length) + "</" + array[i].substring(0, index) + ">";
                }
                $("#form1").find("input[id][type='text'],textarea[id],select[id]").each(function () {
                    id = $(this).attr("id");
                    val = $(this).val();
                    if (val == null || val == undefined)
                        val = "";
                    xml += "<" + id + ">" + val.replace(/</g, "&lt;").replace(/&/g, "&amp;") + "</" + id + ">";
                });
                xml +=  ListXml($("#leanmescontent .ListTable"), "dtlen", "dtldatas");
                xml += "</en>";
            } else {
                return false;
            }
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClientConfig.ExeMenuBottonExt(name, xml, parseInt("<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserId %>"));
            if (ajax.error != null) {
                alert(ajax.error.Message);
                return false;
            }
            if (ajax.value) {
                eval(ajax.value);
            }
        }

        function Help() {
            window.open("../Help/Help.htm?helppage=" + getQueryString("name"));
            /*alert("项目实施完成后由顾问统一整理提供,谢谢.");*/
        }

        /*Starry 2015.4.25----------用于提交验证-------------*/
        /*动态加载Handler*/
        function InitHander(handler) {
            if (handler.toUpperCase() == "SAVE()") {
                return "SavePlus()";
            }
            if (/^usp_\d+_handler$/.test(handler)) {
                return "ExeProc('" + handler + "')";
            }
            if (/^\d+$/.test(handler)) {
                return "ExeOpenDialog(" + parseInt(handler) + ")";
            }
            return handler;
        }

        /*增强保存的验证*/
        function SavePlus() {
            if (SubmitValidation()) {
                Save();
            }
        }

        //获取文件
        function GetFilePath(action,fileName) {
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxEsop.LocalFileExists(fileName, action);
            var fileUrl = "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/ESOP/DownLoad.aspx?Action=" + action+"&fileName=" + escape(fileName);
              if(ajax.value!=""){
                 return ajax.value;
              }
              return fileUrl;
        }

        /*绑定日期控件，如果需要开启[时分秒]，只需在对应页面将 _isHms = true;*/
        function BindDatepicker() {
            $(".DateTimeBox").datepicker({
                showOn: "button",
                buttonImageOnly: true,
                showHms: _isHms,
                buttonText: "<%=Resources.Common.ChooseDate %>",
                onSelect: function () {
                    if (_isHms) {
                        var objme = $(this);
                        if (typeof (objme.attr("_isHms")) == "undefined") {
                            if (objme.val().length > 10) {
                                objme.css("width", "140px");
                            }
                        } else { objme.val(objme.val().substring(0, 10)); }
                    }
                },
                gotoCurrent: true,
                changeMonth: true,
                changeYear: true
            });
        }
        /*---------------------------------------------------*/
        var windowWidth = "";
        var windowHeigth = "";
        $(function () {
            windowWidth = $(document.body).width();/**浏览器当前窗口文档body的宽度**/
            windowHeigth = $(window).height();/**浏览器当前窗口文档body的宽度**/
            var h = 34;
            var toolBar = document.getElementById("toolbar").innerHTML;
            if (toolBar.indexOf("toolbar-btn") == -1) {
                h = 5;
            }
            $("#leanmescontent").height($(window).height() - h);
            $(window).resize(function () { $("#leanmescontent").height($(window).height() - h); });
            BindDatepicker();

            var form = document.forms[0];
            var oldsubmit = form.submit;
            form.submit = function () {
                SubmitIdentityKey();
                oldsubmit.call(form)
            }
        });
        function SubmitIdentityKey() {
             $.ajax({
                type: 'post',
                async: false,
                url: "<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Handler/MobileAppLogin.ashx?Action=gettime",
                success: function (time) {
                    $("#hdnSubmitIdentityKey").val(JsDesEncrypt(time));
                }, error: function (a, b, c) {
                    console.log("获取服务端时间异常");
                }
            });
            return true;
        }
