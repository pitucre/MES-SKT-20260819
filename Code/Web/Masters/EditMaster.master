<%@ Master Language="C#" MasterPageFile="~/Masters/Masters.master" AutoEventWireup="true"
    Inherits="SKT.LeanMES.Web.Masters.EditMaster" CodeBehind="EditMaster.master.cs" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.utility.entertotab.min.js"
        type="text/javascript"></script>
    <link href="../Content/plugin/tabs/tabs.css" rel="stylesheet" type="text/css" />
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/plugin/tabs/jPlugin-tabs.js" type="text/javascript" id="masterJsTab"></script>
    <script src="<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/js/skt.client.productioncollection.js" type="text/javascript"></script>
    <style type="text/css">
     .dlg-nc>.nebutton>.close{width:46px; height:19px; cursor:pointer; position:absolute; top:-1px; right:0px; background-position:-14px 0;}
     </style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
    <asp:ContentPlaceHolder ID="EditContent" runat="server">
    </asp:ContentPlaceHolder>
    <div style="display: none;">
        <div class="clear5">
        </div>
        <div class="divHeader">
            扩展字段
        </div>
        <div>
            <table class="ListTable" width="100%">
                <tr class="ListTableHeader">
                    <th>
                        序号
                    </th>
                    <th>
                        字段名
                    </th>
                    <th>
                        类型
                    </th>
                    <th>
                        长度
                    </th>
                    <th>
                        值
                    </th>
                </tr>
                <tr class="ListTableEvenRow">
                    <td>
                        1
                    </td>
                    <td>
                        家庭地址(address)
                    </td>
                    <td>
                        字符型(String)
                    </td>
                    <td>
                        100
                    </td>
                    <td>
                        <input type="text" id="txtAddress" name="txtAddress" />
                    </td>
                </tr>
                <tr class="ListTableOddRow">
                    <td>
                        2
                    </td>
                    <td>
                        家庭地址(address)
                    </td>
                    <td>
                        字符型(String)
                    </td>
                    <td>
                        100
                    </td>
                    <td>
                        <input type="text" id="Text1" name="txtAddress" />
                    </td>
                </tr>
                <tr class="ListTableEvenRow">
                    <td>
                        3
                    </td>
                    <td>
                        家庭地址(address)
                    </td>
                    <td>
                        字符型(String)
                    </td>
                    <td>
                        100
                    </td>
                    <td>
                        <input type="text" id="Text2" name="txtAddress" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <script language="javascript" type="text/javascript">
        $(function () {
            document.onkeydown = function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (e.ctrlKey && curKey == 83) {
                    Save();
                    return false;
                }
            };

            initPageLang();
        });
    </script>
</asp:Content>
