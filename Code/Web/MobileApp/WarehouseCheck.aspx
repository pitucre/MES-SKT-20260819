        //验证是否为数字（小数部分支持6位小数）
        function isGreaterThanOrEqualZero(val) {
            var reg = /^[0-9]+(.[0-9]{1,6})?$/;
            if (!reg.test(val)) {
                return false;
            }
            return true;
        }
