            <div data-role="footer" data-position="fixed">
                <div data-role="navbar">
                    <ul>
                        <li><a href="#" data-transition="none" id="Start" onclick="AgeStart()">开始老化</a></li>
                        <li><a href="#" data-transition="none" id="Reset" onclick="UiReset()">重置</a></li>
                    </ul>
                </div>
            </div>
            <div data-role="panel" id="OrderPanel" style="background: #f9f9f9">
                <div data-role="content">
                    <ul data-role="listview" id="listview" data-inset="false" data-filter="true" data-filter-placeholder="搜索"
                        data-theme="c" class="listview">
                    </ul>
                </div>
            </div>
        </div>
        <div data-role="page" id="pageTwo">
            <div data-role="header" data-position="fixed">
                <h5 style="padding: 4px; margin: 0px;">
                    <div>
                        <%--<img style="width: 60px; height: 50px;" src="data:image/png;base64," />--%>
                    </div>
                    <div>
                        <label style="font-size: 17px !important; font-weight: bold; color: #FFFFFF">老化开始</label>                        
                    </div>
                </h5>
                <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                data-transition="none" data-ajax="false">返回</a><a href="Index.aspx" class="ui-btn-right"
                    data-icon="home" data-transition="none" data-ajax="false">主页</a>
                <div data-role="navbar" data-theme="c">
                    <ul>
                        <li><a href="#pageOne" data-transition="none" data-theme="c">老化开始</a></li>
                        <li><a href="#" data-transition="none" class="ui-btn-active" data-theme="c">老化解绑</a></li>
                    </ul>
                </div>
            </div>
            <div data-role="content">
                <div data-role="fieldcontain">
                    <div>
                         <label >
                            请扫描要移除的SN条码</label>
                        <input type="text" name="fGRN" id="txtSCANSN" />
                    </div>
                    <div style="text-align: center; font-size: 14px" id="rmsg" class="msg">
                    </div>
                    <table id="InfoTableGrn" data-role="table" data-mode="columntoggle" class="ui-responsive table-stroke"
                        style="width: 100%">
                        <thead>
                            <tr>
                                 <th>序号
                                </th>
                                <th>条码
                                </th>
                                <th>操作
                                </th>
                            </tr>
                        </thead>
