        <script type="text/javascript">
            var OrderNos = "";//工单编码
            var StationId = "";//站位
            $(function () {
                $(".ui-body-c").css("background", "#fff");
                $("body>[data-role='listview']").listview();
            });
            $(document).bind("mobileinit", function () {
                $.mobile.ajaxEnabled = false;
            });
            var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>';
            var prodOrderId = -1; //选择的工单
            var orderNo = "";
            $(function () {
            });
            //选择工单
            function chooseOrder() {
                $("#OrderPanel").panel("open");
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.GetOrderList();
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    return false; 
                }
                var htmlstr = "";
                var data = ajax.value;
                $('#listview').html('');
                for (var i = 0; i < data.length; i++) {
                    htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].OrderID + "' onclick=OrderList('" + data[i].OrderNo + "')>" + data[i].OrderNo + "</li>";
                }
                $("#listview").append(htmlstr);
                $('#listview').listview('refresh');
            }
            function OrderList(ID) {
                $("#showOrderNo").html(ID);
                OrderNos = ID;
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");
            }
            //选择工位
            function chooseStation() {
                $("#OrderPanel").panel("open");
                if ($("#showOrderNo").html() == "") {
                    confirmDialog("工单不能为空");
                    return false;
                }
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.GetStationList();
                if (ajax.error != null) {
                    confirmDialog(ajax);
                    return false;
                }
                var htmlstr = "";
                var data = ajax.value;
                $('#listview').html('');
                for (var i = 0; i < data.length; i++) {
                    htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].StationId + "' onclick=StationList('" + data[i].StationId + "')>" + data[i].Station + "</li>";
                }
                $("#listview").append(htmlstr);
                $('#listview').listview('refresh');
            }
            function StationList(ID) {
                $("#showStation").val(ID);
                $("#showStation").html($("#" + ID).html());
                StationId = ID;
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");
                //window.location.href = "#pageTwo";
            }

            //上料
            $("#txtGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $(".msg").html("");
                    if ($("#showOrderNo").html() == "请选择" || $("#showOrderNo").html() == "") {
                        confirmDialog("工单不能为空");
                        return false;
                    }
                    if ($("#showStation").html() == "请选择" || $("#showStation").html() == "") {
                        confirmDialog("工单不能为空");
                        return false;
                    }
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.Loading($("#showOrderNo").html(), $("#showStation").val(), $("#txtGRN").val(), userName);
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        return false;
                    }
                    $(".msg").html("上料成功!").css("color", "#7FFF00");
                    $("#lblMItemCode").html(ajax.value.ItemCode);
                    $("#lblMItemName").html(ajax.value.ItemName);
                    $("#lblQty").html(ajax.value.BalanceQty);
                    $("#txtGRN").focus().select();
                }
            });
            //续料
            $("#txtOldGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $("#txtNewGRN").focus();
                }
            })
            //续料
            $("#txtNewGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    if ($("#showOrderNo").html() == "请选择" || $("#showOrderNo").html() == "") {
                        confirmDialog("工单不能为空");
                        return false;
                    }
                    if ($("#showStation").html() == "请选择" || $("#showStation").html() == "") {
                        confirmDialog("工位不能为空");
                        return false;
                    }
                    if ($("#txtOldGRN").val() == "") {
                        confirmDialogFocus("旧GRN不能为空", function () {
                            $("#txtOldGRN").focus();
                        });
                        return false;
                    }
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.Continued($("#showOrderNo").html(), $("#showStation").val(), $("#txtOldGRN").val(), $("#txtNewGRN").val(), userName);
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        return false;
                    }
                    $("#lblAddItemCode").html(ajax.value.OldItemCode);
                    $("#lblNewItemCode").html(ajax.value.ItemCode);
                    $("#lblNewQty").html(ajax.value.BalanceQty);
                    $(".msg").html("续料成功").css("color", "#7FFF00");
                }
            });

            function Search() {
                $.mobile.changePage("#Search", { transition: 'none' });
                showPickList();
            }
            function showPickList() {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.GetLoadingInfo();
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    return false;
                }

            }
            //执行开拉，停拉动作
            function HandOpenOrStop(execType) {
                //execType  1:开拉  2：停拉
                var message = "";
                if (execType == 1) {
                    message = "确认开拉?";
                }
                else {
                    message = "确定停拉吗?";
                }

                confirmDialog(message, function () {
                    $.ajax({
                        type: "POST",
                        url: "../Handler/ChooseLineAndRes.ashx?type=pullAndStop",
                        async: false,
                        dataType: "text",
                        data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "flage": execType, "userName": userName },
                        success: function (data) {
                            if (data == "") {
                                if (execType == 1) {
                                    confirmDialog("产线开拉执行成功!", null);
                                } else {
                                    confirmDialog("产线停拉执行成功!", null);
                                }
                            }
                            else {
                                confirmDialog(data, null);
                            }
                        },
                        error: function (err) {
                            return;
                        }
                    });
                });
            }

            //卸料动作
            function HandUnLoad() {
                confirmDialog("确定卸料吗", function () {
                    $.ajax({
                        type: "POST",
                        url: "../Handler/ChooseLineAndRes.ashx?type=unloadMaterial",
                        async: false,
                        dataType: "text",
                        data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "userName": userName },
                        success: function (data) {
                            if (data == "") {
                                confirmDialog("卸料成功!", null);
                            }
                            else {
                                confirmDialog(data, null);
                            }
                        },
                        error: function (err) {
                            //报错
                            return;
                        }
                    });
                });
            }

            //查询PickList信息
            function showPickList() {
                $("#showPickList").html("");
                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=searchPickList",
                    async: false,
                    dataType: "json",
                    data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId },
                    success: function (data) {
                        var html = "";
                        var obj = eval(data);
                        html += "<h3>手插清单：" + pickListName + "</h3>";
                        $(obj).each(function (index) {
                            var val = obj[index];
                            //显示信息
                            html += "<div style='border-bottom-width: 2px; border-bottom-style:solid'>";
                            html += " <label >产品料号</label><span >" + val.ItemCode + "</span>";
                            html += " <label >产品名称</label><span >" + val.ItemName + "</span>";
                            html += " <label >需求数量</label><span >" + val.NeedQty + "</span>";
                            html += " <label >已上数量</label><span >" + val.AlreadyQty + "</span>";
                            html += " <label >已上GRN</label><span >" + val.GrnStr + "</span>";
                            html += "</div>";
                        });
                        $("#showPickList").html(html);
                    },
                    error: function (err) {
                        return;
                    }
                });

            }

        </script>
    </form>--%>
