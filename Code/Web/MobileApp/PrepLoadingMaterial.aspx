        <div data-role="page" id="Search">
            <div data-role="header" data-position="fixed">
                <h5 style="padding: 4px; margin: 0px;">
                    <div>
                        <%--<img src="images/icon/prep_white.png"/>--%>
                        <%--<img style="width: 60px; height: 50px;" src="data:image/png;base64," />--%>
                    </div>
                    <div>
                        前置加工上料
                    </div>
                </h5>
                <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                data-transition="none" data-ajax="false">返回</a><a href="Index.aspx" class="ui-btn-right"
                    data-icon="home" data-transition="none" data-ajax="false">主页</a>
                <div data-role="navbar">
                    <ul>
                        <li><a href="#pageOne" data-transition="none"  data-theme="c">设置</a></li>
                        <li><a href="#pageTwo" data-transition="none" data-theme="c">上料</a></li>
                        <li><a href="#AddMaterial" data-transition="none" data-theme="c">续料</a></li>
                        <li><a href="#Srarch" data-transition="none" class="ui-btn-active" data-theme="c" onclick="Search();">查询</a></li>
                    </ul>
                </div>
            </div>
            <div data-role="content">
                <div id="showPickList">
                    <table>
                        <tbody>
                            <tr>
                                <th>物料编码
                                </th>
                                <th>物料名称
                                </th>
                                <th>需求数量
                                </th>
                                <th>已上数量
                                </th>
                                <th>GRN
                                </th>
                            </tr>
                        </tbody>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div data-role="footer" data-position="fixed">
            </div>
        </div>
        <script type="text/javascript">
            var OrderNos = "";//工单编码
            var LineId;//线别
            var StationId = "";//站位
            var pId;//手插 工单线别 ID
            var pStatus;//手插 工单线别 状态
            $(function () {
                $(".ui-body-c").css("background", "#fff");
                $("body>[data-role='listview']").listview();
            });
            $(document).bind("mobileinit", function () {
                $.mobile.ajaxEnabled = false;
            });
            var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>';
            var prodOrderId = -1; //选择的工单
            var orderNo = "";
            var showFlag = "";
            $(function () {
                $("#btnFilter").on("click", function () {
                    $("#listview").html("");
                    var $ul = $(this),
                    value = $.trim($("#OrderPanel input[data-type='search']:eq(0)").val());
                    var htmlstr = "";

                    if (showFlag == "Order") {
                        var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.GetTOPOrderList(value);
                        if (ajax.error != null) {
                            confirmDialog(ajax.error.Message);
                            //写入日志
                            SaveUserUILog(orderNo, ajax.error.Message);
                            return false;
                        }                        
                        var data = ajax.value;
                        $('#listview').html('');
                        for (var i = 0; i < data.length; i++) {
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].OrderID + "' onclick=OrderList('" + data[i].OrderID + "','" + data[i].OrderNo + "') title=\"" + data[i].OrderNo + "\">" + data[i].OrderNo + "</li>";
                        }
                        $("#listview").append(htmlstr);
                        $('#listview').listview('refresh');
                    }
                    else if (showFlag == "Line") {
                        var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.GetTOPLineList(value);
                        if (ajax.error != null) {
                            confirmDialog(ajax);
                            return false;
                        }
                        var data = ajax.value;
                        $('#listview').html('');
                        for (var i = 0; i < data.length; i++) {
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].LineId + "' onclick=LineList('" + data[i].LineId + "') title=\"" + data[i].LineName + "\">" + data[i].LineName + "</li>";
                        }
                        $("#listview").append(htmlstr);
                        $('#listview').listview('refresh');
                    }
                    else if (showFlag == "Station") {
                        var ajax = SKT.LeanMES.Web.AjaxServices.AjaxHandLoadingMaterial.GetTOPStationList(value);
                        if (ajax.error != null) {
                            confirmDialog(ajax);
                            return false;
                        }                        
                        var data = ajax.value;
                        $('#listview').html('');
                        for (var i = 0; i < data.length; i++) {
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].StationId + "' onclick=StationList('" + data[i].StationId + "') title=\"" + data[i].Station + "\">" + data[i].Station + "</li>";
                        }
                        $("#listview").append(htmlstr);
                        $('#listview').listview('refresh');
                    }
                    //showFlag = "";
                });
            });
            //选择工单
            function chooseOrder() { 
                $("#OrderPanel").panel("open");
                $('#listview').html('');
                showFlag = "Order";
                //$("#listview").on("filterablebeforefilter", function (e, data) {
                    //var $ul = $(this)
                    //$input = $(data.input)
                    //value = $input.val();
                    //if (value && value.length > 2) {
                        
                    //}
                //});
            }
            function OrderList(ID, NO) {
                $("#showOrderNo").html(NO);
                OrderNos = ID;
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");               
            }
            //选择工位
            function chooseStation() {
                $("#OrderPanel").panel("open");
                $('#listview').html('');
                if ($("#showOrderNo").html() == "") {
                    confirmDialog("工单不能为空");
                    return false;
                }
                showFlag = "Station";
                
            }
            function StationList(ID) {
                $("#showStation").val(ID);
                $("#showStation").html($("#" + ID).html());
                StationId = ID;
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");
                //window.location.href = "#pageTwo";
            }
            //线别
            function chooseLine() {
                $("#OrderPanel").panel("open");
                $('#listview').html('');
                if ($("#showOrderNo").html() == "") {
                    confirmDialog("工单不能为空");
                    return false;
                }
                showFlag = "Line";
            }
            function LineList(ID) {
                LineId = ID;
                $("#showLine").val(ID);
                $("#showLine").html($("#" + ID).html());
                StationId = ID;
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");
                //window.location.href = "#pageTwo";
            }

            $("#showOrderNo ,#showStation,#showLine").on("change", function () {
                if (($("#showOrderNo").html() == "请选择" || $("#showOrderNo").html() == "") && ($("#showStation").html() == "请选择" || $("#showStation").html() == "")
                    && ($("#showLine").html() == "请选择" || $("#showLine").html() == "")) {
                    HandOpenOrStop(0);
                }
            });
            //上料
            $("#txtGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $(".msg").html("");
                    if ($("#showOrderNo").html() == "请选择" || $("#showOrderNo").html() == "") {
                        confirmDialog("工单不能为空");
                        return false;
                    }
                    if ($("#showStation").html() == "请选择" || $("#showStation").html() == "") {
                        confirmDialog("工位不能为空");
                        return false;
                    }
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPrepLoadingMaterial.Loading(pId, $("#showOrderNo").html(), $("#showStation").val(), $("#txtGRN").val(), userName);
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        return false;
                    }
                    $(".msg").html("上料成功!").css("color", "#7FFF00");
                    $("#lblMItemCode").html(ajax.value.ItemCode);
                    $("#lblMItemName").html(ajax.value.ItemName);
                    $("#lblQty").html(ajax.value.BalanceQty);
                    $("#txtGRN").focus().select();
                }
            });
            //续料
            $("#txtOldGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $("#txtNewGRN").focus();
                }
            })
            //续料
            $("#txtNewGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    if ($("#showOrderNo").html() == "请选择" || $("#showOrderNo").html() == "") {
                        confirmDialog("工单不能为空");
                        return false;
                    }
                    if ($("#showStation").html() == "请选择" || $("#showStation").html() == "") {
                        confirmDialog("工位不能为空");
                        return false;
                    }
                    if ($("#txtOldGRN").val() == "") {
                        confirmDialogFocus("旧GRN不能为空", function () {
                            $("#txtOldGRN").focus();
                        });
                        return false;
                    }
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPrepLoadingMaterial.Continued(pId, $("#showOrderNo").html(), $("#showStation").val(), $("#txtOldGRN").val(), $("#txtNewGRN").val(), userName);
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        return false;
                    }
                    $("#lblAddItemCode").html(ajax.value.OldItemCode);
                    $("#lblNewItemCode").html(ajax.value.ItemCode);
                    $("#lblNewQty").html(ajax.value.BalanceQty);
                    $(".msg").html("续料成功").css("color", "#7FFF00");
                }
            });
            //查询
            function Search() {
                $.mobile.changePage("#Search", { transition: 'none' });
                showPickList();
            }
            //查询
            function showPickList() {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPrepLoadingMaterial.GetLoadingInfo();
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    return false;
                }

            }
            //执行开拉，停拉动作
            function HandOpenOrStop(execType) {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPrepLoadingMaterial.Opeation(OrderNos, LineId, execType, userName)
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    return false;
                }
                switch (execType) {
                    case 0:
                        pId = ajax.value;
                    case 1:
                        confirmDialog("开拉成功！");
                        break;
                    case 2:
                        confirmDialog("停拉成功！");
                        break;
                    case 3:
                        confirmDialog("卸料成功！");
                        break;
                }
            }

            //卸料动作
            function HandUnLoad() {
                confirmDialog("确定卸料吗", function () {
                    $.ajax({
                        type: "POST",
                        url: "../Handler/ChooseLineAndRes.ashx?type=unloadMaterial",
                        async: false,
                        dataType: "text",
                        data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "userName": userName },
                        success: function (data) {
                            if (data == "") {
                                confirmDialog("卸料成功!", null);
                            }
                            else {
                                confirmDialog(data, null);
                            }
                        },
                        error: function (err) {
                            //报错
                            return;
                        }
                    });
                });
            }

            //查询PickList信息
            function showPickList() {
                $("#showPickList").html("");
                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=searchPickList",
                    async: false,
                    dataType: "json",
                    data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId },
                    success: function (data) {
                        var html = "";
                        var obj = eval(data);
                        html += "<h3>手插清单：" + pickListName + "</h3>";
                        $(obj).each(function (index) {
                            var val = obj[index];
                            //显示信息
                            html += "<div style='border-bottom-width: 2px; border-bottom-style:solid'>";
                            html += " <label >产品料号</label><span >" + val.ItemCode + "</span>";
                            html += " <label >产品名称</label><span >" + val.ItemName + "</span>";
                            html += " <label >需求数量</label><span >" + val.NeedQty + "</span>";
                            html += " <label >已上数量</label><span >" + val.AlreadyQty + "</span>";
                            html += " <label >已上GRN</label><span >" + val.GrnStr + "</span>";
                            html += "</div>";
                        });
                        $("#showPickList").html(html);
                    },
                    error: function (err) {
                        return;
                    }
                });

            }
            $(document).on("pageshow", function (event) {
                var _id = location.hash;
                if (_id == "") {
                    $("#pageOne div ul li a").each(function () {
                        if ($(this).attr("href") == "#pageOne") {
                            $(this).addClass("ui-btn-active");
                            return;
                        }
                    });
                    return false;
                }
                $(_id + " div ul li a").each(function () {

                    if ($(this).attr("href") == _id) {
                        $(this).addClass("ui-btn-active");
                        return;
                    }
                })
            });
        </script>
    </form>
</body>
