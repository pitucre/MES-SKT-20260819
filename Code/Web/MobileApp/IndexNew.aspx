        function playSlide()
        {
            var i = 0;
            var slideId = $(".play").attr("id").replace("slide", "");
            if (parseInt(slideId) == 3) {
                i = 0;
            }
            else {
                i = parseInt(slideId) + 1;
            }
            $(".slide").removeClass("play");
            $("#slide" + i.toString()).addClass("play");
