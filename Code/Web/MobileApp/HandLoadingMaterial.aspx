        <script type="text/javascript">
            var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>';
            var prodOrderId = -1; //选择的工单
            var orderNo = "";
            var sltStationId = -1;
            var sltResId = -1;
            var pickListId = 0; //手插 工单线别 ID
            var pStatus = 2; //手插 工单线别 状态
            var scanSN = ""; //GRN条码
            $(function () {
                $(".ui-body-c").css("background", "#fff");
                $("body>[data-role='listview']").listview();
            });
            $(document).bind("mobileinit", function () {
                $.mobile.ajaxEnabled = false;
            });

            $(function () {
                //选择区域
                $("#classType").on("change", function () {
                    var type = ($(this).val());
                    getPickListDetail(type, "Infotab");
                });
            });
            var flag = "";
            $("#btnFilter").on("click", function () {
                $("#Orderlistview").html("");
                var $ul = $(this),
                value = $.trim($("#OrderPanel input[data-type='search']:eq(0)").val());
                //if (value == "") {
                //    alert("请输入查询条件");
                //    return false;
                //}
                var length = 0;
                if (flag == "order") {
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.GetOrderList(value);
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    var htmlstr = "";
                    var data = ajax.value;
                    $('#listview').html('');
                    for (var i = 0; i < data.length; i++) {
                        htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].OrderID + "' onclick=OrderList('" + data[i].OrderID + "','" + data[i].OrderNo + "')>" + data[i].OrderNo + "</li>";
                    }
                    $("#listview").append(htmlstr);
                    $('#listview').listview('refresh');
                }
                else if (flag == "station") {
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.GetPickListStation(prodOrderId);
                    if (ajax.error != null) {
                        showAreaMessge(ajax.error.Message, "messageRed");
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    var list = (ajax.value);
                    if (list.keys.length == 0) {
                        confirmDialog("未找到工单[" + $("#showOrderNo").text() + "]关联路由的扣料工序，请先配置扣料工序！");
                        return false;
                    }
                    var htmlstr = "";
                    $('#listview').html('');                    
                    for (var i = 0 ; i < list.keys.length; i++) {
                        if (list.values[i].indexOf(value) >= 0) {
                            length = length + 1;
                            if (length > 20) {
                                break;
                            }
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + list.keys[i] + "' onclick=StationList('" + list.keys[i] + "')>" + list.values[i] + "</li>";
                        }
                    }
                    $("#listview").append(htmlstr);
                    $('#listview').listview('refresh');
                    $("#OrderPanel").panel("open");
                }
                else if (flag == "resource") {
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxLogin.GetResourcesByOprId(sltStationId, userName);
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    var htmlstr = "";
                    var data = ajax.value;
                    $('#listview').html('');
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].ResName.indexOf(value) >= 0) {
                            length = length + 1;
                            if (length > 20) {
                                break;
                            }
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].ResourceId + "' onclick=ResList('" + data[i].ResourceId + "')>" + data[i].ResName + "</li>";
                        }
                    }
                    $("#listview").append(htmlstr);
                    $('#listview').listview('refresh');
                }
            });

            //选择工单
            function chooseOrder() {
                $("#OrderPanel").panel("open");
                flag = "order";
                $('#listview').html('');
                $("#listview").on("filterablebeforefilter", function (e, data) {
                                   
                });
            }
            function OrderList(ID, OrderNo) {
                $("#sshowOrderNo,#showOrderNo").html(OrderNo);
                prodOrderId = ID;
                sltResId = -1;
                sltStationId = -1;
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");
                chooseStation();
                $("#lblHandList").html("");
                $("#lblItemCode").html("");
                $("#lblItemName").html("");
                $("#lblStatus").html("");
                $("#showRes,#sshowRes,#showStation,#sshowStation").html("请选择");
            }

            /**
            *加载扣料工序
            */
            function chooseStation() {
                if (prodOrderId < 0) {
                    confirmDialog("请先选择工单！");
                    chooseOrder();
                    return false;
                }
                flag = "station";
                $('#listview').html('');
                $("#OrderPanel").panel("open");
                $("#btnFilter").click();
            }

            function StationList(ID) {
                sltStationId = ID;
                $("#showStation,#sshowStation").html($("#" + ID).html());
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");
                $("#showRes").html("请选择");
                sltResId = -1;
                chooseResource();
            }

            //资源
            function chooseResource() {
                if ($("#showOrderNo").html() == "请选择") {
                    confirmDialog("请先选择工单！");
                    chooseOrder();
                    return false;
                }
                if ($("#showStation").html() == "请选择") {
                    confirmDialog("请先选择工序！");
                    chooseStation();
                    return false;
                }
                $("#OrderPanel").panel("open");
                $('#listview').html('');
                flag = "resource";
                $("#btnFilter").click();
            }
            function ResList(ID) {
                sltResId = ID;
                $("#showRes,#sshowRes").html($("#" + ID).html());
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");
                setPickListInfo();
            }

            $("#showOrderNo ,#showStation,#showLine").on("change", function () {
                if (($("#showOrderNo").html() == "请选择" || $("#showOrderNo").html() == "") && ($("#showLine").html() == "请选择" || $("#showLine").html() == "")) {
                    HandOpenOrStop(0);
                }
            });

            /*
            *获取未上料的物料信息
            */
            function getMaterialList() {
                getPickListDetail(2, "InfoTableGrn");
            }
            //上料
            $("#txtGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $(".msg").html("");
                    if (pickListId <= 0) {
                        confirmDialogFocus("未找到有效的组装上料清单!", function () {
                            $("#txtGRN").select();
                        });
                        return false;
                    }
                    scanSN = $.trim($("#txtGRN").val());
                    if (scanSN == "") {
                        confirmDialogFocus("请输入GRN", function () {
                            $("#txtGRN").select();
                        });
                        return false;
                    }

                    collectPickList();
                }
            });
            //续料
            $("#txtOldGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $("#txtNewGRN").focus();
                }
            })
            //续料
            $("#txtNewGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    if (pickListId <= 0) {
                        confirmDialog("未找到有效的组装上料清单！");
                        return false;
                    }
                    if ($("#txtOldGRN").val() == "") {
                        confirmDialogFocus("旧GRN不能为空", function () {
                            $("#txtOldGRN").focus();
                        });
                        return false;
                    }
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.Continued(pId, $("#showOrderNo").html(), $("#showStation").val(), $("#txtOldGRN").val(), $("#txtNewGRN").val(), userName);
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    $("#lblAddItemCode").html(ajax.value.OldItemCode);
                    $("#lblNewItemCode").html(ajax.value.ItemCode);
                    $("#lblNewQty").html(ajax.value.BalanceQty);
                    $(".msg").html("续料成功").css("color", "#7FFF00");
                    setTimeout(function () {
                        $(".msg").html("");
                    }, 1500);
                }
            });

            /**
            *设置上料清单信息
            */
            function setPickListInfo() {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.GetPickListResource(prodOrderId, sltStationId, sltResId);
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    return false;
                }
                var entity = ajax.value;
                if (entity != null && entity.PickListId == 0) {
                    confirmDialog("未找到工单料站表信息！");
                    $("#lblHandList").html("");
                    $("#lblItemCode").html("");
                    $("#lblItemName").html("");
                    return false;
                }
                else {
                    pickListId = entity.PickListId;
                    pStatus = entity.IsMatComplete;
                   
                    var status = "";
                    if (pStatus == 1) {
                        status = "已完成上料";
                    }
                    else {
                        status = "上料中";
                    }
                    $("#lblStatus").html(status);
                    $("#lblHandList").html(entity.PickListName);
                    $("#lblItemCode").html(entity.ItemCode);
                    $("#lblItemName").html(entity.ItemName);
                    $("#setUpLine").show();
                }
                return true;
            }

            /**
            *验证组装上料
            */
            function collectPickList() {
                if (pickListId <= 0) {
                    confirmDialog("未找到有效的组装上料清单！");
                    return false;
                }
                //检验上料匹配信息
                if ($.trim(scanSN) == "") {
                    confirmDialogFocus("请扫码GRN条码！", function () {
                        $("#txtGRN").select();
                    });
                    return false;
                }

                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.CollectPickListGRN(pickListId, scanSN, prodOrderId, sltStationId, sltResId);
                if (ajax.error != null) {
                    confirmDialogFocus(ajax.error.Message, function () {
                        $("#txtGRN").select();
                    });
                    scanSN = "";
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    return false;
                }


                $(".msg").html(scanSN + "上料成功!").css("color", "#7FFF00");
                scanSN = "";
                setTimeout(function () {
                    $(".msg").html("");
                }, 1500);
                $("#txtGRN").val("").focus();
                getMaterialList();


            }

            /**
            *开拉
            */
            function pull() {
                if (pickListId <= 0) {
                    confirmDialog("未找到有效的组装上料清单！");
                    return false;
                }
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.PickListPullAndStop(pickListId, prodOrderId, sltStationId, sltResId, 1);
                if (ajax.error != null) {
                    confirmDialogFocus(ajax.error.Message, function () {
                        $("#txtGRN").select();
                    });
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    scanSN = "";
                    return false;
                }

                confirmDialog("完成上料成功！");
                $("#lblStatus").html("已完成上料");
                pStatus = 1;

            }

            /**
            *卸料
            */
            function unLoadMaterial() {
                if (pickListId <= 0) {
                    confirmDialog("未找到有效的组装上料清单！");
                    return false;
                }
                if (confirm("是否进行卸料操作？")) {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.PickListUnLoadMaterial(pickListId, prodOrderId, sltResId, 0);
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    scanSN = "";
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    return false;
                }
                confirmDialog("卸料执行成功！");
                pStatus = 0;
                $("#lblStatus").html("");
                }
            }

            /**
            *保存续料操作
            **/
            function saveAddMaterial() {
                if (pickListId <= 0) {
                    confirmDialog("未找到有效的组装上料清单！");
                    return false;
                }
                var curentGRN = $("#CurrentGRN").val();
                var newGRN = $("#NewGRN").val();
                if (curentGRN == "") {
                    confirmDialogFocus("请输入旧GRN", function () {
                        $("#CurrentGRN").select();
                    });
                    return false;
                }
                else if (newGRN == "") {
                    confirmDialogFocus("请输入新GRN", function () {
                        $("#NewGRN").select();
                    });
                    return false;
                }
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.PickListAddMaterial(pickListId, prodOrderId, curentGRN, newGRN, sltResId);
                if (ajax.error != null) {
                    confirmDialogFocus(ajax.error.Message, function () {
                        $("#CurrentGRN").select();
                    });
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    return false;
                }

                $("#CurrentGRN").val(newGRN);
                confirmDialogFocus("续料成功!", function () {
                    $("#NewGRN").val("").select();
                });

            }

            $("#CurrentGRN").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    var curentGRN = $("#CurrentGRN").val();
                    if (curentGRN == "") {
                        confirmDialogFocus("请输入旧GRN", function () {
                            $("#CurrentGRN").select();
                        });
                        return false;
                    }
                    else {
                        $("#NewGRN").select();
                    }
                }
            });

            $("#NewGRN").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    var newGRN = $("#NewGRN").val();
                    if (newGRN == "") {
                        confirmDialogFocus("请输入新GRN", function () {
                            $("#NewGRN").select();
                        });
                        return false;
                    }
                    else {
                        saveAddMaterial();
                    }
                }
            });

            //查询
            function Search() {
                $.mobile.changePage("#Search", { transition: 'none' });
                getPickListDetail(1, "Infotab");
            }
            
            //选择工单
            function schooseOrder() {
                $("#sOrderPanel").panel("open");
                $("#slistview").on("filterablebeforefilter", function (e, data) {
                    var $ul = $(this)
                    $input = $(data.input)
                    value = $input.val();
                    if (value && value.length > 2) {
                        var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.GetOrderList(value);
                        if (ajax.error != null) {
                            confirmDialog(ajax.error.Message);
                            //写入日志
                            SaveUserUILog(orderNo, ajax.error.Message);
                            return false;
                        }
                        var htmlstr = "";
                        var data = ajax.value;
                        $('#slistview').html('');
                        for (var i = 0; i < data.length; i++) {
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].OrderID + "' onclick=sOrderList('" + data[i].OrderID + "','" + data[i].OrderNo + "')>" + data[i].OrderNo + "</li>";
                        }
                        $("#slistview").append(htmlstr);
                        $('#slistview').listview('refresh');
                    }
                });
            }
            function sOrderList(ID, OrderNo) {
                $("#sshowOrderNo,#showOrderNo").html(OrderNo);
                prodOrderId = ID;
                sltResId = -1;
                sltStationId = -1;
                $("input[data-type='search']").val('');
                $("#sOrderPanel").panel("close");
                schooseStation();
                $("#lblHandList").html("");
                $("#lblItemCode").html("");
                $("#lblItemName").html("");
                $("#showRes,#sshowRes,#showStation,#sshowStation").html("请选择");
            }

            /**
            *加载扣料工序
            */
            function schooseStation() {
                if (prodOrderId < 0) {
                    confirmDialog("请先选择工单！");
                    schooseOrder();
                    return false;
                }

                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.GetPickListStation(prodOrderId);
                if (ajax.error != null) {
                    showAreaMessge(ajax.error.Message, "messageRed");
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    return false;
                }
                var list = (ajax.value);
                if (list.keys.length == 0) {
                    confirmDialog("未找到工单[" + $("#sshowOrderNo").text() + "]关联路由的扣料工序，请先配置扣料工序！");
                    return false;
                }
                var htmlstr = "";
                $('#slistview').html('');
                for (var i = 0 ; i < list.keys.length; i++) {
                    htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + list.keys[i] + "' onclick=sStationList('" + list.keys[i] + "')>" + list.values[i] + "</li>";
                }
                $("#slistview").append(htmlstr);
                $('#slistview').listview('refresh');
                $("#sOrderPanel").panel("open");
            }
            function sStationList(ID) {
                sltStationId = ID;
                $("#showStation,#sshowStation").html($("#" + ID).html());
                $("input[data-type='search']").val('');
                $("#sOrderPanel").panel("close");
                $("#sshowRes").html("请选择");
                sltResId = -1;
               schooseResource();
            }

            //资源
            function schooseResource() {
                if ($("#sshowOrderNo").html() == "请选择") {
                    confirmDialog("请先选择工单！");
                    schooseOrder();
                    return false;
                }
                if ($("#sshowStation").html() == "请选择") {
                    confirmDialog("请先选择工序！");
                    schooseStation();
                    return false;
                }

                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxLogin.GetResourcesByOprId(sltStationId, userName);
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    return false;
                }

                $("#sOrderPanel").panel("open");

                var htmlstr = "";
                var data = ajax.value;
                $('#slistview').html('');
                for (var i = 0; i < data.length; i++) {
                    htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].ResourceId + "' onclick=sResList('" + data[i].ResourceId + "')>" + data[i].ResName + "</li>";
                }
                $("#slistview").append(htmlstr);
                $('#slistview').listview('refresh');
            }
            function sResList(ID) {
                sltResId = ID;
                $("#showRes,#sshowRes").html($("#" + ID).html());
                $("input[data-type='search']").val('');
                $("#sOrderPanel").panel("close");
                setPickListInfo();
                getPickListDetail(1, "Infotab");
            }

            /**
            *查询上料记录
            **/
            function getPickListDetail(flage, table) {

                $("#" + table + " tbody").html("");
                if (pickListId <= 0) {
                    return false;
                }

                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPickListClient.GetPickListDetailNew(pickListId, prodOrderId, sltStationId, sltResId,flage);
                if (ajax.error != null) {
                    confirmDialogFocus(ajax.error.Message, function () {

                    });
                    //写入日志
                    SaveUserUILog(orderNo, ajax.error.Message);
                    return false;
                }
                if (ajax.value == null) {
                    return false;
                }

                var list = ajax.value;

                var htmlstr = "";
                for (var i = 0; i < list.length; i++) {
                    htmlstr += "<tr>";
                    //htmlstr += "<td>" + list[i].ProcessName + "</td>";
                    htmlstr += "<td>" + list[i].ItemCode + "</td>";
                    htmlstr += "<td>" + list[i].CPN + "</td>";
                    htmlstr += "<td>" + list[i].ItemName + "</td>";
                    htmlstr += "<td>" + list[i].RequireQty + "</td>";
                    htmlstr += "<td>" + list[i].BalanceQty + "</td>";
                    htmlstr += "</tr>";
                }
                $("#" + table + " tbody").html(htmlstr);
                $("#" + table).table("refresh");
            }

            //查询页隐藏columntoggle列表按钮
            $(document).on("pageshow", "#Search,#pageTwo", function (event) {
                $(".ui-body-c").css("background", "#fff");
                $(".ui-table-columntoggle-btn").css("display", "none");
            });

            $(document).on("pageshow", function (event) {
                var _id = location.hash;
                if (_id == "") {
                    $("#pageOne div ul li a").each(function () {
                        if ($(this).attr("href") == "#pageOne") {
                            $(this).addClass("ui-btn-active");
                            return;
                        }
                    });
                    return false;
                }
                $(_id + " div ul li a").each(function () {

                    if ($(this).attr("href") == _id) {
                        $(this).addClass("ui-btn-active");
                        return;
                    }
                })
            });

            /*
            *写入用户操作日志
            */
            function SaveUserUILog(OederNo, LogContent) {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClient.SaveUserUILog("一般", -1, -1, OederNo, LogContent);
                if (ajax.error != null) {
                    return false;
                }
            }
        </script>
    </form>
</body>
