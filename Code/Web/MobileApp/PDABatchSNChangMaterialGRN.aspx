<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="PDABatchSNChangMaterialGRN.aspx.cs" Inherits="SKT.LeanMES.Web.MobileApp.PDABatchSNChangMaterialGRN" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, minimum-scale=1, maximum-scale=1" />
    <link href="theme/flatui/jquery.mobile.flatui.min.css?v=11" rel="stylesheet" type="text/css" />
    <link href="css/common.css" rel="stylesheet" type="text/css" />
    <script src="js/jquery.min.js" type="text/javascript"></script>

    <script src="js/jquery.mobile-1.4.5.min.js" type="text/javascript"></script>
    <script src="js/Common.js" type="text/javascript"></script>
    <script src="js/skt.mobile.material.js" type="text/javascript"></script>
    <title>批次生成物料条码</title>
    <style type="text/css">
        .clear {
            clear: both;
            height: 2px;
        }

        body, label {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 13px !important;
            color: #1d1007;
        }

        table {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 12px !important;
            color: #1d1007;                                        
        }

        .clear {
            clear: both;
            height: 2px;
        }

        body, label {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 13px !important;
            color: #1d1007;
        }

        table {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 12px !important;
            color: #1d1007;
        }

        .ui-title {
            line-height: 30px;
        }

        .ui-checkbox input:disabled, .ui-radio input:disabled {
            position: absolute !important;
            height: 22px;
            width: 22px;
            overflow: hidden;
            clip: auto;
        }
    </style>
</head>
<body>
    <form runat="server" onsubmit="return false">
        <div data-role="page" class="receivepage" id="receivepage">
            <div data-role="header" data-position="fixed">
                <h5 style="padding: 4px; margin: 0px;">
                    <div>
                        <%--<img style="width: 60px; height: 50px;" src="data:image/png;base64," />--%>
                    </div>
                    <div>
                        <label style="font-size: 17px !important; font-weight: bold; color: #FFFFFF">批次生成物料条码</label>
                    </div>
                </h5>
                <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                    data-transition="none" data-ajax="false">返回</a><a href="Index.aspx" class="ui-btn-right"
                        data-icon="home" data-transition="none" data-ajax="false">主页</a>
            </div>
            <div data-role="content" id="content1">
                <table style="width: 100%">
                    <tr>
                        <td>
                            <label>扫描库位条码</label>
                        </td>
                        <td colspan="3">
                            <input type="text" name="fGRN" id="txtcBarCode" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>扫描产品条码</label>
                        </td>
                        <td colspan="3">
                            <input type="text" name="fGRN" id="txtSCANSN" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>是否入库</label>
                        </td>
                        <td>
                            <select name="slider2" id="sltIsChangeMuMap" data-role="slider" data-mini="true" onchange="ChangeMuMap(this)">
                                <option value="0">否</option>
                                <option value="1">是</option>
                            </select>
                        </td>
                        <td colspan="2" style="display: flex; font-weight: bolder;" class="allCreate">
                            <label>全部生成</br>物料条码</label><input type="checkbox" id="sltIsAll" disabled="disabled" checked="checked" />
                        </td>
                    </tr>
                </table>
                <div style="text-align: center; font-size: 14px" id="rmsg" class="msg">
                </div>
                <table data-role="table" id="NCInfo" data-mode="columntoggle" class="ui-responsive table-stroke" style="width: 100%">
                    <thead>
                        <tr>
                            <th>批次条码
                            </th>
                            <th>产品编码
                            </th>
                            <th>批次数量
                            </th>
                        </tr>
                    </thead>
                    <tr id="trNCInfo" class="ListTableOddRow">
                        <td colspan="3" style="text-align: center;">暂无数据
                        </td>
                    </tr>
                </table>
            </div>
            <div data-role="footer" data-position="fixed">
                <div data-role="navbar">
                    <ul>
                        <li><a href="#" data-transition="none" onclick="Clear()">重新扫描</a></li>
                        <li><a href="#" data-transition="none" onclick="Save()">确认</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            var userId = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserId %>";
            var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>';

            $(function () {
                $(".ui-body-c").css("background", "#fff");
                //隐藏columntoggle列表按钮
                $(".ui-table-columntoggle-btn").css("display", "none");
                $("#txtcBarCode").val("").focus();
                $(".allCreate div").removeClass("ui-state-disabled");
            });
            function ChangeMuMap(el) {
                var value = $(el).val();

                if (value==0) {
                    $("#sltIsAll").prop("checked", "checked");
                }
                else {
                    $("#sltIsAll").removeAttr("checked");
                }
                //if (value==0) {
                //    $("#sltIsAll").val(1);
                //} else {
                //    $("#sltIsAll").val(0);
                //}
            }
            //库位扫描
            $("#txtcBarCode").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    var cBarCode = $.trim($("#txtcBarCode").val());
                    if (cBarCode == "") {
                        RshowAreaMessge("请扫描库位条码", "messageRed");
                        $("#txtcBarCode").val("").focus();
                        return false;
                    }
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxMaterialIQC.GetBarCode(cBarCode);
                    if (ajax.error != null) {
                        RshowAreaMessge(ajax.error.Message, "messageRed");
                        $("#txtcBarCode").val("").focus();
                        return false;
                    }
                    var en = $.parseJSON(ajax.value);
                    if (!en.BarCode) {
                        RshowAreaMessge("库位条码不存在", "messageRed");
                        $("#txtcBarCode").val("").focus();
                        return false;
                    }
                    RshowAreaMessge("扫描库位条码成功", "messageGreen");
                    $("#txtSCANSN").val("").focus();
                }
            });

            $("#txtSCANSN").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    afterScan();
                }
            });

            var ALLSNArr = [];
            var myNCtab = document.getElementById("NCInfo");
            function afterScan() {
                if ($("#txtcBarCode").val() == "") {
                    RshowAreaMessge("请先扫描库位条码", "messageRed");
                    return false;
                }
                var mySN = $("#txtSCANSN").val();
                //判断当前不良是否已经扫描
                for (var j = 0; j < ALLSNArr.length; j++) {
                    if (ALLSNArr[j].SN == mySN) {
                        RshowAreaMessge("该批次条码已扫描，请不要重复扫描！", "messageRed");
                        $("#txtSCANSN").val("").focus();
                        return false;
                    }
                }
                var isAll = 0;
                if ($("#sltIsAll").is(':checked')) {
                    isAll = 1;
                }

                if (isAll == 1) {
                    if ($("#sltIsChangeMuMap").val() == 1) {
                        RshowAreaMessge("全部生成物料条码操作不可入库！", "messageRed");
                        $("#txtSCANSN").val("").focus();
                        return false;
                    }
                    if (ALLSNArr.length > 0) {
                        RshowAreaMessge("已经存在扫描的条码，请先操作完再后续操作！", "messageRed");
                        $("#txtSCANSN").val("").focus();
                        return false;
                    }
                    var info = { SN: mySN, ModifyBy: userName };
                    var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspPDABatchSNChangMaterialGRNSaveAll", JSON.stringify(info));
                    if (ajax.error != null) {
                        RshowAreaMessge(ajax.error.Message, "messageRed");
                        $("#txtSCANSN").val("");
                        $("#txtSCANSN").focus();
                        return false;
                    }
                    RshowAreaMessge("所有SN【" + mySN + "】产品关联的条码物料条码生成成功", "messageGreen");
                }
                else {
                    var info = { SN: mySN };
                    var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspGetBatchSNInfo", JSON.stringify(info));
                    if (ajax.error != null) {
                        RshowAreaMessge(ajax.error.Message, "messageRed");
                        $("#txtSCANSN").val("");
                        $("#txtSCANSN").focus();
                        return false;
                    }
                    var list = JSON.parse(ajax.value);
                    var listOrder = list.data;
                    var SNArr = {};
                    SNArr.SN = mySN;
                    SNArr.ItemCode = listOrder[0].ItemCode;
                    SNArr.BatchQty = listOrder[0].BatchQty;
                    ALLSNArr.push(SNArr);
                    RshowAreaMessge("SN:" + mySN + ":扫描成功", "messageGreen");
                    $("#NCInfo  tr:not(:first)").html("");
                    for (var i = 0; i < ALLSNArr.length; i++) {
                        SNaddDetail(ALLSNArr[i], i);
                    }
                }

                $("#txtSCANSN").val("");
                $("#txtSCANSN").focus();
                SNArr = {};
            }

            function SNaddDetail(entity, i) {
                if (entity == null) {
                    return;
                }
                i += 1;
                $("#trNcInfo").remove();
                var row, cell;
                rowNewIdx = myNCtab.rows.length;
                row = myNCtab.insertRow(rowNewIdx);
                row.className = "ListTableOddRow";

                cell = row.insertCell(0);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = entity.SN;

                cell = row.insertCell(1);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = entity.ItemCode;

                cell = row.insertCell(2);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = parseFloat(entity.BatchQty);

            }

            /*
            *写入用户操作日志
            */
            function SaveUserUILog(OederNo, LogContent) {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClient.SaveUserUILog("一般", -1, -1, OederNo, LogContent);
                if (ajax.error != null) {
                    return false;
                }
            }

            //显示消息
            function RshowAreaMessge(msg, type) {
                $("#rmsg").html(msg).css("color", type == "messageGreen" ? "#99FF33" : "#ff0000");
            }

            function Save() {
                if ($("#txtcBarCode").val() == "") {
                    RshowAreaMessge("请先扫描库位条码", "messageRed");
                    return false;
                }
                if (ALLSNArr.length == 0) {
                    RshowAreaMessge("请扫描批次条码！", "messageRed");
                    $("#txtSCANSN").val("").focus();
                    return false;
                }
                var AllSN = "";
                for (var i = 0; i < ALLSNArr.length; i++) {
                    AllSN += ALLSNArr[i].SN + ",";
                }
                var info = { SN: AllSN, cBarCode: $("#txtcBarCode").val(), ModifyBy: userName, Warehousing: $("#sltIsChangeMuMap").val() };
                var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspPDABatchSNChangMaterialGRNSave", JSON.stringify(info));
                if (ajax.error != null) {
                    RshowAreaMessge(ajax.error.Message, "messageRed");
                    $("#txtSCANSN").val("");
                    $("#txtSCANSN").focus();
                    return false;
                }
                RshowAreaMessge("物料条码生成成功", "messageGreen");
                Clear();
            }

            function Clear() {
                $("#NCInfo  tr:not(:first)").html("");
                $("#txtcBarCode").val("").select().focus();
                $("#txtSCANSN").val("");
                ALLSNArr = [];
            }

        </script>
    </form>
</body>
