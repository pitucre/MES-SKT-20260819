        <script type="text/javascript">

            var userName = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>";
            var materialId = ""; //物料id集合
            var BarCodestr = ""; //库位id集合
            var regExpress = "";
            var stationId;
            var viewModel = { listItemCode: [] };     //页面共享数据
            $(document).ready(function () {
                //隐藏columntoggle列表按钮
                $(".ui-table-columntoggle-btn").css("display", "none");
                $("#txtCustomer").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC") });
                $("#txtSN").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC") }).focus();



                //扫描sn
                $("#txtCustomer").on("keydown", function (e) {
                    var curKey = 0, e = e || window.event;
                    curKey = e.keyCode || e.which || e.charCode;
                    if (curKey == 13) {

                        var txtCustomer = $("#txtCustomer").val();
                        if ($("#txtCustomer").val() == "") {
                            $("#msg").html("客户条码不能为空！").css("color", "red");
                            $("#txtCustomer").focus();
                            return false;
                        }

                        if (regExpress != "" && txtCustomer != "") {
                            var regular = regExpress;
                            var regularArr = regular.split(';');
                            var reg;
                            if (regularArr != undefined && regularArr.length > 0) {
                                for (var i = 0; i < regularArr.length; i++) {
                                    reg = new RegExp(regularArr[i]);
                                    if (!reg.test(txtCustomer)) {
                                        var errmsg = txtCustomer + ":客户条码不符合系统设定的验证规则！";
                                        $("#msg").html(errmsg).css("color", "red");
                                        $("#txtCustomer").select();
                                        return false;
                                    }
                                }
                            }
                        }

                        var entity = {};
                        entity.SN = $("#txtSN").val();
                        entity.CustomerSN = txtCustomer;
                        entity.UserId =<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserId%>
                        var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspCustomerBindSN", JSON.stringify(entity));
                        if (ajax.error != null) {
                            $("#msg").html(ajax.error.Message).css("color", "red");
                            $("#txtCustomer").val("").focus();
                            return false;
                        }
                        $("#msg").html("客户条码绑定成功！").css("color", "#2ecc71");
                        $("#txtCustomer").val("");
                        $("#txtSN").val("").select();
                    }
                });

                $("#txtSN").on("keydown", function (e) {
                    var curKey = 0, e = e || window.event;
                    curKey = e.keyCode || e.which || e.charCode;
                    if (curKey == 13) {
                        $("#msg").html('');
                        if ($("#txtSN").val() == "") {
                            $("#msg").html("成品条码不能为空！").css("color", "red");
                            $("#txtSN").focus();
                            return false;
                        }
                        var entity = {};
                        entity.SN = $("#txtSN").val();
                        var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspCheckCustomerBindSN", JSON.stringify(entity));
                        if (ajax.error != null) {
                            $("#msg").html(ajax.error.Message).css("color", "red");
                            $("#txtSN").val("").focus();
                            return false;
                        }
                        regExpress = $.parseJSON(ajax.value).data[0].RegExpress;
                        $("#txtCustomer").focus();
                    }
                });
            });
 
            function rtrim(str) { //删除右边的_
                return str.replace(/_$/g, "");
            }

        </script>
