<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MobileMaster.master.cs"
    Inherits="SKT.LeanMES.Web.MobileApp.MobileMaster" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, minimum-scale=1, maximum-scale=1"/>
    <link href="theme/flatui/jquery.mobile.flatui.min.css?v=11" rel="stylesheet" type="text/css" />
    <link href="css/common.css" rel="stylesheet" type="text/css" />
    <script src="js/jquery.min.js" type="text/javascript"></script>
    <script src="js/jquery.mobile-1.4.5.min.js" type="text/javascript"></script>
    <script src="js/Common.js" type="text/javascript"></script>
    <title>深科特LeanMES移动客户端</title>
    <style type="text/css">
     html,body{ font-size:100%;font-family: Verdana Arial Microsoft YaHei UI; font-weight:normal;}
        .ui-collapsible-heading
        {
            border-bottom: 1px solid #d3d3d3;
        }
        .ui-header .ui-title, .ui-footer .ui-title
        {
            font-size: 1em;
            min-height: 1em;
            text-align: center;
            display: block;
            margin: 0 30%;
            padding: .1em 0;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
            outline: 0 !important;
        }
        #header .ui-btn-corner-all, .ui-btn.ui-corner-all, .ui-slider-track.ui-corner-all, .ui-flipswitch.ui-corner-all, .ui-li-count{margin-top: -0.1em;}
         
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
     <div data-role="page" id="home">
        <div data-role="header" id="header" data-position="fixed" style="padding-top:9px;padding-bottom:9px">
            <h1>
                <img src="images/NEW/images/logo.png" style="width:135px;height:25px" />
            </h1>
            <a href="" id="backlabel" data-rel="back" class="ui-btn-left" data-icon="arrow-l" data-transition="none">返回</a>
            <a href="#" id="rightbtn" class="ui-btn-right"></a>
        </div>
        <div data-role="content" id="main">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </div>
    <script type="text/javascript">
        $(document).bind("mobileinit", function () {
            // jQuery Mobile's Ajax navigation does not work in all cases (e.g.,
            // when navigating from a mobile to a non-mobile page), especially when going back, hence disabling it.
            $.mobile.ajaxEnabled = false;
        });
    </script>
 </body>
</html>
