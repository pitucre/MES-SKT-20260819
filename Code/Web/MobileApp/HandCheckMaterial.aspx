</head>
<body>
    <div data-role="page" id="pageOne">
        <div data-role="header" id="header" data-position="fixed">
            <h5 style="padding: 4px; margin: 0px;">
            <%--    <div>
                    <img style="width: 60px; height: 50px;" src="data:image/png;base64," />
                </div>
                <div>
                    手插上料</div>--%>
                  <div>
                        <label style="font-size: 17px !important; font-weight: bold; color: #FFFFFF">手插上料</label>
                    </div>
            </h5>
             <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                    data-transition="none" data-ajax="false">返回</a> 
            <div data-role="navbar" data-theme="c">
                <ul>
                    <li><a href="#" data-transition="none" data-theme="c">设置</a></li>
                    <li><a href="#pageTwo" data-transition="none" data-theme="c">上料</a></li>
                    <li><a href="#AddMaterial" data-transition="none" data-theme="c">续料</a></li>
                    <li><a href="#" data-transition="none" data-theme="c" onclick="Search()">查询</a></li>
                </ul>
            </div>
        </div>
        <div data-role="content">
            <div data-role="fieldcontain">
                <label for="fline">
                    线别</label>
                <a href="ChooseLineAndRes.aspx?checkMType=2" data-transition="none" data-role="button"
                    data-ajax="false" id="showLine" data-theme="c">请选择</a>
                <div class="clear">
                </div>
                <label for="fRes">
                    资源</label>
                <a data-transition="none" data-role="button" onclick="chooseRes(1);" data-ajax="false"
                    id="showRes" data-theme="c">请选择</a>
                <div class="clear">
                </div>
                <label for="fOrderNo">
                    选择工单</label>
                <a href="#" data-transition="none" data-role="button" onclick="chooseRes(2);" data-ajax="false"
                    id="showOrderNo" data-theme="c">请选择</a>
                <div class="clear">
                </div>
                <div id="setUpLine" style="display: none;">
                    <label for="fItemCode">
                        产品代码</label>
                    <span id="lblItemCode"></span>
                    <label>
                        产品名称</label>
                    <span id="lblItemName"></span>
                    <label for="fHandList">
                        当前上料清单</label>
                    <span id="lblHandList"></span>
                </div>
            </div>
        </div>
        <div data-role="footer" data-position="fixed">
            <div data-role="navbar">
                <ul>
                    <li><a href="#" data-transition="none" onclick="HandOpenOrStop(1);" style="background-color: Gray">
                        开拉</a></li>
                    <li><a href="#" data-transition="none" onclick="HandOpenOrStop(2);" style="background-color: Red">
                        停拉</a></li>
                    <li><a href="#" data-transition="none" onclick="HandUnLoad();" style="background-color: Orange">
                        卸料</a></li>
                    <li><a href="#" data-transition="none" onclick="setUpLine();" style="background-color: GrayText">
                        下一步</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div data-role="page" id="pageTwo">
        <div data-role="header" data-position="fixed">
            <h5 style="padding: 4px; margin: 0px;">
                <div>
                    <img style="width: 60px; height: 50px;" src="data:image/png;base64," />
                </div>
                <div>
                    手插上料</div>
            </h5>
            <a data-iconpos="left" href="Index.aspx" data-transition="none" data-role="button"
                data-ajax="false" data-icon="back">返回</a> 

            <div data-role="navbar" data-theme="c">
                <ul>
                    <li><a href="#pageOne" data-transition="none" data-theme="c">设置</a></li>
                    <li><a href="#" data-transition="none" data-theme="c">上料</a></li>
                    <li><a href="#AddMaterial" data-transition="none" data-theme="c">续料</a></li>
                    <li><a href="#" data-transition="none" data-theme="c" onclick="Search()">查询</a></li>
                </ul>
            </div>
        </div>
        <div data-role="content">
            <div data-role="fieldcontain">
                <div>
                    <label for="fGRN">
                        GRN</label>
                    <input type="text" name="fGRN" id="txtGRN">
                </div>
                <label for="fLocation">
                    选择位置</label>
                <select name="fLocation" id="fLocation" data-theme="c">
                </select>
                <div style="display: none" id="showCheck">
                    <label for="fItemCode">
                        物料代码</label>
                    <span id="lblMItemCode"></span>
                    <label>
                        数量</label>
                    <span id="lblQty"></span>
                    <label for="lblMItemName">
                        物料名称</label>
                    <span id="lblMItemName"></span>
                </div>
                <label id="showMaterialMsg">
                </label>
            </div>
        </div>
        <div data-role="footer" data-position="fixed">
            <a href="#" data-role="button" style="width: 100%; margin-top: 0px; margin-bottom: 0px;"
                data-inline="true" data-theme="a" onclick="saveHandMaterial();">检验匹配</a>
        </div>
    </div>
    <div data-role="page" id="AddMaterial">
        <div data-role="header" data-position="fixed">
            <h5 style="padding: 4px; margin: 0px;">
                <div>
                    <img style="width: 60px; height: 50px;" src="data:image/png;base64," />
                </div>
                <div>
                    手插上料</div>
            </h5>
            <a data-iconpos="left" href="Index.aspx" data-transition="none" data-role="button"
                data-ajax="false" data-icon="back">返回</a> 

            <div data-role="navbar">
                <ul>
                    <li><a href="#pageOne" data-transition="none" data-theme="c">设置</a></li>
                    <li><a href="#pageTwo" data-transition="none" data-theme="c">上料</a></li>
                    <li><a href="#" data-transition="none" data-theme="c">续料</a></li>
                    <li><a href="#" data-transition="none" onclick="Search()" data-theme="c">查询</a></li>
                </ul>
            </div>
        </div>
        <div data-role="content">
            <div data-role="fieldcontain">
                <label for="fGRN">
                    旧GRN</label>
                <input type="text" name="fGRN" id="txtOldGRN" onkeydown="enterkey(event,'txtNewGRN')">
                <label for="fLocation">
                    选择位置</label>
                <select name="fLocation" id="AddLocation" data-theme="c">
                </select>
                <label for="fItemCode">
                    旧料代码</label>
                <span id="lblAddItemCode"></span>
                <label for="fGRN">
                    新GRN</label>
                <input type="text" name="fGRN" id="txtNewGRN">
                <label>
                    数量</label>
                <span id="lblNewQty"></span>
                <label for="lblNewItemCode">
                    新料代码</label>
                <span id="lblNewItemCode" name="lblNewItemCode"></span>
                <label id="HAddMaterial">
                </label>
            </div>
        </div>
        <div data-role="footer" data-position="fixed">
            <a href="#" data-role="button" style="width: 100%; margin-top: 0px; margin-bottom: 0px;"
                data-inline="true" data-theme="a" onclick="AddMaterial();">续 料</a>
        </div>
    </div>
    <div data-role="page" id="Search">
        <div data-role="header" data-position="fixed">
            <h5 style="padding: 4px; margin: 0px;">
                <div>
                    <img style="width: 60px; height: 50px;" src="data:image/png;base64," />
                </div>
                <div>
                    手插上料</div>
            </h5>
            <a data-iconpos="left" href="Index.aspx" data-transition="none" data-role="button"
                data-ajax="false" data-icon="back">返回</a>
            <div data-role="navbar">
                <ul>
                    <li><a href="#pageOne" data-transition="none" data-theme="c">设置</a></li>
                    <li><a href="#pageTwo" data-transition="none" data-theme="c">上料</a></li>
                    <li><a href="#AddMaterial" data-transition="none" data-theme="c">续料</a></li>
                    <li><a href="#" data-transition="none" data-theme="c" onclick="Search();">查询</a></li>
                </ul>
            </div>
        </div>
        <div data-role="content">
            <div id="showPickList">
            </div>
        </div>
        <div data-role="footer" data-position="fixed">
        </div>
    </div>
    <script type="text/javascript">
        $(document).bind("mobileinit", function () {
            $.mobile.ajaxEnabled = false;
        });

        var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>';
        var lineId = -1;  //选择的线别
        var resId = -1;   //选择的资源
        var prodOrderId = -1; //选择的工单
        var pickListId = -1;  //手插清单id
        var pickListName = "";
        var lineName = "";
        var resName = "";
        var orderNo = "";
        $(function () {
            var checkType = GetQueryString("checkType");  //1:已经存在相关数据  2.不存
            if (checkType == 2) { //已经存在
                IsShowLineAndRes();
            }
            else {
                lineId = GetQueryString("lineId");
                resId = GetQueryString("resId");
                lineName = decodeURI(GetQueryString("lineName"));
                resName = decodeURI(GetQueryString("resName"));
                $("#showLine").html(lineName);
                $("#showRes").html(resName);
                if (checkType == 3) {
                    prodOrderId = GetQueryString("prodOrderId");
                    orderNo = decodeURI(GetQueryString("orderNo"));
                    $("#showOrderNo").html(orderNo);
                    showItemInfo();
                }
            }
        });

        function chooseRes(hrefType) {
            if (hrefType == 1) {
                window.location.href = "ResourceList.aspx?checkMType=2&lineId=" + lineId + "";
            } else if (hrefType == 2) {
                //传入lineId,LineName,ResId,ResName
                window.location.href = "ProdOrderList.aspx?" + encodeURI("checkMType=2&lineId=" + lineId + "&resId=" + resId + "&lineName=" + lineName + "&resName=" + resName + "") + "";
            }
        }

        function enterkey(e, nextScanText) {
            if (e.keyCode == 13) {
                $("#" + nextScanText + "").focus();
                $("#" + nextScanText + "").select();
            }
        }

        function Search() {
            $.mobile.changePage("#Search", { transition: 'none' });
            showPickList();
        }

        $(document).on("pageinit", function () {
            bindOrder();
        });

        //重新加载绑定数据
        function IsShowLineAndRes() {
            $.ajax({
                type: "POST",
                url: "../Handler/ChooseLineAndRes.ashx?type=showHandMaterial",
                async: false,
                dataType: "json",
                data: { "loadMateriakType": 2, "userName": userName },
                success: function (data) {
                    if (data != null) {
                        $("#lblHandList").html(data.ListName);
                        $("#showOrderNo").html(data.OrderNo);
                        $("#showLine").html(data.LineName);
                        $("#showRes").html(data.ResName);
                        prodOrderId = data.ProdOrderID;
                        $("#lblItemCode").html(data.ItemCode);
                        $("#lblItemName").html(data.ItemName);
                        pickListId = data.ListID;
                        lineId = data.LineID;
                        resId = data.ResId;
                        lineName = data.LineName;
                        resName = data.ResName;
                        pickListName = data.ListName;
                        $("#setUpLine").show();
                    }
                },
                error: function (err) {
                    if (err.responseText != "") {
                        $.mobile.changePage('ChooseLineAndRes.aspx');

                    }
                }
            });
        }

        //根据工单选择数据
        function showItemInfo() {
            $.ajax({
                type: "POST",
                url: "../Handler/ChooseLineAndRes.ashx?type=showItem",
                async: false,
                dataType: "json",
                data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "checkMType": 2 },
                success: function (data) {
                    $("#lblItemCode").html(data.ItemCode);
                    $("#lblHandList").html(data.ListName);
                    $("#lblItemName").html(data.ItemName);
                    pickListId = data.ListID;
                    pickListName = data.ListName;
                },
                error: function (err) {
                    $("#showOrderNo").html("请选择");
                    alert(err.responseText);
                    return false;
                }
            });
        }


        //绑定工单
        function bindOrder() {
            $("#selectOrderNo").html("");
            var ret = AjaxRequestByUrl("../Handler/ChooseLineAndRes.ashx?type=OrderNo");
            if (ret != "") {
                $("#selectOrderNo").append(ret);
            }
            else {
                $("#selectOrderNo").append("暂无数据");
            }
        }

        function GetQueryString(name) {
            var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
            var r = window.location.search.substr(1).match(reg);
            if (r != null) return r[2]; return null;
        }
        //线别设置
        function setUpLine() {
            if (pickListId == -1) {
                confirmDialog("请先选择上料清单!", null);
                return false;
            }

            confirmDialog("该工单可能正在上料验证,确定线别设置", function () {
                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=setUpLine",
                    async: false,
                    dataType: "text",
                    data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "userName": userName },
                    success: function (data) {
                        if (data == "") {
                            confirmDialog("线别设置成功，执行下一步操作!", null);
                            //调转到
                            //调转到,防止闪屏
                            $.mobile.changePage("#pageTwo", { transition: 'none' });
                        }
                        else {
                            confirmDialog(data, null);

                        }
                    },
                    error: function (err) {
                        return false;
                    }
                });

            });
        }

        //上料验证GRN
        var scanGRN = "";
        $("#txtGRN").keydown(function (e) {
            if (e.keyCode == 13) {
                //执行回车事件
                if (pickListId == -1) {
                    confirmDialog("请先进行线别设置!", null);
                    // $.mobile.changePage("#pageOne", { transition: "none" });
                    return false;
                }
                scanGRN = $("#txtGRN").val();

                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=checkHandMaterial",
                    async: false,
                    dataType: "json",
                    data: { "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "grn": scanGRN },
                    success: function (data) {
                        $("#lblMItemCode").html(data.ItemCode);
                        $("#lblQty").html(data.BalanceQty);
                        $("#lblMItemName").html(data.ItemName);
                        bingGrn(data.LocationStr, "fLocation");
                        $("#showCheck").show();
                    },
                    error: function (err) {
                        //报错
                        confirmDialog("GRN信息与手插清单不匹配!", null);
                        return false;
                    }
                });
            }
        });

        //绑定GRN位置
        function bingGrn(locationStr, selectId) {
            $("#" + selectId + "").html("");
            var location = locationStr.split(',');
            var html = "";
            for (var i = 0; i < location.length; i++) {
                html += "<option  id =" + i + " value =" + location[i] + ">" + location[i] + "</option>";
            }
            $("#" + selectId + "").append(html);
            $("#" + selectId + "").selectmenu('refresh', true); //
        }

        //上料验证
        function saveHandMaterial() {
            var location = $("#fLocation").val();
            var grn = $("#txtGRN").val();
            $.ajax({
                type: "POST",
                url: "../Handler/ChooseLineAndRes.ashx?type=saveHandMaterial",
                async: false,
                dataType: "json",
                data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "grn": scanGRN, "location": location, "userName": userName },
                success: function (data) {

                },
                error: function (err) {
                    //报错
                    if (err.responseText == "") {
                        $("#showMaterialMsg").html(grn + "检验成功,请进行下一物料");
                        //清空数据
                        $("#showCheck").hide();
                        clearInputInfo("txtGRN", 1);
                        clearInputInfo("lblQty", 2);
                        clearInputInfo("lblMItemName", 2);
                        clearInputInfo("lblMItemCode", 2);
                        clearInputInfo("fLocation", 3);
                    } else {
                        confirmDialog("验证失败!" + err.responseText, null);
                        $("#showCheck").hide();
                        clearInputInfo("txtGRN", 1);
                        clearInputInfo("lblQty", 2);
                        clearInputInfo("lblMItemName", 2);
                        clearInputInfo("lblMItemCode", 2);
                        clearInputInfo("fLocation", 3);
                        return false;
                    }
                }
            });
        }


        //扫描旧GRN
        $("#txtOldGRN").keydown(function (e) {
            if (e.keyCode == 13) {
                //执行回车事件
                scanGRN = $("#txtOldGRN").val();
                if (scanGRN == "") {
                    confirmDialog("请扫描旧GRN", null);
                    clearInputInfo("txtOldGRN", 1);
                }
                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=checkAddMaterial",
                    async: false,
                    dataType: "json",
                    data: { "grn": scanGRN, "checkType": 1 },
                    success: function (data) {
                        $("#lblAddItemCode").html(data.ItemCode);
                        bingGrn(data.LocationStr, "AddLocation");
                    },
                    error: function (err) {
                        //报错
                        confirmDialog(err.responseText, null);
                        clearInputInfo("txtOldGRN", 1);
                    }
                });
            }
        });

        //扫描新GRN
        $("#txtNewGRN").keydown(function (e) {
            if (e.keyCode == 13) {
                //执行回车事件
                scanGRN = $("#txtNewGRN").val();
                if (scanGRN == "") {
                    confirmDialog("请扫描新GRN", null);
                    $("#txtNewGRN").focus();
                    $("#txtNewGRN").select();
                }
                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=checkAddMaterial",
                    async: false,
                    dataType: "json",
                    data: { "grn": scanGRN, "checkType": 2 },
                    success: function (data) {
                        $("#lblNewItemCode").html(data.ItemCode);
                        $("#lblNewQty").html(data.BalanceQty);
                    },
                    error: function (err) {
                        //报错
                        confirmDialog(err.responseText, null);
                        clearInputInfo("txtNewGRN", 1);
                        return false;
                    }
                });
            }
        });

        //续料检验
        function AddMaterial() {
            var oldGRN = $("#txtOldGRN").val();
            var newGRN = $("#txtNewGRN").val();
            var location = $("#AddLocation").val();
            $.ajax({
                type: "POST",
                url: "../Handler/ChooseLineAndRes.ashx?type=saveAddMaterial",
                async: false,
                dataType: "json",
                data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "oldGRN": oldGRN, "newGRN": newGRN, "userName": userName, "location": location },
                success: function (data) {

                },
                error: function (err) {
                    //报错
                    if (err.responseText == "") {
                        $("#HAddMaterial").html(newGRN + "续料成功,请扫描下一物料");
                        clearInputInfo("txtOldGRN", 1);
                        clearInputInfo("txtNewGRN", 1);
                        clearInputInfo("lblAddItemCode", 2);
                        clearInputInfo("lblNewQty", 2);
                        clearInputInfo("lblNewItemCode", 2);
                        clearInputInfo("AddLocation", 3);
                    }
                    else {
                        confirmDialog(err.responseText, null);
                        clearInputInfo("txtOldGRN", 1);
                        clearInputInfo("txtNewGRN", 1);
                        clearInputInfo("lblAddItemCode", 2);
                        clearInputInfo("lblNewQty", 2);
                        clearInputInfo("lblNewItemCode", 2);
                        clearInputInfo("AddLocation", 3);
                        return false;
                    }
                }
            });
        }

        //执行开拉，停拉动作
        function HandOpenOrStop(execType) {
            //execType  1:开拉  2：停拉
            var message = "";
            if (execType == 1) {
                message = "确认开拉?";
            }
            else {
                message = "确定停拉吗?";
            }

            confirmDialog(message, function () {
                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=pullAndStop",
                    async: false,
                    dataType: "text",
                    data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "flage": execType, "userName": userName },
                    success: function (data) {
                        if (data == "") {
                            if (execType == 1) {
                                confirmDialog("产线开拉执行成功!", null);
                            } else {
                                confirmDialog("产线停拉执行成功!", null);
                            }
                        }
                        else {
                            confirmDialog(data, null);
                        }
                    },
                    error: function (err) {
                        return;
                    }
                });
            });
        }

        //卸料动作
        function HandUnLoad() {
            confirmDialog("确定卸料吗", function () {
                $.ajax({
                    type: "POST",
                    url: "../Handler/ChooseLineAndRes.ashx?type=unloadMaterial",
                    async: false,
                    dataType: "text",
                    data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId, "userName": userName },
                    success: function (data) {
                        if (data == "") {
                            confirmDialog("卸料成功!", null);
                        }
                        else {
                            confirmDialog(data, null);
                        }
                    },
                    error: function (err) {
                        //报错
                        return;
                    }
                });
            });
        }

        //查询PickList信息
        function showPickList() {
            $("#showPickList").html("");
            $.ajax({
                type: "POST",
                url: "../Handler/ChooseLineAndRes.ashx?type=searchPickList",
                async: false,
                dataType: "json",
                data: { "lineId": lineId, "resId": resId, "prodOrderId": prodOrderId, "pickListId": pickListId },
                success: function (data) {
                    var html = "";
                    var obj = eval(data);
                    html += "<h3>手插清单：" + pickListName + "</h3>";
                    $(obj).each(function (index) {
                        var val = obj[index];
                        //显示信息
                        html += "<div style='border-bottom-width: 2px; border-bottom-style:solid'>";
                        html += " <label >产品料号</label><span >" + val.ItemCode + "</span>";
                        html += " <label >产品名称</label><span >" + val.ItemName + "</span>";
                        html += " <label >需求数量</label><span >" + val.NeedQty + "</span>";
                        html += " <label >已上数量</label><span >" + val.AlreadyQty + "</span>";
                        html += " <label >已上GRN</label><span >" + val.GrnStr + "</span>";
                        html += "</div>";
                    });
                    $("#showPickList").html(html);
                },
                error: function (err) {
                    return;
                }
            });

        }

        //清空指定数据
        function clearInputInfo(scanInputId, scanType) {
            if (scanType == 1) {
                $("#" + scanInputId + "").val("");
                $("#" + scanInputId + "").select();
                $("#" + scanInputId + "").focus();
            } else if (scanType == 2) {
                $("#" + scanInputId + "").html("");
            } else if (scanType == 3) {
                $("#" + scanInputId + "").html("");
                $("#" + scanInputId + "").selectmenu("refresh", true);
            }
        }

       
    </script>
</body>
