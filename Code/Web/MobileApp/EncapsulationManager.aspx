<body>
    <form id="form1" runat="server" onsubmit="return false;">
        <div data-role="page" data-url="setpage" class="setpage" id="setpage">
            <div data-role="header" data-position="fixed">
                <h5 style="padding: 4px; margin: 0px;">
             <%--       <div>
                        <img src="images/icon/fp_white.png" />
                        <img style="width: 60px; height: 50px;" src="data:image/png;base64," />
                    </div>
                    <div>
                        封装管理
                    </div>--%>
                    
                      <div>
                        <label style="font-size: 17px !important; font-weight: bold; color: #FFFFFF">封装管理</label>
                    </div>
                </h5>
                <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                    data-transition="none" data-ajax="false">返回</a> <a href="Index.aspx" class="ui-btn-right"
                        data-icon="home" data-transition="none" data-ajax="false">主页</a>
            </div>
            <div data-role="content">
                <table style="width: 100%">
                    <tr>
                        <td>
                            <label for="warehouse">
                                </label>
                        </td>
                        <td>
                          <%--  <asp:RadioButtonList ID="rblEncapsulationType" runat="server" RepeatDirection="Horizontal"
                                CssClass="rbl" CellSpacing="0" CellPadding="0">
                                <asp:ListItem Selected="True" Text="开封" Value="1" ></asp:ListItem>
                                <asp:ListItem Text="封装" Value="2" ></asp:ListItem>
                            </asp:RadioButtonList>--%>
                              <select name="rblEncapsulationType"  data-mini="true" id="rblEncapsulationType" data-role="slider">
                                    <option value="2" >封装</option>
                                    <option value="1">开封</option>
                                </select>
                        </td>
                    </tr>
                    <tr>
                        <td class="Label3">
                            <label for="orders">
                                扫描GRN:</label></td>
                        <td class="Field3">
                            <input type="text" id="txtGRN" class="TextBox" /><label id="labTxt" ></label>
                        </td>
                    </tr>
                </table>
                <div id="msg" style="text-align: center; font-size: 14px">
                </div>
                <table id="infotab" data-role='table' data-mode='columntoggle' class='ui-responsive table-stroke' style='width: 100%'>
                    <thead>
                     <tr id="hidGrntr" style="display: none;">
                            <td class="Label3">
                                <label for="wlbm">GRN:</label></td>
                            <td class="Field3">
                                <label id="lblGrn" style="float: left;">GRN.Eimy170921000003 </label> <label id="lblIsOk" style="text-align: right; color: green;width: 250px;">OK</label>
                            </td>
                        </tr>
                        <tr>
                            <td class="Label3">
                                <label for="wlbm">物料编码:</label></td>
                            <td >
                                <label id="lblMaterielCode"></label>
                            </td>
                        </tr>
                        <tr>
                            <td class="Label3">
                                <label for="wlbm">物料规格:</label></td>
                            <td>
                                <label id="lblMaterielSpec"></label>
                            </td>
                        </tr>
                        <tr>
                            <td class="Label3">
                                <label for="wlbm">湿度等级:</label></td>
                            <td>
                                <label id="lblMsdLevel"></label>
                            </td>

                        </tr>
                        <tr>

                            <td class="Label3">
                                <label for="wlbm">烘烤次数:</label></td>
                            <td>
                                <label id="lblBackCount"></label>
                            </td>
                        </tr>
                        <tr>
                            <td class="Label3">
                                <label for="wlbm">
                                    允许暴露时长:</label></td>
                            <td>
                                <label id="lblAllowExposeHours"></label>
                            </td>

                        </tr>
                        <tr>

                            <td class="Label3">
                                <label for="wlbm">
                                    已暴露时长:</label></td>
                            <td>
                                <label id="lblAlreadExposeHours"></label>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <script type="text/javascript">
            var CheckListNo;//
            var userName = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>";
            var CheckDifferenceListss = [];
            $('#setpage').on('pagecreate', function (event) {
                 //隐藏columntoggle列表按钮
                $(".ui-table-columntoggle-btn").css("display", "none");
            });
            $(function () {
                //隐藏columntoggle列表按钮
                $(".ui-table-columntoggle-btn").css("display", "none");
                $("#txtGRN").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC") }).focus();
           
                $("#rblEncapsulationType").change(function () {
               
                    $("#labTxt").text("");
                });
            });
       
            $("#txtGRN").on("keydown", function (e) {
            
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    var grn = $("#txtGRN").val();
                    $("#hidGrntr").css("display","none");
                    var type =$("#rblEncapsulationType :checked").val();
                   
                
                    var result = SKT.LeanMES.Web.AjaxServices.AjaxMaterial.GetMateriaStatus(grn);
                    if (result.error != null) {
                        $("#labTxt").text(result.error.Message);
                        $("#labTxt").css("color", "red");

                        return;
                    }

                    if (result.value == "11") {
                       
                        $("#labTxt").text('物料已报废！');
                        $("#labTxt").css("color", "red");
                        return ;
                    }

  
                    if (type == 1) {
                        var ajax = SKT.LeanMES.Web.MobileApp.EncapsulationManager.OpenSeal(grn);
                        if (ajax.error != null) {
                            $("#labTxt").text(ajax.error.Message);
                            $("#labTxt").css("color", "red");
                            $("#txtGRN").select();
                            ClearData();
                            return;
                        }
                     $("#hidGrntr").css("display","");
                     $("#lblGrn").text(grn);
                        $("#lblIsOk").text("开封成功");
                    }else if (type == 2) {
                        var ajax = SKT.LeanMES.Web.MobileApp.EncapsulationManager.Encapsulation(grn);
                        if (ajax.error != null) {
                            $("#labTxt").text(ajax.error.Message);
                            $("#labTxt").css("color", "red");
                            $("#txtGRN").select();
                            ClearData();
                            return;
                        }
                     $("#hidGrntr").css("display","");
                     $("#lblGrn").text(grn);
                     $("#lblIsOk").text("封装成功");
                    }
                    var ajax = SKT.LeanMES.Web.MobileApp.EncapsulationManager.GetInfo(grn);

                    if (ajax.error != null) {
                        return;
                    }
                    var entity = ajax.value;
                    LoadData(entity);
                    $("#labTxt").text("");
                    $("#txtGRN").val("");
              
                   
                   
                }
            });

            function ClearData() {
                   $("#lblMaterielCode").text('');
                     $("#lblMaterielSpec").text('');
                     $("#lblMsdLevel").text('');
                     $("#lblBackCount").text('');
                     $("#lblAllowExposeHours").text('');
                     $("#lblAlreadExposeHours").text('');
            }


            function LoadData(entity) {
                   $("#lblMaterielCode").text(entity.ItemCode);
                     $("#lblMaterielSpec").text(entity.ItemSpec);
                     $("#lblMsdLevel").text(entity.Msl);
                     $("#lblBackCount").text(entity.BakeCount);
                     $("#lblAllowExposeHours").text(entity.FloorLife);
                     $("#lblAlreadExposeHours").text(entity.TotalExposeMinute);
            }
    

        </script>
    </form>
</body>
