<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="MoveLocation.aspx.cs" Inherits="SKT.LeanMES.Web.MobileApp.MoveLocation" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, minimum-scale=1, maximum-scale=1" />
    <link href="theme/flatui/jquery.mobile.flatui.min.css?v=11" rel="stylesheet" type="text/css" />
    <link href="css/common.css" rel="stylesheet" type="text/css" />
    <script src="js/jquery.min.js" type="text/javascript"></script>
    <script src="js/jquery.mobile-1.4.5.min.js" type="text/javascript"></script>
    <script src="js/Common.js" type="text/javascript"></script>
    <script src="js/skt.mobile.material.js" type="text/javascript"></script>
    <title>物料库位转移</title>
    <style type="text/css">
        body, label {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 13px !important;
            color: #1d1007;
        }

        table {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 12px !important;
            color: #1d1007;
        }    .ui-title {
            line-height: 30px;
            
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div data-role="page" class="receivepage" id="receivepage">
            <div data-role="header" data-position="fixed" style="position:fixed">
                <h5 style="padding: 4px; margin: 0px;">
               <%--     <div>
                        <img src="images/icon/tra_white.png"/>
                        <img style="width: 60px; height: 50px;" src="data:image/png;base64," />
                    </div>
                    <div>
                        库位转移
                    </div>--%>
                       <div>
                        <label style="font-size: 17px !important; font-weight: bold; color: #FFFFFF">物料库位转移</label>
                    </div>
                </h5>
                <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                    data-transition="none" data-ajax="false">返回</a> <a href="Index.aspx" class="ui-btn-right"
                        data-icon="home" data-transition="none" data-ajax="false">主页</a>
            </div>
            <div data-role="content" id="content1">
                <table style="width: 100%">
                    <tr>
                            <td>
                                <label>
                                    库位条码</label>
                            </td>
                            <td>
                                <input id="stationid" />
                            </td>
                        </tr>
                    <tr>
                            <td>
                                <label>
                                    扫描条码</label>
                            </td>
                            <td>
                                <input id="materialcode" />
                            </td>
                    </tr>
                </table>
                <div id="msg" style="text-align: center;">
                </div>
                <div style="margin-top:5px">
                    <strong>待转移GRN</strong>
                    <table data-role="table" id="materialtb" data-mode="reflow" class="ui-responsive table-stroke"
                        style="width: 100%">
                        <thead>
                            <tr>
                                <th>已扫条码
                                </th>
                                <th>数量
</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div data-role="footer" data-position="fixed"  style="position:fixed" data-theme="a">
                <div data-role="navbar" data-theme="none">
                    <ul>
                        <li><a class="Save" data-corners="false" id="Save" data-role="button" data-fullscreen="true"
                            data-theme="a">确认转移</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <script type="text/javascript">
            var userName = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>";
            var materialId = ""; //物料id集合
            var stationId;
            $(document).ready(function () {
                $("#materialcode").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC") });
                $("#stationid").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC") }).focus();
                //保存
                $("#Save").on("click", function () {
                    if ($.trim($("#stationid").val()) == "") {
                        confirmDialogFocus("库位不能为空！", function () { $("#stationid").focus(); });
                        return false;
                    }
                    if ($.trim($("#materialtb tbody").html()) == "") {
                        confirmDialogFocus("请扫描物料！", function () { $("#materialcode").val('').focus(); });
                        return false;
                    }
                    var materiallist = [];
                    materialId = rtrim(materialId);
                    materiallist = materialId.split("_");

                    var flag = true;
                    for (var i = 0; i < materiallist.length; i++) {
                        var ajax = SKT.LeanMES.Web.AjaxServices.AjaxMaterial.StorageTransfer(materiallist[i], $.trim($("#stationid").val()), userName, 2)
                        if (ajax.error != null) {
                            confirmDialog(ajax.error.Message);
                            flag = false;
                            return false;
                        }
                    }
                    if (flag) {
                        confirmDialogFocus("库位转移成功！", function () {
                            $("#materialcode").val("");                            
                            $("#materialtb tbody").html("");
                            $("#materialcode").select();
                            $("#stationid").val("").select().focus();
                            materialId = "";
                        })
                    }
                });
                //扫描sn
                $("#materialcode").on("keydown", function (e) {
                    var curKey = 0, e = e || window.event;
                    curKey = e.keyCode || e.which || e.charCode;
                    if (curKey == 13) {
                        if ($.trim($("#stationid").val()) == "") {
                            confirmDialogFocus("请先扫描库位！", function () { $("#stationid").focus(); });
                            return false;
                        }
                        if ($("#materialcode").val() == "") {
                            $("#msg").html("条码不能为空！").css("color", "red");
                            $("#materialcode").focus();
                            return false;
                        }

                        var grn = $("#materialcode").val();

                        var ajax = SKT.LeanMES.Web.AjaxServices.AjaxMaterial.StorageTransfer(grn, "", userName, 1)
                        if (ajax.error != null) {
                            confirmDialogFocus(ajax.error.Message, function () {
                                $("#materialcode").val('').focus();
                            });
                            return false;
                        }

                        var grn = ajax.value.split('|')[0];
                        var qty = ajax.value.split('|')[1];
                        var flag = true;
                        $("#materialtb tbody td").each(function () {
                            if (materialId.indexOf(grn)!=-1) {
                                confirmDialogFocus("该物料已经存在!", function () {
                                    $("#materialcode").val('').focus();
                                });
                                flag = false;
                                return false;
                            };
                        });
                        if (flag) {
                            $("#materialtb tbody tr").removeAttr("style");//移除高亮
                            materialId += grn + "_";
                            var htmlstr = "<tr style='background-color:#7FFF00'>";//设置高亮
                            htmlstr += "<td>" + grn + "</td><td>" + qty + "</td></tr>";
                           

                            if ($.trim($("#materialtb tbody").html()) == ""){
                                $("#materialtb tbody").append(htmlstr);
                            } else {
                                $("#materialtb tbody tr:eq(0)").before(htmlstr);//累加在第一条
                            }

                            $("#materialtb").table("refresh");
                            $("#materialtb tbody tr:eq(0)").fadeOut(500).fadeIn(500);//闪动一次
                        }
                        $("#materialcode").val("").select();
                    }
                });

                $("#stationid").on("keydown", function (e) {
                    var curKey = 0, e = e || window.event;
                    curKey = e.keyCode || e.which || e.charCode;
                    if (curKey == 13) {
                        $("#msg").html('');
                        changeBarCode();
                        $("#materialcode").focus();
                    }
                });
            });
            //验证库位
            function changeBarCode() {
                //验证库位
                $.post("../Handler/InStock.ashx?api=GetBarCode", { "station": $.trim($("#stationid").val()) }, function (ajax) {
                    debugger;
                    if (ajax.error != null) {
                        confirmDialogFocus(ajax.error.Message, function () {
                            $('#stationid').val('').focus();
                        });
                        return false;
                    }
                    var en = $.parseJSON(ajax);

                    if (!en.BarCode) {
                        confirmDialogFocus("库位条码不存在!", function () {
                            $('#stationid').val('').focus();
                        });
                        return false;
                    }
                    else {
                        $("#msg").html("库位扫描成功").css("color", "#2ecc71");
                        return true;
                    }
                });
            }
            function rtrim(str) { //删除右边的_
                return str.replace(/_$/g, "");
            }
        </script>
    </form>
</body>
</html>
