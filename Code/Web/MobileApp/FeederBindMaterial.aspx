    <script type="text/javascript">
        $(document).bind("mobileinit", function () {
            $.mobile.ajaxEnabled = false;
        });
        //聚焦 失焦事件
        $(function () {

            $(".ui-table-columntoggle-btn ui-btn ui-btn-a ui-corner-all ui-shadow ui-mini").hide();

            $("#feeder").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC") }).focus();
            $("#materialid").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC") });
            $("#feeder").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $("#msg").html("");
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxFeedBindMaterial.Save($.trim($("#feeder").val()), "", "");
                    if (ajax.error != null) {
                        confirmDialogFocus(ajax.error.Message, function () {
                            $("#feeder").val("").focus();
                        });
                        return false;
                    }
                    $("#materialid").val("").focus().select();
                }
            });
            $("#materialid").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    //var ajax = SKT.LeanMES.Web.AjaxServices.AjaxFeedBindMaterial.Save($.trim($("#feeder").val()), $.trim($("#materialid").val()));
                    //if (ajax.error != null) {
                    //    if (ajax.error.Message.substr(0, 13) == "Feeder已绑定GRN:") {
                    //        confirmDialog(ajax.error.Message, function () {
                    //            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxFeedBindMaterial.Save($.trim($("#feeder").val()), $.trim($("#materialid").val()));
                    //        });
                    //    } else {
                    //        confirmDialogFocus(ajax.error.Message, function () {
                    //            $("#materialid").val("").focus().select();
                    //        });
                    //        return false;
                    //    }
                    //}
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxFeedBindMaterial.Save($.trim($("#feeder").val()), $.trim($("#materialid").val()));
                    if (ajax.error != null) {
                        confirmDialogFocus(ajax.error.Message, function () {
                            $("#materialid").val("").focus().select();
                        });
                        return false;
                    }
                    $("#msg").html("绑定成功！").css("color", "#7FFF00");
                    $("#feeder").val("").focus().select();
                    $("#materialid").val("");
                }
            });
            $("#Save").on("click", function () {
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxFeedBindMaterial.Save($.trim($("#feeder").val()), $.trim($("#materialid").val()));
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    return false;
                }
                $("#msg").html("绑定成功！").css("color", "#7FFF00");
                $("#feeder").focus().select();
                $("#materialid").val("");
            });
        });
        $(document).on("pageshow", "#searchpage", function (event) {
            //隐藏columntoggle列表按钮
            $(".ui-table-columntoggle-btn").css("display", "none");
            var ajax = SKT.LeanMES.Web.AjaxServices.AjaxFeedBindMaterial.GetInfo();
            if (ajax.error != null) {
                confirmDialog(ajax.error.Message);
                return false;
            }
            $("#infotab tbody").html("");
            var htmlstr = "";
            for (var i = 0; i < ajax.value.length; i++) {
                htmlstr += "<tr><td>" + ajax.value[i].FeedStr + "</td><td>" + ajax.value[i].GrnStr + "</td><td>" + ajax.value[i].ItemCode + "</td><td " + (ajax.value[i].States=="已使用"?"style=color:red":"") + ">" + ajax.value[i].States + "</td></tr>";
            }
            $("#infotab tbody").append(htmlstr);
            $("#infotab").table("refresh");
        });
    </script>
</body>
