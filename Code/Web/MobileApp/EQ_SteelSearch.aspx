<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="EQ_SteelSearch.aspx.cs" Inherits="SKT.LeanMES.Web.MobileApp.EQ_SteelSearch" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, minimum-scale=1, maximum-scale=1" />
    <link href="theme/flatui/jquery.mobile.flatui.min.css?v=11" rel="stylesheet" type="text/css" />
    <link href="css/common.css" rel="stylesheet" type="text/css" />
    <script src="js/jquery.min.js" type="text/javascript"></script>
    <script src="js/jquery.mobile-1.4.5.min.js" type="text/javascript"></script>
    <script src="js/Common.js" type="text/javascript"></script>
    <script src="js/skt.mobile.material.js" type="text/javascript"></script>
    <title>仓库收料</title>
    <style type="text/css">
        body, label {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 13px !important;
            color: #1d1007;
        }

        table {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 12px !important;
            color: #1d1007;
        }

        .ui-title {
            line-height: 30px;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div data-role="page" class="receivepage" id="receivepage">
            <div data-role="header" data-position="fixed" style="position: fixed">
                <h5 style="padding: 4px; margin: 0px;">
                    <%--        <div>
                        <img src="images/icon/steelnetsearch_white.png"/>
                        <img style="width: 60px; height: 50px;" src="data:image/png;base64," />
                    </div>
                    <div>
                        钢网、刮刀查询
                    </div>--%>
                    <div>
                        <label style="font-size: 17px !important; font-weight: bold; color: #FFFFFF">钢网、刮刀查询</label>
                    </div>
                </h5>
                <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                    data-transition="none" data-ajax="false">返回</a> <a href="Index.aspx" class="ui-btn-right"
                        data-icon="home" data-transition="none" data-ajax="false">主页</a>
            </div>
            <div data-role="content" id="content1">
                <table style="width: 100%">
                    <tr>
                        <td>
                            <label>
                                钢网/刮刀</label>
                        </td>
                        <td>
                            <input id="steelid" class="query-item" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>
                                工单</label>
                        </td>
                        <td>
                            <input id="orderid" class="query-item" />
                        </td>
                    </tr>
                </table>
                <table data-role="table" id="Steeltab" data-mode="columntoggle" class="ui-responsive table-stroke"
                    style="width: 100%">
                    <thead>
                        <tr>
                            <th>工单
                            </th>
                            <th>钢网/刮刀
                            </th>
                            <th>面别
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div data-role="footer" data-position="fixed" style="position: fixed" data-theme="f">
                <div data-role="navbar" data-theme="none">
                    <ul>
                        <li><a class="Save" data-corners="false" id="Search" onclick="TabShow()" data-role="button" data-fullscreen="true"
                            data-theme="f">查询</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <script type="text/javascript">
            var userName = "<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>";
            $(function () {                 //隐藏columntoggle列表按钮
                $(".ui-table-columntoggle-btn").css("display", "none");
                $("#steelid").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC").select() }).focus();
                $("#orderid").blur(function () { $(this).css("background-color", "white") }).focus(function () { $(this).css("background-color", "#FFFFCC").select() });
                TabShow();

                //回车查询
                $(".query-item").bind("keypress", function (event) {
                    if (event.keyCode == 13) {
                        TabShow();
                    }
                });

            });

            function TabShow() {

                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxEqSteelNet.Search($.trim($("#steelid").val()), $.trim($("#orderid").val()));
                var data = ajax.value;
                $("#Steeltab tbody").html("");
                for (var i = 0; i < data.length; i++) {
                    $("#Steeltab tbody").append("<tr><td>" + data[i].OrderNo + "</td><td>" + data[i].EquipmentCode + "</td><td>" + data[i].SideName + "</td></tr>");
                }
                $("#Steeltab").table("refresh");
            }
        </script>
    </form>
</body>
</html>
