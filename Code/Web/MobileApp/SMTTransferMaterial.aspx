<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="SMTTransferMaterial.aspx.cs" Inherits="SKT.LeanMES.Web.MobileApp.SMTTransferMaterial" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, minimum-scale=1, maximum-scale=1" />
    <link href="theme/flatui/jquery.mobile.flatui.min.css?v=11" rel="stylesheet" type="text/css" />
    <link href="css/common.css" rel="stylesheet" type="text/css" />
    <script src="js/jquery.min.js" type="text/javascript"></script>

    <script src="js/jquery.mobile-1.4.5.min.js" type="text/javascript"></script>
    <script src="js/Common.js" type="text/javascript"></script>
    <script src="js/skt.mobile.material.js" type="text/javascript"></script>
    <title>SMT工单转料</title>
    <style type="text/css">
        .clear {
            clear: both;
            height: 2px;
        }

        body, label {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 13px !important;
            color: #1d1007;
        }

        table {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 12px !important;
            color: #1d1007;
        }

        .clear {
            clear: both;
            height: 2px;
        }

        body, label {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 13px !important;
            color: #1d1007;
        }

        table {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 12px !important;
            color: #1d1007;
        }

        .ui-title {
            line-height: 30px;
        }
    </style>
</head>
<body>
    <form runat="server" onsubmit="return false">
        <div data-role="page" id="pageOne">
            <div data-role="header" id="header" data-position="fixed">
                <h5 style="padding: 4px; margin: 0px;">
                    <div>
                        <%--<img style="width: 60px; height: 50px;" src="data:image/png;base64," />--%>
                    </div>
                    <div>
                        <label style="font-size: 17px !important; font-weight: bold; color: #FFFFFF">SMT工单转料</label>
                    </div>
                </h5>
                <a href="" data-rel="back" data="" role="button" class="ui-btn-left" data-icon="back"
                    data-transition="none" data-ajax="false">返回</a><a href="Index.aspx" class="ui-btn-right"
                        data-icon="home" data-transition="none" data-ajax="false">主页</a>
            </div>
            <div data-role="content">
                <div data-role="fieldcontain">
                    <label for="fOrderNo">
                        原排产工单</label>
                    <a href="#" data-transition="none" data-role="button" data-mini="true" onclick="chooseOrder(1);" data-ajax="false"
                        id="showOrderNo" data-theme="c">请选择</a>
                    <div class="clear">
                    </div>
                    <label for="fStation" style="margin-top: 5px;">
                        目标排产工单</label>
                    <a data-transition="none" data-role="button" data-mini="true" onclick="chooseOrder(2);" data-ajax="false"
                        id="showTargetOrder" data-theme="c">请选择</a>
                    <div class="clear">
                    </div>

                    <label for="fStation" style="margin-top: 5px;">
                        是否解除机台上料信息</label>
                    <select name="slider2" id="sltIsChangeMuMap" data-role="slider" data-mini="true">                        
                        <option value="0">否</option>
                        <option value="1">是</option>
                    </select>

                    <div class="clear">
                    </div>
                </div>
            </div>
            <div data-role="footer" data-position="fixed">
                <div data-role="navbar">
                    <ul>
                        <li><a href="#" data-transition="none" onclick="changeSMTMaterial()">确认转料</a></li>
                    </ul>
                </div>
            </div>
            <div data-role="panel" id="OrderPanel" style="background: #f9f9f9">
                <a href="#" id="btnFilter" data-rel="popup" data-position-to="window" data-mini="true"
                    data-role="button">筛选单据</a>
                <div data-role="content">
                    <ul data-role="listview" id="listview" data-inset="false" data-filter="true" data-filter-placeholder="搜索"
                        data-theme="c" class="listview">
                    </ul>
                </div>
            </div>
        </div>

        <script type="text/javascript">
            var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>';
            var chooseFlag = 1;
            var linePlanId = -1;
            var targetLinePlanId = -1;
            var orderNo = "";
            var targetOrderNo = "";

            $(function () {
                $(".ui-body-c").css("background", "#fff");
                $("body>[data-role='listview']").listview();

                $("#btnFilter").click(function () {
                    $("#Orderlistview").html("");
                    value = $.trim($("#OrderPanel input[data-type='search']:eq(0)").val());
                    ShowOrder(chooseFlag, value);
                });
            });

            $(document).bind("mobileinit", function () {
                $.mobile.ajaxEnabled = false;
            });

            //选择工单
            function chooseOrder(flag) {
                chooseFlag = flag;

                if (flag == 2 && linePlanId == -1) {
                    confirmDialogFocus("请选择原排产工单", function () {
                        chooseOrder(1);
                    });
                    return;
                }

                $("#OrderPanel").panel("open");

                //目标工单直接显示
                if (flag != 1) {
                    ShowOrder(2, "");
                }
            }

            function ShowOrder(flag, value) {
                var ajax = null;

                if (flag == 1) {//原排产工单
                    ajax = SKT.LeanMES.Web.AjaxServices.AjaxSMTTransferMaterial.GetOrderList(value);
                    console.log(ajax);
                }
                else {
                    ajax = SKT.LeanMES.Web.AjaxServices.AjaxSMTTransferMaterial.GetTargetOrderList(linePlanId);
                }
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    //写入日志
                    SaveUserUILog(flag == 1 ? orderNo : targetOrderNo, ajax.error.Message);
                    return false;
                }
                var htmlstr = "";
                var data = ajax.value;
                $('#listview').html('');
                for (var i = 0; i < data.keys.length; i++) {
                    htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data.keys[i] + "' onclick=OrderList('" + data.keys[i] + "','" + data.values[i] + "')>" + data.values[i] + "</li>";
                }
                $("#listview").append(htmlstr);
                $('#listview').listview('refresh');
            }

            function OrderList(ID, OrderNo) {
                $("input[data-type='search']").val('');
                $("#OrderPanel").panel("close");

                if (chooseFlag == 1) {//原排产工单
                    $("#showOrderNo").html(OrderNo);
                    linePlanId = ID;
                    targetLinePlanId = -1;
                    $("#showTargetOrder").html("请选择");
                    chooseOrder(ID);//选择目标工单
                }
                else {
                    $("#showTargetOrder").html(OrderNo);
                    targetLinePlanId = ID;
                }
            }

            /**
            *工单转料
            **/
            function changeSMTMaterial() {
                if (linePlanId == -1) {
                    confirmDialogFocus("请选择原排产工单", function () {
                        chooseOrder(1);
                    });
                    return;
                }
                if (targetLinePlanId == -1) {
                    confirmDialogFocus("请选择目标排产工单", function () {
                        chooseOrder(2);
                    });
                    return;
                }
                if (!confirm("是否确认工单转料操作！")) {
                    return false;
                }
                var sltIsChangeMuMap = $("#sltIsChangeMuMap").val()=="1"?true:false;
                
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxSMTTransferMaterial.ChangeSMTMaterial(linePlanId, targetLinePlanId, sltIsChangeMuMap);
                if (ajax.error != null) {
                    confirmDialog(ajax.error.Message);
                    //写入日志
                    SaveUserUILog(flag == 1 ? orderNo : targetOrderNo, ajax.error.Message);
                    return false;
                }
                alert("工单转料成功！");
                $("#showOrderNo,#showTargetOrder").html("请选择");
                $("#sltIsChangeMuMap").val(1);
                linePlanId = -1;
                targetLinePlanId = -1;
                chooseFlag = -1;
            }
        </script>
    </form>

</body>
</html>
