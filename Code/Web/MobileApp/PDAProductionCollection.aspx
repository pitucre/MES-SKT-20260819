            $(document).on("pageshow", function (event) {
                var _id = location.hash;
                if (_id == "") {
                    $("#pageOne div ul li a").each(function () {
                        if ($(this).attr("href") == "#pageOne") {
                            $(this).addClass("ui-btn-active");
