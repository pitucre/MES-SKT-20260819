                        }
                    });
                    return false;
                }
                $(_id + " div ul li a").each(function () {

                    if ($(this).attr("href") == _id) {
                        $(this).addClass("ui-btn-active");
                        return;
                    }
                })
            });
          
            $("#txtSN").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    afterScan();
                }
            });

            //$("#txtRack").on("keydown", function (e) {
            //    var curKey = 0, e = e || window.event;
            //    curKey = e.keyCode || e.which || e.charCode;
