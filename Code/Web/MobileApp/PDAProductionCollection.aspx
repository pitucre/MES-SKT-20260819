            function RshowAreaMessge(msg, type) {
                $("#rmsg").html(msg).css("color", type == "messageGreen" ? "#99FF33" : "#ff0000");
               
            }
            //显示消息
            function ScraphowAreaMessge(msg, type) {
                $("#Scrapmsg").html(msg).css("color", type == "messageGreen" ? "#99FF33" : "#ff0000");

            }

            /*以下代码为不良采集*/

            var ScanNCCode = "";
            var NCDesc = "";
            /*扫描不良代码*/
            $("#txtNcCode").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    if (sltStationId == -1) {
                        RshowAreaMessge("请选择工序", "messageRed");
                        return false;
                    }
                    if (sltResId == -1) {
                        RshowAreaMessge("请选择资源", "messageRed");
                        return false;
                    }
                    var NcCode = $("#txtNcCode").val();
                    if (ScanNCCode!="") {
                        RshowAreaMessge('不良代码已扫描(' + ScanNCCode + ')，请扫描SN条码', "messageRed");
                        $("#txtSCANSN").select().focus();
                        $("#txtNcCode").val(ScanNCCode);
                        return false;
                    }
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPassStation.GetNCCodeInfo(NcCode, sltStationId);
                    if (ajax.error != null) {
                        RshowAreaMessge(NcCode + ':' + ajax.error.Message, "messageRed");
                        $("#txtNcCode").val("").focus();
                        return false;
                    }
                    //查询当前扫描的SN是否为不良代码，为不良代码则加入数组
                    if (ajax.value[0] != "") { //当前扫码的SN为不良代码
                        ScanNCCode = NcCode;
                        NCDesc = ajax.value[1];
                        $("#txtSCANSN").val("").focus();
                        return false;
                    }
                    else {
                        RshowAreaMessge('请扫描正确的不良代码！', "messageRed");
                        $("#txtNcCode").select().focus();
                        return false;
                    }
                }
            });
            /*扫描SN条码*/
            var mySCANSN = "";
            var isPanel = 0;
            var isBatch = 0;
            var panelId = -1;
            var panelSN = '';
            var panelSNStr = "";
            var OrderNo = "";
            var BatchQty = 1;
            var panelSNList = [];
            $("#txtSCANSN").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    if (ScanNCCode=="") {
                        RshowAreaMessge('请扫描不良代码！', "messageRed");
                        $("#txtNcCode").select().focus();
                        return false;
                    }
                    if (mySCANSN!="") {
                        RshowAreaMessge('SN条码已扫描(' + ScanNCCode + ')，请扫描不良数量', "messageRed");
                        $("#txtNcQty").select().focus();
                        $("#txtSCANSN").val(mySCANSN);
                        return false;
                    }
                    var SCANSN = $("#txtSCANSN").val();
                    //判断当前不良是否已经扫描
                    for (var j = 0; j < NcSNArr.length; j++) {
                        if (NcSNArr[j].NCCode == ScanNCCode && NcSNArr[j].SN == SCANSN) {
                            RshowAreaMessge("扫描的产品条码在当前工序已存在对应的不良信息！", "messageRed");
                            $("#txtSCANSN").val("").focus();
                            return false;
                        }
                    }
                    if (isPanel==0) {
                        for (var i = 0; i < NcSNArr.length; i++) {
                            if (NcSNArr[i].SN != SCANSN) {
                                RshowAreaMessge("当前为单板，请先采集完当前条码的不良信息！", "messageRed");
                                $("#txtSCANSN").val("").focus();
                                return false;
                            }
                        }
                    }
                    if (isPanel == 1) {
                        var SNindexOf = panelSNList.indexOf(SCANSN)
                        if (SNindexOf==-1) {
                            RshowAreaMessge("当前为拼版，请扫描当前拼版的条码信息！(" + panelSNStr + ")", "messageRed");
                            $("#txtSCANSN").val("").focus();
                            return false;
                        }
                    }
                    //校验SN是否满足不良采集条件
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClientController.CommonValidate(SCANSN, sltResId, sltStationId, false);
                    if (ajax.error != null) {
                        RshowAreaMessge(SCANSN + ':' + ajax.error.Message, "messageRed");
                        $("#txtSCANSN").val("").focus();
                        return false;
                    }
                    /*根据扫描的SN，获取是否拼版，单件/批次条码*/
                    var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClientController.GetPanelInfoBySN_PDA(SCANSN);
                    if (ajax.error != null) {
                        RshowAreaMessge(SCANSN + ':' + ajax.error.Message, "messageRed");
                        $("#txtSCANSN").val("").focus();
                        return false;
                    }

                    panelId = ajax.value[0];
                    panelSN = ajax.value[1];
                    panelSNStr = ajax.value[2];
                    OrderNo = ajax.value[3];
                    BatchQty = ajax.value[4];
                    if (panelId > 0) {
                        isPanel = 1;
                        var ajax = SKT.LeanMES.Web.AjaxServices.AjaxClientController.GetPanelListInfoById(panelId);
                        if (ajax.error != null) {
                            RshowAreaMessge(SCANSN + ':' + ajax.error.Message, "messageRed");
                            $("#txtSCANSN").val("").focus();
                            return false;
                        }
                        panelSNList = ajax.value;
                    }
                    else {
                        isPanel = 0;
                    }
                    //判断是单件还是批次
                    if (parseFloat(BatchQty) > 1) {
                        $("#txtNcQty").select().focus();
                        isBatch = 1;
                    }
                    else {
                        $("#txtNcQty").val(BatchQty);
                        $("#txtNcPosition").val("").focus();
                        isBatch = 0;
                    }
                    mySCANSN = SCANSN;
                }
            });

            $("#txtNcQty").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    if (ScanNCCode == "") {
                        RshowAreaMessge('请扫描不良代码！', "messageRed");
                        $("#txtNcCode").select().focus();
                        return false;
                    }
                    if (mySCANSN == "") {
                        RshowAreaMessge('请扫描SN条码！', "messageRed");
                        $("#txtSCANSN").select().focus();
                        return false;
                    }
                    if ($("#txtNcQty").val()=="") {
                        RshowAreaMessge('请输入不良数量！', "messageRed");
                        $("#txtNcQty").select().focus();
                        return false;
                    }
                    if (isBatch == 0) {
                        $("#txtNcQty").val(1);
                        $("#txtNcPosition").val("").focus();
                        isBatch = 0;
                    }
                    else {
                        if (parseFloat($("#txtNcQty").val()) > parseFloat(BatchQty)) {
                            RshowAreaMessge('不良数量不能大于条码数量！', "messageRed");
                            $("#txtNcQty").select().focus();
                            return false;
                        }
                        $("#txtNcPosition").val("").focus();
                    }
                }
            });
            var NcSNArr = [];
            var myNCtab = document.getElementById("NCInfo");
            $("#txtNcPosition").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    if (ScanNCCode == "") {
                        RshowAreaMessge('请扫描不良代码！', "messageRed");
                        $("#txtNcCode").select().focus();
                        return false;
                    }
                    if (mySCANSN == "") {
                        RshowAreaMessge('请扫描SN条码！', "messageRed");
                        $("#txtSCANSN").select().focus();
                        return false;
                    }
                    if ($("#txtNcQty").val() == "" && isBatch == 1) {
                        RshowAreaMessge('当前条码为批次条码，请填写不良数量！', "messageRed");
                        $("#txtNcQty").select().focus();
                        return false;
                    }
                    if (isBatch==0) {
                        $("#txtNcQty").val(1);
                    }
                    var SNArr = {};
                    SNArr.SN = mySCANSN;
                    SNArr.NCCode = ScanNCCode;
                    SNArr.NCDesc = NCDesc;
                    SNArr.NCPosition = $("#txtNcPosition").val();
                    SNArr.NCQty = $("#txtNcQty").val();
                    NcSNArr.push(SNArr);
                    mySCANSN = "";
                    ScanNCCode = "";
                    NCDesc = "";
                    $("#txtNcQty").val("");
                    $("#txtNcPosition").val("");
                    $("#txtNcCode").val("").select().focus();
                    $("#txtSCANSN").val("");
                    $("#NCInfo  tr:not(:first)").html("");
                    for (var i = 0; i < NcSNArr.length; i++) {
                        NCaddDetail(NcSNArr[i], i);
                    }
                }
            });

            

            function NCaddDetail(entity, i) {
                if (entity == null) {
                    return;
                }
                i += 1;
                $("#trNcInfo").remove();
                var row, cell;
                rowNewIdx = myNCtab.rows.length;
                row = myNCtab.insertRow(rowNewIdx);
                row.className = "ListTableOddRow";

                cell = row.insertCell(0);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = entity.SN;

                cell = row.insertCell(1);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = entity.NCCode;

                cell = row.insertCell(2);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = parseFloat(entity.NCQty);

            }

            /*
        *采集过站
        */
            function collectionPass() {
                if (NcSNArr.length<1) {
                    RshowAreaMessge('无不良采集信息，请扫描！', "messageRed");
                    $("#txtNcCode").select().focus();
                    return false;
                }
                var xml = resultToXml();
                var isNc = 0;
                var ajax = SKT.LeanMES.Web.AjaxServices.AjaxPassStation.CollectPassStationNEW(panelId, NcSNArr[0].SN, sltResId, sltStationId, xml);
                if (ajax.error != null) {
                    RshowAreaMessge(scanSN + ':' + ajax.error.Message, "messageRed");
                    $("#txtSN").val("").focus();
                    return false;
                }

                RshowAreaMessge('采集不良成功！', "messageGreen");
                Clear();
            }

            /*
            *拼接不良信为XML字符串
            */
            function resultToXml() {
                var xml = "<PanelSN>";
                for (var i = 0; i < NcSNArr.length; i++) {
                    xml += "<NCCode SN=\"" + NcSNArr[i].SN + "\" CODE=\"" + NcSNArr[i].NCCode + "\" Position=\"" + NcSNArr[i].NCPosition + "\" NCQty=\"" + NcSNArr[i].NCQty + "\"></NCCode>";
                }
                xml += "</PanelSN>";
                return xml;
            }

            function Clear() {
                $("#NCInfo  tr:not(:first)").html("");
                $("#txtNcCode").val("").select().focus();
                $("#txtSCANSN").val("");
                $("#txtNcQty").val("");
                $("#txtNcPosition").val("");
                isPanel = 0;
                NcSNArr = [];
                panelId = -1;
                panelSNList = [];
                ScanNCCode = "";
                NCDesc = "";
                mySCANSN = "";
                isBatch = 0;
                panelSN = '';
                panelSNStr = "";
                OrderNo = "";
                BatchQty = 1;
            }
            /*----------------------------------------------------以下代码为报废采集------------------------------------------------------*/

            var ScrapSNArr = [];
            var myOrderNo = "";
            var myBatchQty = 0;
            var ScrapSNStr = "";
            var myScraptab = document.getElementById("ScrapInfo");

            //扫描条码
            $("#txtScrapSN").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    var txtScrapSN = $("#txtScrapSN").val();
                    if (txtScrapSN=="") {
                        ScraphowAreaMessge("请扫描条码！", "messageRed");
                        $("#txtScrapSN").val("");
                        $("#txtScrapSN").focus();
                        return false;
                    }
                    for (var i = 0; i < ScrapSNArr.length; i++) {
                        if (ScrapSNArr[i].ScrapSN == txtScrapSN) {
                            ScraphowAreaMessge("请勿重复扫描！", "messageRed");
                            $("#txtScrapSN").val("");
                            $("#txtScrapSN").focus();
                            $("#txtScrapQty").val("");
                            return false;
                        }
                    }
                    var info = { ScrapSN: txtScrapSN };
                    var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspPDABatchSNChangScrap", JSON.stringify(info));
                    if (ajax.error != null) {
                        ScraphowAreaMessge(ajax.error.Message, "messageRed");
                        $("#txtScrapSN").val("");
                        $("#txtScrapSN").focus();
                        return false;
                    }
                    var list = JSON.parse(ajax.value);
                    var listOrder = list.data;
                    myOrderNo = listOrder[0].OrderNo;
                    myBatchQty = parseFloat(listOrder[0].BatchQty);
                    $("#txtScrapQty").focus();
                }
            });

            
            //填写报废数量
            $("#txtScrapQty").on("keydown", function (e) {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    var txtScrapSN = $("#txtScrapSN").val();
                    if (txtScrapSN == "") {
                        ScraphowAreaMessge("请扫描条码！", "messageRed");
                        $("#txtScrapSN").val("");
                        $("#txtScrapSN").focus();
                        return false;
                    }
                    var txtScrapQty = $("#txtScrapQty").val();
                    if (txtScrapQty == "" || parseFloat(txtScrapQty)<=0) {
                        ScraphowAreaMessge("请填写报废数量！", "messageRed");
                        $("#txtScrapQty").val("");
                        $("#txtScrapQty").focus();
                        return false;
                    }
                    if (myBatchQty <= txtScrapQty) {
                        ScraphowAreaMessge("报废数量不能大于等于批次数量！", "messageRed");
                        $("#txtScrapQty").val("");
                        $("#txtScrapQty").focus();
                        return false;
                    }
                    for (var i = 0; i < ScrapSNArr.length; i++) {
                        if (ScrapSNArr[i].ScrapSN == txtScrapSN) {
                            ScraphowAreaMessge("请勿重复扫描！", "messageRed");
                            $("#txtScrapSN").val("");
                            $("#txtScrapSN").focus();
                            $("#txtScrapQty").val("");
                            return false;
                        }
                    }
                    var SNArr = {};
                    SNArr.ScrapSN = txtScrapSN;
                    SNArr.OrderNo = myOrderNo;
                    SNArr.ScrapQty = txtScrapQty;
                    ScrapSNArr.push(SNArr);
                    $("#ScrapInfo  tr:not(:first)").html("");
                    for (var i = 0; i < ScrapSNArr.length; i++) {
                        ScrapaddDetail(ScrapSNArr[i], i);
                    }
                    $("#txtScrapSN").val("");
                    $("#txtScrapSN").focus();
                    $("#txtScrapQty").val("");
                }
            });

            function ScrapaddDetail(entity, i) {
                if (entity == null) {
                    return;
                }
                i += 1;
                $("#trScrapInfo").remove();
                var row, cell;
                rowNewIdx = myScraptab.rows.length;
                row = myScraptab.insertRow(rowNewIdx);
                row.className = "ListTableOddRow";

                cell = row.insertCell(0);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = entity.ScrapSN;

                cell = row.insertCell(1);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = entity.OrderNo;

                cell = row.insertCell(2);
                cell.align = "center";
                cell.className = "Field";
                cell.innerHTML = parseFloat(entity.ScrapQty);

            }

            //重新扫描
            function ScrapClear() {
                $("#ScrapInfo  tr:not(:first)").html("");
                $("#txtScrapSN").val("").select().focus();
                $("#txtScrapQty").val("");
                ScrapSNArr = [];
                ScrapSNStr = "";
                myOrderNo = "";
                myBatchQty = 0;
            }

            function ScrapPass() {
                if (ScrapSNArr.length==0) {
                    ScraphowAreaMessge("无扫描记录，请先扫描产品条码！", "messageRed");
                    $("#txtScrapSN").val("");
                    $("#txtScrapSN").focus();
                    $("#txtScrapQty").val("");
                    return false;
                }
                for (var i = 0; i < ScrapSNArr.length; i++) {
                    ScrapSNStr += ScrapSNArr[i].ScrapSN + ":" + ScrapSNArr[i].ScrapQty + ",";
                }
                var info = { ScrapSN: ScrapSNStr, UserName: userName };
                var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspPDABatchSNScrapSave", JSON.stringify(info));
                if (ajax.error != null) {
                    ScraphowAreaMessge(ajax.error.Message, "messageRed");
                    $("#txtScrapSN").val("");
                    $("#txtScrapSN").focus();
                    $("#txtScrapQty").val("");
                    ScrapSNStr = "";
                    return false;
                }
                ScraphowAreaMessge('产品条码报废成功！', "messageGreen");
                ScrapClear();
            }

        </script>
    </form>
</body>
