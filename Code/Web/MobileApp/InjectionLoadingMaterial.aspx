        <script type="text/javascript">
            var userName = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserName %>';
            var userId = '<%=SKT.LeanMES.Web.AccountController.GetCurrentUser().UserId %>';
            var prodOrderId = -1; //选择的工单
            var orderNo = "";
            var sltStationId = -1;
            var sltResId = -1;
            var pickListId = 0; //手插 工单线别 ID
            var pStatus = 2; //手插 工单线别 状态
            var scanSN = ""; //GRN条码
            $(function () {
                $(".ui-body-c").css("background", "#fff");
                $("body>[data-role='listview']").listview();

                $(document).ready(function () {
                    bindPrinters('selPrintersList', function () {
                        if ($("#selPrintersList").val()) {
                            $("#selPrintersList-button span").text($("#selPrintersList").find("option:selected").text());
                        }
                    });
                });
            });
            $(document).bind("mobileinit", function () {
                $.mobile.ajaxEnabled = false;
            });


            var flag = "";
            $("#btnFilter").on("click", function () {
                $("#Orderlistview").html("");
                var $ul = $(this),
                    value = $.trim($("#OrderPanel input[data-type='search']:eq(0)").val());

                var length = 0;
                if (flag == "resource") {
                    var entity = {};
                    entity.ResName = value;
                    var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspInjectionLoadingMaterialGetResList", JSON.stringify(entity));
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    var htmlstr = "";
                    var data = JSON.parse(ajax.value).data;
                    $('#listview').html('');
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].ResName.indexOf(value) >= 0) {
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].ResourceId + "' onclick=ResList('" + data[i].ResourceId + "','" + data[i].ResName + "')>" + data[i].ResName + "</li>";
                        }
                    }
                    $("#listview").append(htmlstr);
                    $('#listview').listview('refresh');
                }
            });

            $("#btnFilter1").on("click", function () {
                $("#Orderlistview").html("");
                var $ul = $(this),
                    value = $.trim($("#OrderPanel1 input[data-type='search']:eq(0)").val());

                var length = 0;
                if (flag == "resource") {
                    var entity = {};
                    entity.ResName = value;
                    var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspInjectionLoadingMaterialGetResList", JSON.stringify(entity));
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    var htmlstr = "";
                    var data = JSON.parse(ajax.value).data;
                    $('#listview1').html('');
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].ResName.indexOf(value) >= 0) {
                            htmlstr += "<li class='ui-btn ui-btn-icon-right ui-icon-carat-r' id='" + data[i].ResourceId + "' onclick=ResList('" + data[i].ResourceId + "','" + data[i].ResName + "')>" + data[i].ResName + "</li>";
                        }
                    }
                    $("#listview1").append(htmlstr);
                    $('#listview1').listview('refresh');
                }
            });

            var chooseType = 1;
            //资源
            function chooseResource(type) {

                chooseType = type;
                if (type == 1) {
                    $("#OrderPanel").panel("open");
                    $('#listview').html('');
                    $("#btnFilter").click();
                } else {
                    $("#OrderPanel1").panel("open");
                    $('#listview1').html('');
                    $("#btnFilter1").click();
                }

                flag = "resource";

            }


            function ResList(ID, ResName) {
                if (chooseType == 1) {
                    sltResId = ID;
                    $("#showRes,#sshowRes").html($("#" + ID).html());
                    $("input[data-type='search']").val('');
                    $("#OrderPanel").panel("close");
                    var wechatNameInput = $("#hdnResName");
                    var wechatNames = "";

                    var isCz = 0;
                    var wechatNameInputVal = wechatNameInput.val().split('|');

                    for (var i = 0; i < wechatNameInputVal.length; i++) {
                        if (wechatNameInputVal[0] == ResName) {
                            isCz = 1;
                        }
                    }
                    if (isCz == 0) {
                        wechatNames += ResName + "|";
                    }
                 
                    if (wechatNames == "") {
                        return;
                    }
                    wechatNames = wechatNames.substring(0, wechatNames.length - 1);

                    if (wechatNameInput.val() != "") {
                        wechatNameInput.val(wechatNameInput.val() + "|" + wechatNames);
                    }
                    else {
                        wechatNameInput.val(wechatNames);
                    }
                    var list = "";
                    var recipientLevelNamesList = wechatNameInput.val().split("|");
                    for (var i = 0; i < recipientLevelNamesList.length; i++) {
                        list = list + recipientLevelNamesList[i] + "<br/>";
                    }
                    list = $("#lblResName").html() + list;
                    $("#lblResName").html(list);
                    SetResName();

                } else {
                    $("#OrderPanel1").panel("close");
                    var entity = {};
                    entity.ResName = ResName;
                    var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspGetMaterialBucketCodeByResName", JSON.stringify(entity));
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    var data = JSON.parse(ajax.value).data;
                    if (data.length > 0) {
                        $("#lblMaterialBucketCodeD").text(data[0].MaterialBucketCode)
                    } else {
                        $("#lblMaterialBucketCodeD").text("");
                        confirmDialog("该机台未关联料桶");
                    }

                }
            }

            function SetResName() {
                var wechatNameArr = $("#hdnResName").val().split("|");
                var lblWechatName = "";

                for (var i = 0; i < wechatNameArr.length; i++) {
                    if (wechatNameArr[i] != "") {
                        if (wechatNameArr[i] > 10) {
                            lblWechatName = lblWechatName + "<span >" + wechatNameArr[i] + "&nbsp;<img onclick=\"DeleteWechatName(this," + i + ");\" src='<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/images/delete.gif' style='cursor:pointer;' /><br></span>";
                        }
                        else {
                            lblWechatName = lblWechatName + "<span >" + wechatNameArr[i] + "&nbsp;<img onclick=\"DeleteWechatName(this," + i + ");\" src='<%=SKT.LeanMES.Web.WebHelper.WebRoot %>/Content/images/delete.gif' style='cursor:pointer;' /></span>";
                        }
                    }
                }
                $("#lblResName").html(lblWechatName);
            }

            function DeleteWechatName(spanObj, index) {
                $(spanObj).parent().remove();
                var recipientLevelArr = $("#hdnResName").val().split("|");
                recipientLevelArr.splice(index, 1);
                $("#hdnResName").val(recipientLevelArr.join("|"));

            }

            $("#showOrderNo ,#showStation,#showLine").on("change", function () {
                if (($("#showOrderNo").html() == "请选择" || $("#showOrderNo").html() == "") && ($("#showLine").html() == "请选择" || $("#showLine").html() == "")) {
                    HandOpenOrStop(0);
                }
            });



            /*
            *获取未上料的物料信息
            */
            function getMaterialList() {
                getPickListDetail(1, "InfoTableGrn");
            }


            //上料
            $("#txtGRN").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
                if (curKey == 13) {
                    $(".msg").html("");
                    var fMaterialBucketCode = $.trim($("#txtMaterialBucketCode").val());
                    if (fMaterialBucketCode == "") {
                        confirmDialogFocus("请输入料桶编码", function () {
                            $("#txtMaterialBucketCode").select();
                        });
                        return false;
                    }
                    scanSN = $.trim($("#txtGRN").val());
                    if (scanSN == "") {
                        confirmDialogFocus("请输入GRN", function () {
                            $("#txtGRN").select();
                        });
                        return false;
                    }

                    var isScan = false;
                    $("#InfoTableGrn tbody tr").each(function () {
                        if ($(this).find("td").eq(1).text().trim() == scanSN.trim()) {
                            isScan = true;
                        }
                    })
                    if (isScan) {
                        $(".msg").html(scanSN + "已上料!").css("color", "red");
                        return false;
                    }


                    var entity = {};
                    entity.GRN = scanSN;
                    entity.MaterialBucketCode = fMaterialBucketCode;
                    entity.UserId = userId;
                    var ajax = SKT.AjaxCommon.DBService.ExecuteSpc("uspCollectInjectionLoadingMaterialGRN", JSON.stringify(entity));
                    if (ajax.error != null) {
                        confirmDialog(ajax.error.Message);
                        //写入日志
                        SaveUserUILog(orderNo, ajax.error.Message);
                        return false;
                    }
                    $(".msg").html(scanSN + "上料成功!").css("color", "#7FFF00");
                    scanSN = "";
                    setTimeout(function () {
                        $(".msg").html("");
                    }, 1500);
                    $("#txtGRN").val("").focus();
                    getMaterialList();
                }
            });


            //扫描上料料桶编码
            $("#txtMaterialBucketCode").on("keydown", function () {
                var curKey = 0, e = e || window.event;
                curKey = e.keyCode || e.which || e.charCode;
