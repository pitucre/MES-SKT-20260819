                                    }
                                } else if (str == "2#") {
                                    $("#txtFeedSN").val("").focus();
                                } else if (str == "3#") {
                                    $("#txtGRN").val("").focus();
                                }
                            });
                            //写入日志
                            SaveUserUILog(orderNo, data.error.Message);
                            return false;
                        }
                        ScanNum = data;
                        if (isCheckFeed) {
                            if ($.trim($("#txtFeedSN").val()) !== "") {
                                $("#txtGRN").val("").focus();
                            } else {
                                $("#txtFeedSN").focus();
                            }
                           
                        } else {
                            $("#txtGRN").val("").focus();
                        }
                    }).error(function (data) {
                        confirmDialog(data.responseText.substring(data.responseText.indexOf('<title>') + 7, data.responseText.indexOf('</title>')));
