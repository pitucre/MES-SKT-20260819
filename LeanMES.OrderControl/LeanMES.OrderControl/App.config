<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>

  <appSettings>
    <!-- 数据库连接字符串 -->
    <add key="MESConnString" value="server=172.16.5.144;uid=sa;pwd=SAsa123;database=LeanMes;Pooling=True;max pool size=500;Connect Timeout=600"/>

    <!-- 订单控制检查间隔(秒) -->
    <add key="OrderControlInterval" value="30"/>

    <!-- 恩格尔EUROMAP 63根目录 -->
    <add key="Euromap63Root" value="E:\source\MES\SKT\20260819\DataCapature\MES软件\MACHINES"/>

    <!-- 日志保留天数 -->
    <add key="LogKeepDays" value="30"/>

    <!-- 预警告警阈值(百分比) -->
    <add key="WarningThreshold" value="90"/>
  </appSettings>

  <connectionStrings>
    <add name="MESConnString" connectionString="server=172.16.5.144;uid=sa;pwd=SAsa123;database=LeanMes;Pooling=True;max pool size=500;Connect Timeout=600" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
</configuration>
